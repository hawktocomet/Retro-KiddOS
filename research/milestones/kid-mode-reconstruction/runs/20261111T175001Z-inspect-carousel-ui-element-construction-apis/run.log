#pragma once

namespace kiddos::ui {

struct Point {
    int x = 0;
    int y = 0;
};

struct Rect {
    int x = 0;
    int y = 0;
    int w = 0;
    int h = 0;

    constexpr bool empty() const noexcept {
        return w <= 0 || h <= 0;
    }

    constexpr bool contains(Point p) const noexcept {
        return !empty() &&
               p.x >= x && p.y >= y &&
               p.x < x + w && p.y < y + h;
    }
};

} // namespace kiddos::ui
=== UI TEXTURE LOADING ===
#include "kiddos/ui/texture.hpp"

#include <SDL_image.h>
#include <utility>

namespace kiddos::ui {

Texture::~Texture() { reset(); }

Texture::Texture(Texture&& other) noexcept
    : texture_(std::exchange(other.texture_, nullptr)),
      width_(std::exchange(other.width_, 0)),
      height_(std::exchange(other.height_, 0)) {}

Texture& Texture::operator=(Texture&& other) noexcept {
    if (this != &other) {
        reset();
        texture_ = std::exchange(other.texture_, nullptr);
        width_ = std::exchange(other.width_, 0);
        height_ = std::exchange(other.height_, 0);
    }
    return *this;
}

bool Texture::load(SDL_Renderer* renderer, const std::string& path) {
    reset();
    if (!renderer || path.empty()) return false;

    SDL_Surface* surface = IMG_Load(path.c_str());
    if (!surface) return false;

    SDL_Texture* loaded = SDL_CreateTextureFromSurface(renderer, surface);
    const int w = surface->w;
    const int h = surface->h;
    SDL_FreeSurface(surface);

    if (!loaded) return false;

    texture_ = loaded;
    width_ = w;
    height_ = h;
    return true;
}

void Texture::reset() noexcept {
    if (texture_) SDL_DestroyTexture(texture_);
    texture_ = nullptr;
    width_ = 0;
    height_ = 0;
}

bool Texture::valid() const noexcept { return texture_ != nullptr; }
int Texture::width() const noexcept { return width_; }
int Texture::height() const noexcept { return height_; }
SDL_Texture* Texture::native() const noexcept { return texture_; }

}
=== UI IMAGE AND PANEL TEST CONSTRUCTION EXAMPLES ===
#include "kiddos/ui/image.hpp"

#include <cassert>

int main() {
    using namespace kiddos::ui;

    const Rect bounds{0, 0, 200, 100};

    const auto contain = calculate_image_geometry(
        100, 100, bounds, ImageFit::contain
    );
    assert(contain.valid);
    assert(contain.destination.x == 50);
    assert(contain.destination.y == 0);
    assert(contain.destination.w == 100);
    assert(contain.destination.h == 100);

    const auto cover = calculate_image_geometry(
        100, 100, bounds, ImageFit::cover
    );
    assert(cover.valid);
    assert(cover.source.x == 0);
    assert(cover.source.y == 25);
    assert(cover.source.w == 100);
    assert(cover.source.h == 50);
    assert(cover.destination.x == 0);
    assert(cover.destination.y == 0);
    assert(cover.destination.w == 200);
    assert(cover.destination.h == 100);

    const auto stretch = calculate_image_geometry(
        100, 100, bounds, ImageFit::stretch
    );
    assert(stretch.valid);
    assert(stretch.source.w == 100);
    assert(stretch.source.h == 100);
    assert(stretch.destination.w == 200);
    assert(stretch.destination.h == 100);

    assert(!calculate_image_geometry(0, 100, bounds, ImageFit::contain).valid);
    assert(!calculate_image_geometry(100, 100, {}, ImageFit::cover).valid);

    Image image;
    assert(image.opacity() == 255);
    image.set_opacity(128);
    assert(image.opacity() == 128);
    image.set_opacity(0);
    assert(image.opacity() == 0);

    return 0;
}
#include "kiddos/ui/panel.hpp"

#include <cassert>

int main() {
    using namespace kiddos::ui;

    Panel panel;

    assert(panel.style().background.r == 20);
    assert(panel.style().background.g == 30);
    assert(panel.style().background.b == 55);
    assert(panel.style().border_thickness == 2);
    assert(panel.style().corner_radius == 0);

    const Color background{10, 20, 30, 255};
    const Color border{100, 150, 200, 255};

    panel.set_background(background);
    panel.set_border(border);
    panel.set_border_thickness(4);
    panel.set_corner_radius(12);

    assert(panel.style().background.r == 10);
    assert(panel.style().border.r == 100);
    assert(panel.style().border_thickness == 4);
    assert(panel.style().corner_radius == 12);

    panel.set_border_thickness(-5);
    assert(panel.style().border_thickness == 0);
    panel.set_corner_radius(-8);
    assert(panel.style().corner_radius == 0);

    PanelStyle custom;
    custom.background = {1, 2, 3, 255};
    custom.border = {4, 5, 6, 255};
    custom.border_thickness = 3;
    custom.corner_radius = 7;

    panel.set_style(custom);

    assert(panel.style().background.r == 1);
    assert(panel.style().border.g == 5);
    assert(panel.style().border_thickness == 3);
    assert(panel.style().corner_radius == 7);

    custom.border_thickness = -1;
    custom.corner_radius = -1;
    Panel second(custom);
    assert(second.style().border_thickness == 0);
    assert(second.style().corner_radius == 0);

    panel.set_bounds({0, 0, 200, 100});
    assert(panel.bounds().w == 200);

    return 0;
}
=== PLATFORM DRAW AND FRAME METHODS ===
void SDLPlatform::set_text_input_active(bool active) {
    if (text_input_active_ == active) return;

    text_input_active_ = active;
    if (active) {
        SDL_StartTextInput();
    } else {
        SDL_StopTextInput();
    }
}

void SDLPlatform::begin_frame() {
    if (!renderer_) return;

    color(renderer_, {8, 15, 35, 255});
    SDL_RenderClear(renderer_);
}


void SDLPlatform::draw_carousel(int selected_index) {
    if (!renderer_) return;

    const int left = (selected_index + 2) % 3;
    const int right = (selected_index + 1) % 3;

    const Color side_fill{16, 41, 75, 255};
    const Color center_fill{18, 63, 117, 255};
    const Color center_border{36, 164, 255, 255};

    // Draw the smaller neighboring cards first, behind the main card.
    const SDL_Rect side_left{25, 250, 190, 175};
    const SDL_Rect side_right{505, 250, 190, 175};

    rounded_fill(renderer_, side_left, 24, side_fill);
    rounded_outline(renderer_, side_left, 24,
                    {55, 105, 165, 190});
    draw_art(renderer_, left,
             {side_left.x + 55, side_left.y + 42, 80, 90}, 180);

    rounded_fill(renderer_, side_right, 24, side_fill);
    rounded_outline(renderer_, side_right, 24,
                    {55, 105, 165, 190});
    draw_art(renderer_, right,
             {side_right.x + 55, side_right.y + 42, 80, 90}, 180);

    // Main card is larger and drawn last so it overlaps both neighbors.
    const SDL_Rect center{145, 135, 430, 370};
    rounded_fill(renderer_, center, 30, center_fill);
    rounded_outline(renderer_, center, 30, center_border);
    rounded_outline(renderer_,
                    {center.x - 3, center.y - 3,
                     center.w + 6, center.h + 6},
                    32, {36, 164, 255, 150});

    // Artwork always follows the actual selected game.
    draw_art(renderer_, selected_index,
             {center.x + 115, center.y + 70, 200, 205}, 255);

    // Game title belongs below the main card; no SELECTED badge.
    if (carousel_title_texture && selected_index == 1) {
        SDL_Rect title{220, 525, 280, 42};
        SDL_RenderCopy(renderer_, carousel_title_texture,
                       nullptr, &title);
    }

    draw_status(renderer_);
}


namespace {

void draw_action_label(SDL_Renderer* r, int index,
                       int x, int y) {
    if (index < 0 || index >= static_cast<int>(action_label_textures.size())) return;
    SDL_Texture* texture = action_label_textures[static_cast<std::size_t>(index)];
    if (!texture) return;

    SDL_Rect destination{x, y, 350, 72};
    SDL_RenderCopy(r, texture, nullptr, &destination);
}

void draw_play_symbol(SDL_Renderer* r, int x, int y) {
    triangle(r, x, y - 34, x, y + 34,
             x + 58, y, {220, 237, 255, 255});
}

void draw_resume_symbol(SDL_Renderer* r, int x, int y) {
    circle(r, x, y, 30, {220, 237, 255, 255});
    circle(r, x, y, 19, {15, 29, 62, 255});
    triangle(r, x + 10, y - 36,
             x + 42, y - 12,
             x + 7, y - 8,
             {220, 237, 255, 255});
}

void draw_restart_symbol(SDL_Renderer* r, int x, int y) {
    circle(r, x, y, 29, {220, 237, 255, 255});
    circle(r, x, y, 18, {15, 29, 62, 255});
    triangle(r, x - 27, y - 30,
             x + 10, y - 31,
             x - 14, y + 2,
             {220, 237, 255, 255});
}

} // namespace

void SDLPlatform::draw_game_actions(
    int selected_index, bool has_checkpoint, int selected_action) {

    if (!renderer_) return;

    draw_status(renderer_);

    // Keep the selected game's artwork prominent.
    draw_card(renderer_, selected_index,
              {235, 48, 250, 310}, true);

    const int action_count = has_checkpoint ? 2 : 1;
    const int box_height = 112;
    const int gap = 17;
    const int total_height =
        action_count * box_height + (action_count - 1) * gap;
    const int start_y = 405 + (210 - total_height) / 2;

    for (int i = 0; i < action_count; ++i) {
        const int y = start_y + i * (box_height + gap);
        const bool selected = i == selected_action;

        SDL_Rect box{65, y, 590, box_height};

        rounded_fill(renderer_, box, 22,
                     selected
                       ? Color{24, 69, 139, 255}
                       : Color{16, 30, 65, 255});

        rounded_outline(renderer_, box, 22,
                        selected
                          ? Color{75, 165, 255, 255}
                          : Color{65, 93, 145, 190});

        const int symbol_x = 145;
        const int symbol_y = y + box_height / 2;

        if (!has_checkpoint || i == 0) {
            if (has_checkpoint) {
                draw_resume_symbol(renderer_, symbol_x, symbol_y);
                draw_action_label(renderer_, 1, 230, y + 20);
            } else {
                draw_play_symbol(renderer_, symbol_x - 20, symbol_y);
                draw_action_label(renderer_, 0, 230, y + 20);
            }
        } else {
            draw_restart_symbol(renderer_, symbol_x, symbol_y);
            draw_action_label(renderer_, 2, 230, y + 20);
        }

        if (selected) {
            rounded_outline(renderer_,
                            {box.x - 4, box.y - 4,
                             box.w + 8, box.h + 8},
                            26, {43, 126, 231, 180});
        }
    }
}


void SDLPlatform::present() {
    if (renderer_) SDL_RenderPresent(renderer_);
}

void SDLPlatform::shutdown() {
    close_controller();

    for (auto& texture : artwork_textures) {
        if (texture) {
            SDL_DestroyTexture(texture);
            texture = nullptr;
        }
    }
    for (auto& texture : action_label_textures) {
        if (texture) {
            SDL_DestroyTexture(texture);
            texture = nullptr;
        }
    }
    if (carousel_title_texture) {
        SDL_DestroyTexture(carousel_title_texture);
        carousel_title_texture = nullptr;
    }
    if (carousel_selected_texture) {
        SDL_DestroyTexture(carousel_selected_texture);
