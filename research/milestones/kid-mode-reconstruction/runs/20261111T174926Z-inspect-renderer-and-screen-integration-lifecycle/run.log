SDLPlatform::~SDLPlatform() {
    shutdown();
}

bool SDLPlatform::initialize() {
    if (SDL_Init(SDL_INIT_VIDEO | SDL_INIT_GAMECONTROLLER) != 0) {
        std::cerr << "SDL initialization failed: "
                  << SDL_GetError() << '\n';
        return false;
    }

    initialized_ = true;

    window_ = SDL_CreateWindow(
        "Retro KiddOS - Kid Mode",
        SDL_WINDOWPOS_CENTERED,
        SDL_WINDOWPOS_CENTERED,
        720,
        720,
        SDL_WINDOW_SHOWN
    );

    if (!window_) {
        std::cerr << "Window creation failed: "
                  << SDL_GetError() << '\n';
        shutdown();
        return false;
    }

    renderer_ = SDL_CreateRenderer(
        window_, -1,
        SDL_RENDERER_ACCELERATED | SDL_RENDERER_PRESENTVSYNC
    );

    if (!renderer_) {
        renderer_ = SDL_CreateRenderer(
            window_, -1, SDL_RENDERER_SOFTWARE
        );
    }

    if (!renderer_) {
        std::cerr << "Renderer creation failed: "
                  << SDL_GetError() << '\n';
        shutdown();
        return false;
    }

    SDL_SetRenderDrawBlendMode(renderer_, SDL_BLENDMODE_BLEND);

    const char* artwork_paths[] = {
        "assets/artwork/generated/carousel-star.bmp",
        "assets/artwork/generated/carousel-mushroom.bmp",
        "assets/artwork/generated/carousel-car.bmp"
    };
    const char* label_paths[] = {
        "assets/artwork/generated/label-play.bmp",
        "assets/artwork/generated/label-resume.bmp",
        "assets/artwork/generated/label-start-over.bmp"
    };

    for (std::size_t i = 0; i < artwork_textures.size(); ++i) {
        artwork_textures[i] = load_bitmap_texture(renderer_, artwork_paths[i], true);
        if (!artwork_textures[i]) {
            shutdown();
            return false;
        }
    }

    for (std::size_t i = 0; i < action_label_textures.size(); ++i) {
        action_label_textures[i] =
            load_bitmap_texture(renderer_, label_paths[i], true);
        if (!action_label_textures[i]) {
            shutdown();
            return false;
        }
    }

    carousel_title_texture =
        load_bitmap_texture(renderer_, "assets/artwork/generated/carousel-title.bmp", true);
    carousel_selected_texture =
        load_bitmap_texture(renderer_, "assets/artwork/generated/carousel-selected.bmp", true);
    if (!carousel_title_texture || !carousel_selected_texture) {
        shutdown();
        return false;
    }
    SDL_SetTextureBlendMode(carousel_title_texture, SDL_BLENDMODE_BLEND);
    SDL_SetTextureBlendMode(carousel_selected_texture, SDL_BLENDMODE_BLEND);


    for (int index = 0; index < SDL_NumJoysticks(); ++index) {
        if (SDL_IsGameController(index)) {
            open_controller(index);
            if (controller_) {
                break;
            }
        }
    }

    return true;
}

void SDLPlatform::open_controller(int device_index) {
    if (controller_) return;

    controller_ = SDL_GameControllerOpen(device_index);

    if (controller_) {
        controller_instance_ = SDL_JoystickInstanceID(
            SDL_GameControllerGetJoystick(controller_)
        );
    }
}

void SDLPlatform::close_controller() {
    if (controller_) {
        SDL_GameControllerClose(controller_);
        controller_ = nullptr;
    }

    controller_instance_ = -1;
}

Action SDLPlatform::map_key(SDL_Keycode key) {
    switch (key) {
        case SDLK_LEFT: return Action::NavigateLeft;
        case SDLK_RIGHT: return Action::NavigateRight;
        case SDLK_UP: return Action::NavigateUp;
        case SDLK_DOWN: return Action::NavigateDown;
        case SDLK_RETURN:
        case SDLK_SPACE: return Action::Confirm;
        case SDLK_ESCAPE: return Action::Back;
        case SDLK_q: return Action::Quit;
        default: return Action::None;
    }
}

Action SDLPlatform::map_controller_button(Uint8 button) {
    switch (button) {
        case SDL_CONTROLLER_BUTTON_DPAD_LEFT:
            return Action::NavigateLeft;
        case SDL_CONTROLLER_BUTTON_DPAD_RIGHT:
            return Action::NavigateRight;
        case SDL_CONTROLLER_BUTTON_DPAD_UP:
            return Action::NavigateUp;
        case SDL_CONTROLLER_BUTTON_DPAD_DOWN:
            return Action::NavigateDown;
        case SDL_CONTROLLER_BUTTON_A:
            return Action::Confirm;
        case SDL_CONTROLLER_BUTTON_B:
            return Action::Back;
        default:
            return Action::None;
    }
}

bool SDLPlatform::pump_events() {
    SDL_Event event;
    bool received = false;

    while (SDL_PollEvent(&event)) {
        received = true;

        switch (event.type) {
            case SDL_QUIT:
                pending_actions_.push_back(Action::Quit);
                break;

            case SDL_KEYDOWN: {
                if (!should_process_keydown(
                        event.key.keysym.sym, event.key.repeat,
                        text_input_active_)) break;

                const auto text_event =
                    SDLTextInputTranslator::translate(event, text_input_active_);
                if (text_event) {
                    pending_text_events_.push_back(*text_event);
                } else {
                    const Action action = map_key(event.key.keysym.sym);
                    if (action != Action::None) {
                        pending_actions_.push_back(action);
                    }
                }
                break;
            }

            case SDL_TEXTINPUT: {
                const auto text_event =
                    SDLTextInputTranslator::translate(event, text_input_active_);
                if (text_event) pending_text_events_.push_back(*text_event);
                break;
            }

            case SDL_CONTROLLERBUTTONDOWN:
                if (event.cbutton.which == controller_instance_) {
                    const Action action =
                        map_controller_button(event.cbutton.button);
                    if (action != Action::None) {
                        pending_actions_.push_back(action);
                    }
                }
                break;

            case SDL_CONTROLLERDEVICEADDED:
                open_controller(event.cdevice.which);
                break;

            case SDL_CONTROLLERDEVICEREMOVED:
                if (event.cdevice.which == controller_instance_) {
                    close_controller();
                }
