    91	namespace {
    92	
    93	// Distance from the rect edge to the rounded-corner boundary at the row or
    94	// column `steps` in from the corner, sampled at the pixel center. Fills use
    95	// this so corner arcs are smooth and evenly shaped.
    96	int corner_inset(int radius, int steps) {
    97	    const double dy = static_cast<double>(radius - steps) - 0.5;
    98	    const double inside = std::max(
    99	        0.0,
   100	        static_cast<double>(radius) * radius - dy * dy
   101	    );
   102	    return radius - static_cast<int>(std::sqrt(inside));
   103	}
   104	
   105	} // namespace
   106	
   107	bool Renderer::fill_rounded_rect(Rect rect, int radius, Color color) const {
   108	    if (!renderer_ || rect.empty() || !set_color(color)) return false;
   109	
   110	    radius = std::clamp(radius, 0, std::min(rect.w, rect.h) / 2);
   111	    if (radius == 0) {
   112	        SDL_Rect native_rect{rect.x, rect.y, rect.w, rect.h};
   113	        return SDL_RenderFillRect(renderer_, &native_rect) == 0;
   114	    }
   115	
   116	    for (int y = 0; y < rect.h; ++y) {
   117	        int inset = 0;
   118	        if (y < radius) {
   119	            inset = corner_inset(radius, y);
   120	        } else if (y >= rect.h - radius) {
   121	            inset = corner_inset(radius, rect.h - 1 - y);
   122	        }
   123	
   124	        if (SDL_RenderDrawLine(
   125	                renderer_,
   126	                rect.x + inset,
   127	                rect.y + y,
   128	                rect.x + rect.w - 1 - inset,
   129	                rect.y + y
   130	            ) != 0) {
   131	            return false;
   132	        }
   133	    }
   134	
   135	    return true;
   136	}
   137	
   138	bool Renderer::outline_rounded_rect(Rect rect, int radius, Color color) const {
   139	    if (!renderer_ || rect.empty() || !set_color(color)) return false;
   140	
   141	    radius = std::clamp(radius, 0, std::min(rect.w, rect.h) / 2);
   142	    if (radius == 0) {
   143	        SDL_Rect native_rect{rect.x, rect.y, rect.w, rect.h};
   144	        return SDL_RenderDrawRect(renderer_, &native_rect) == 0;
   145	    }
   146	
   147	    // Straight edges between the corner arcs.
   148	    if (SDL_RenderDrawLine(
   149	            renderer_, rect.x + radius, rect.y,
   150	            rect.x + rect.w - 1 - radius, rect.y
   151	        ) != 0 ||
   152	        SDL_RenderDrawLine(
   153	            renderer_, rect.x + radius, rect.y + rect.h - 1,
   154	            rect.x + rect.w - 1 - radius, rect.y + rect.h - 1
   155	        ) != 0 ||
   156	        SDL_RenderDrawLine(
   157	            renderer_, rect.x, rect.y + radius,
   158	            rect.x, rect.y + rect.h - 1 - radius
   159	        ) != 0 ||
   160	        SDL_RenderDrawLine(
   161	            renderer_, rect.x + rect.w - 1, rect.y + radius,
   162	            rect.x + rect.w - 1, rect.y + rect.h - 1 - radius
   163	        ) != 0) {
   164	        return false;
   165	    }
   166	
   167	    // Corner arcs, traced along the true circle with dense angle steps so
   168	    // every corner stays continuous with no gaps. Points that land on the
   169	    // straight edge lines are skipped: the lines already cover them, and
   170	    // re-drawing would blend semi-transparent borders twice on one pixel.
   171	    constexpr double kPi = 3.14159265358979323846;
   172	    const int steps = std::max(2, radius * 2);
   173	    const int right = rect.x + rect.w - 1;
   174	    const int bottom = rect.y + rect.h - 1;
   175	
   176	    const auto on_edge_line = [&](ui::Point point) {
   177	        if (point.y == rect.y || point.y == bottom) {
   178	            return point.x >= rect.x + radius && point.x <= right - radius;
   179	        }
   180	        if (point.x == rect.x || point.x == right) {
   181	            return point.y >= rect.y + radius && point.y <= bottom - radius;
   182	        }
   183	        return false;
   184	    };
   185	
   186	    const auto draw_corner = [&](int center_x, int center_y, int sign_x,
   187	                                 int sign_y) {
   188	        ui::Point previous{
   189	            center_x + sign_x * radius,
   190	            center_y
   191	        };
   192	
   193	        for (int step = 1; step < steps; ++step) {
   194	            const double angle = (kPi / 2.0) * step / steps;
   195	            const ui::Point point{
   196	                center_x + sign_x *
   197	                    static_cast<int>(std::lround(radius * std::cos(angle))),
   198	                center_y + sign_y *
   199	                    static_cast<int>(std::lround(radius * std::sin(angle)))
   200	            };
   201	
   202	            if ((point.x != previous.x || point.y != previous.y) &&
   203	                !on_edge_line(point)) {
   204	                if (SDL_RenderDrawPoint(
   205	                        renderer_, point.x, point.y
   206	                    ) != 0) {
   207	                    return false;
   208	                }
   209	            }
   210	            previous = point;
   211	        }
   212	
   213	        return true;
   214	    };
   215	
   216	    if (!draw_corner(rect.x + radius, rect.y + radius, -1, -1) ||
   217	        !draw_corner(
   218	            rect.x + rect.w - 1 - radius, rect.y + radius, 1, -1
   219	        ) ||
   220	        !draw_corner(
   221	            rect.x + radius, rect.y + rect.h - 1 - radius, -1, 1
   222	        ) ||
   223	        !draw_corner(
   224	            rect.x + rect.w - 1 - radius,
   225	            rect.y + rect.h - 1 - radius,
   226	            1,
   227	            1
   228	        )) {
   229	        return false;
   230	    }
   231	
   232	    return true;
   233	}
   234	
   235	bool Renderer::set_clip(Rect rect) const {
   236	    if (!renderer_) return false;
   237	
   238	    SDL_Rect native_rect{rect.x, rect.y, rect.w, rect.h};
   239	    return SDL_RenderSetClipRect(renderer_, &native_rect) == 0;
   240	}
   241	
   242	bool Renderer::clear_clip() const {
   243	    if (!renderer_) return false;
   244	
   245	    return SDL_RenderSetClipRect(renderer_, nullptr) == 0;
   246	}
