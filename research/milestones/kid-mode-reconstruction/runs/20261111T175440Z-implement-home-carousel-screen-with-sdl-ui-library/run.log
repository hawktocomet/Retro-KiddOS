import struct
for name in ["carousel-star","carousel-mushroom","carousel-car","carousel-title","carousel-selected"]:
    p=f"assets/artwork/generated/{name}.bmp"
    with open(p,'rb') as f:
        data=f.read()
    off=struct.unpack('<I',data[10:14])[0]
    w,h=struct.unpack('<ii',data[18:26])
    bpp=struct.unpack('<H',data[28:30])[0]
    print(name,w,h,bpp)
    # check for magenta pixels
    found=0
    if bpp==24:
        row=((w*3+3)//4)*4
        for y in range(min(abs(h),200)):
            base=off+y*row
            for x in range(w):
                b,g,r=data[base+x*3:base+x*3+3]
                if (r,g,b)==(255,0,255): found+=1
    print("  magenta px found:",found)
EOF
