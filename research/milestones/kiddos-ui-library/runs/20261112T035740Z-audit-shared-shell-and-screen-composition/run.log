    16	    case ::kiddos::TextInputEventType::Left: return text_input_.handle(TextInputKey::Left);
    17	    case ::kiddos::TextInputEventType::Right: return text_input_.handle(TextInputKey::Right);
    18	    case ::kiddos::TextInputEventType::Home: return text_input_.handle(TextInputKey::Home);
    19	    case ::kiddos::TextInputEventType::End: return text_input_.handle(TextInputKey::End);
    20	    }
    21	    return false;
