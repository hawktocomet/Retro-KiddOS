#include <SDL.h>

namespace kiddos::app {

class SelectedGameScreen final : public ui::Screen {
public:
    SelectedGameScreen(SDL_Renderer* renderer, int selected_game);
    ~SelectedGameScreen() override;

    int selected_game() const noexcept { return selected_game_; }
    bool play_requested() const noexcept { return play_requested_; }

private:
    int selected_game_ = 0;
    bool play_requested_ = false;

    ui::Texture artwork_texture_;
    ui::Image* artwork_ = nullptr;
    ui::Font font_;
    ui::Button* play_button_ = nullptr;
    ui::Label* back_hint_ = nullptr;
};

} // namespace kiddos::app
#include "kiddos/app/selected_game_screen.hpp"

#include "kiddos/app/platform.hpp"
#include "kiddos/ui/label.hpp"

#include <array>

namespace kiddos::app {

namespace {

constexpr std::array<const char*, platform_count> artwork_paths{{
    "assets/artwork/generated/boxart/gb-tetris.png",
    "assets/artwork/generated/boxart/gba-mario-kart-super-circuit.png",
    "assets/artwork/generated/boxart/snes-super-mario-world.png",
    "assets/artwork/generated/boxart/arcade-pac-man.png"
}};

void load_ui_font(ui::Font& font, int size) {
    constexpr std::array<const char*, 3> paths{{
        "/usr/share/fonts/TTF/DejaVuSans.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "/usr/share/fonts/dejavu/DejaVuSans.ttf"
    }};

    for (const char* path : paths) {
        if (font.load(path, size)) return;
    }
}

} // namespace

SelectedGameScreen::SelectedGameScreen(
    SDL_Renderer* renderer,
    int selected_game
) : selected_game_(selected_game) {
    if (selected_game_ < 0 ||
        selected_game_ >= static_cast<int>(platform_count)) {
        selected_game_ = 0;
    }

    artwork_texture_.load(
        renderer,
        artwork_paths[static_cast<std::size_t>(selected_game_)],
        false
    );

    auto& artwork = root().add<ui::Image>(&artwork_texture_);
    artwork.set_bounds({90, 42, 540, 450});
    artwork.set_fit(ui::ImageFit::contain);
    artwork_ = &artwork;

    load_ui_font(font_, 28);

    auto& play = root().add<ui::Button>("A  PLAY");
    play.set_bounds({190, 525, 340, 88});
    play.set_font(&font_);
    play.set_style({
        {18, 43, 83, 255},
        {35, 91, 165, 255},
        {14, 55, 112, 255},
        {35, 39, 50, 255},
        {69, 151, 255, 255},
        {125, 190, 255, 255},
        {255, 255, 255, 255},
        {150, 155, 165, 255}
    });
    play.set_on_activate([this] {
        // This records the UI request; the game-launch backend is separate.
        play_requested_ = true;
    });
    play_button_ = &play;

    auto& back = root().add<ui::Label>("B  BACK");
    back.set_bounds({250, 655, 220, 36});
    back.set_font(&font_);
    back.set_color({190, 208, 235, 230});
    back.set_alignment(ui::LabelAlignment::center);
    back_hint_ = &back;
}

SelectedGameScreen::~SelectedGameScreen() {
    if (artwork_) artwork_->set_texture(nullptr);
}

} // namespace kiddos::app

===== UI ELEMENT AND IMAGE APIs =====
#pragma once

#include "kiddos/ui/geometry.hpp"
#include "kiddos/ui/renderer.hpp"

namespace kiddos::ui {

class Element {
public:
    virtual ~Element() = default;

    void set_bounds(Rect bounds) noexcept { bounds_ = bounds; }
    Rect bounds() const noexcept { return bounds_; }

    void set_visible(bool visible) noexcept { visible_ = visible; }
    bool visible() const noexcept { return visible_; }

    void set_enabled(bool enabled) noexcept { enabled_ = enabled; }
    bool enabled() const noexcept { return enabled_; }

    void set_focusable(bool focusable) noexcept {
        focusable_ = focusable;
    }

    bool focusable() const noexcept { return focusable_; }

    void set_focused(bool focused) noexcept { focused_ = focused; }
    bool focused() const noexcept { return focused_; }

    void render(Renderer& renderer) {
        if (visible_) draw(renderer);
    }

protected:
    virtual void draw(Renderer& renderer) = 0;

private:
    Rect bounds_{};
    bool visible_ = true;
    bool enabled_ = true;
    bool focusable_ = false;
    bool focused_ = false;
};

} // namespace kiddos::ui
#pragma once

#include "kiddos/ui/element.hpp"
#include "kiddos/ui/texture.hpp"

#include <cstdint>

namespace kiddos::ui {

enum class ImageFit {
    contain,
    cover,
    stretch
};

struct ImageGeometry {
    Rect source{};
    Rect destination{};
    bool valid = false;
};

ImageGeometry calculate_image_geometry(
    int texture_width,
    int texture_height,
    Rect bounds,
    ImageFit fit
) noexcept;

class Image final : public Element {
public:
    explicit Image(Texture* texture = nullptr) noexcept;

    void set_texture(Texture* texture) noexcept;
    Texture* texture() const noexcept;

    void set_fit(ImageFit fit) noexcept;
    ImageFit fit() const noexcept;

    void set_opacity(std::uint8_t opacity) noexcept;
    std::uint8_t opacity() const noexcept;

    ImageGeometry geometry() const noexcept;

private:
    Texture* texture_ = nullptr;
    ImageFit fit_ = ImageFit::contain;
    std::uint8_t opacity_ = 255;

    void draw(Renderer& renderer) override;
};

}
