void draw_status(SDL_Renderer* r) {
    const Color white{205, 222, 255, 220};
    color(r, white);

    // Sound status: speaker and sound waves.
    triangle(r, 31, 34, 43, 25, 43, 51, white);
    rectangle(r, {25, 33, 10, 12}, white);

