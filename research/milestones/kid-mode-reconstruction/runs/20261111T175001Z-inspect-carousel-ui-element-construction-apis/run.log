=== IMAGE ===
#pragma once

#include "kiddos/ui/element.hpp"
#include "kiddos/ui/texture.hpp"

#include <cstdint>

namespace kiddos::ui {

enum class ImageFit {
    contain,
    cover,
    stretch
};

struct ImageGeometry {
    Rect source{};
    Rect destination{};
    bool valid = false;
};

ImageGeometry calculate_image_geometry(
    int texture_width,
    int texture_height,
    Rect bounds,
    ImageFit fit
) noexcept;

class Image final : public Element {
public:
    explicit Image(Texture* texture = nullptr) noexcept;

    void set_texture(Texture* texture) noexcept;
    Texture* texture() const noexcept;

    void set_fit(ImageFit fit) noexcept;
    ImageFit fit() const noexcept;

    void set_opacity(std::uint8_t opacity) noexcept;
    std::uint8_t opacity() const noexcept;

    ImageGeometry geometry() const noexcept;

private:
    Texture* texture_ = nullptr;
    ImageFit fit_ = ImageFit::contain;
    std::uint8_t opacity_ = 255;

    void draw(Renderer& renderer) override;
};

}
#include "kiddos/ui/image.hpp"

#include <algorithm>
#include <cmath>

namespace kiddos::ui {

ImageGeometry calculate_image_geometry(
    int texture_width,
    int texture_height,
    Rect bounds,
    ImageFit fit
) noexcept {
    ImageGeometry result{};
    if (texture_width <= 0 || texture_height <= 0 || bounds.empty()) {
        return result;
    }

    result.source = {0, 0, texture_width, texture_height};
    result.destination = bounds;

    if (fit == ImageFit::stretch) {
        result.valid = true;
        return result;
    }

    const double sx = static_cast<double>(bounds.w) / texture_width;
    const double sy = static_cast<double>(bounds.h) / texture_height;

    if (fit == ImageFit::contain) {
        const double scale = std::min(sx, sy);
        const int w = std::max(1, static_cast<int>(std::round(texture_width * scale)));
        const int h = std::max(1, static_cast<int>(std::round(texture_height * scale)));
        result.destination = {
            bounds.x + (bounds.w - w) / 2,
            bounds.y + (bounds.h - h) / 2,
            w,
            h
        };
    } else {
        const double scale = std::max(sx, sy);
        const int crop_w = std::max(1, static_cast<int>(std::round(bounds.w / scale)));
        const int crop_h = std::max(1, static_cast<int>(std::round(bounds.h / scale)));
        result.source = {
            (texture_width - crop_w) / 2,
            (texture_height - crop_h) / 2,
            crop_w,
            crop_h
        };
    }

    result.valid = true;
    return result;
}

Image::Image(Texture* texture) noexcept : texture_(texture) {}

void Image::set_texture(Texture* texture) noexcept { texture_ = texture; }
Texture* Image::texture() const noexcept { return texture_; }

void Image::set_fit(ImageFit fit) noexcept { fit_ = fit; }
ImageFit Image::fit() const noexcept { return fit_; }

void Image::set_opacity(std::uint8_t opacity) noexcept { opacity_ = opacity; }
std::uint8_t Image::opacity() const noexcept { return opacity_; }

ImageGeometry Image::geometry() const noexcept {
    if (!texture_ || !texture_->valid()) return {};
    return calculate_image_geometry(
        texture_->width(), texture_->height(), bounds(), fit_
    );
}

void Image::draw(Renderer& renderer) {
    if (!texture_ || !texture_->valid()) return;
    const ImageGeometry g = geometry();
    if (!g.valid) return;

    if (fit_ == ImageFit::cover) {
        renderer.set_clip(bounds());
        renderer.draw_texture(texture_->native(), g.source, g.destination, opacity_);
        renderer.clear_clip();
    } else {
        renderer.draw_texture(texture_->native(), g.source, g.destination, opacity_);
    }
}

}
=== PANEL ===
#pragma once

#include "kiddos/ui/element.hpp"

namespace kiddos::ui {

struct PanelStyle {
    Color background{20, 30, 55, 255};
    Color border{55, 110, 190, 255};
    int border_thickness = 2;
    int corner_radius = 0;
};

class Panel final : public Element {
public:
    Panel() = default;
    explicit Panel(PanelStyle style);

    void set_style(PanelStyle style) noexcept;
    const PanelStyle& style() const noexcept;

    void set_background(Color color) noexcept;
    void set_border(Color color) noexcept;
    void set_border_thickness(int thickness) noexcept;
    void set_corner_radius(int radius) noexcept;

private:
    PanelStyle style_{};

    void draw(Renderer& renderer) override;
};

}
#include "kiddos/ui/panel.hpp"

#include <algorithm>
#include <utility>

namespace kiddos::ui {

Panel::Panel(PanelStyle style)
    : style_(std::move(style)) {
    style_.border_thickness = std::max(0, style_.border_thickness);
    style_.corner_radius = std::max(0, style_.corner_radius);
}

void Panel::set_style(PanelStyle style) noexcept {
    style.border_thickness = std::max(0, style.border_thickness);
    style.corner_radius = std::max(0, style.corner_radius);
    style_ = style;
}

const PanelStyle& Panel::style() const noexcept {
    return style_;
}

void Panel::set_background(Color color) noexcept {
    style_.background = color;
}

void Panel::set_border(Color color) noexcept {
    style_.border = color;
}

void Panel::set_border_thickness(int thickness) noexcept {
    style_.border_thickness = std::max(0, thickness);
}

void Panel::set_corner_radius(int radius) noexcept {
    style_.corner_radius = std::max(0, radius);
}

void Panel::draw(Renderer& renderer) {
    const Rect rect = bounds();
    if (rect.empty()) return;

    renderer.fill_rounded_rect(rect, style_.corner_radius, style_.background);

    if (style_.border_thickness <= 0) return;

    for (int inset = 0; inset < style_.border_thickness; ++inset) {
        const Rect outline{
            rect.x + inset,
            rect.y + inset,
            rect.w - inset * 2,
            rect.h - inset * 2
        };

        if (outline.empty()) break;
        renderer.outline_rounded_rect(
            outline,
            std::max(0, style_.corner_radius - inset),
            style_.border
        );
    }
}

}
=== BUTTON ===
#pragma once

#include "kiddos/ui/element.hpp"
#include "kiddos/ui/font.hpp"

#include <functional>
#include <string>

namespace kiddos::ui {

struct ButtonStyle {
    Color normal{20, 34, 65, 255};
    Color focused{35, 83, 150, 255};
    Color pressed{18, 55, 105, 255};
    Color disabled{35, 39, 50, 255};
    Color border{69, 151, 255, 255};
    Color focused_border{125, 190, 255, 255};
    Color text{255, 255, 255, 255};
    Color disabled_text{150, 155, 165, 255};
};

class Button final : public Element {
public:
    explicit Button(std::string label = {});

    void set_label(std::string label);
    const std::string& label() const noexcept;

    void set_style(ButtonStyle style) noexcept;
    const ButtonStyle& style() const noexcept;

    void set_font(const Font* font) noexcept;
    const Font* font() const noexcept;

    void set_pressed(bool pressed) noexcept;
    bool pressed() const noexcept;

    void set_on_activate(std::function<void()> callback);
    bool activate();

private:
    std::string label_;
    ButtonStyle style_{};
    const Font* font_ = nullptr;
    std::function<void()> on_activate_;
    bool pressed_ = false;

    void draw(Renderer& renderer) override;
};

} // namespace kiddos::ui
#include "kiddos/ui/button.hpp"
#include "kiddos/ui/text.hpp"

#include <utility>

namespace kiddos::ui {

Button::Button(std::string label)
    : label_(std::move(label)) {
    set_focusable(true);
}

void Button::set_label(std::string label) {
    label_ = std::move(label);
}

const std::string& Button::label() const noexcept {
    return label_;
}

void Button::set_style(ButtonStyle style) noexcept {
    style_ = style;
}

const ButtonStyle& Button::style() const noexcept {
    return style_;
}

void Button::set_font(const Font* font) noexcept {
    font_ = font;
}

const Font* Button::font() const noexcept {
    return font_;
}

void Button::set_pressed(bool pressed) noexcept {
    pressed_ = pressed;
}

bool Button::pressed() const noexcept {
    return pressed_;
}

void Button::set_on_activate(std::function<void()> callback) {
    on_activate_ = std::move(callback);
}

bool Button::activate() {
    if (!visible() || !enabled() || !on_activate_) return false;
    on_activate_();
    return true;
}

void Button::draw(Renderer& renderer) {
    const Rect rect = bounds();
    if (rect.empty()) return;

    Color fill = style_.normal;
    Color border = style_.border;
    Color text_color = style_.text;

    if (!enabled()) {
        fill = style_.disabled;
        text_color = style_.disabled_text;
    } else if (pressed_) {
        fill = style_.pressed;
    } else if (focused()) {
        fill = style_.focused;
        border = style_.focused_border;
    }

    renderer.fill_rect(rect, fill);
    renderer.outline_rect(rect, border);

    if (font_ && font_->valid() && !label_.empty()) {
        TextRenderer text(renderer);
        const int horizontal_padding = 16;
        const int vertical_padding = 8;
        Rect text_area{
            rect.x + horizontal_padding,
            rect.y + vertical_padding,
            rect.w - horizontal_padding * 2,
            rect.h - vertical_padding * 2
        };
        if (!text_area.empty()) {
            text.draw_centered(label_, *font_, text_area, text_color);
        }
    }
}

} // namespace kiddos::ui
