=== Inspect controller action and test conventions ===
#pragma once

namespace kiddos {

enum class Action {
    None,
    NavigateLeft,
    NavigateRight,
    NavigateUp,
    NavigateDown,
    Confirm,
    Back,
    Quit
};

} // namespace kiddos
#include "kiddos/ui/controller.hpp"

#include <cassert>

int main() {
    using namespace kiddos::ui;

    Container root;
    auto& play = root.add<Button>("Play");
    auto& settings = root.add<Button>("Settings");
    auto& watch = root.add<Button>("Watch");

    play.set_bounds({0, 0, 200, 60});
    settings.set_bounds({220, 0, 200, 60});
    watch.set_bounds({440, 0, 200, 60});

    int play_count = 0;
    int settings_count = 0;
    play.set_on_activate([&] { ++play_count; });
    settings.set_on_activate([&] { ++settings_count; });

    FocusManager focus(root);
    ControllerInteraction controller(focus);

    assert(focus.focus_first());
    assert(focus.focused() == &play);

    assert(controller.handle(UIAction::Right));
    assert(focus.focused() == &settings);

    assert(controller.handle(UIAction::Confirm));
    assert(settings_count == 1);
    assert(play_count == 0);

    assert(controller.handle(UIAction::Left));
    assert(focus.focused() == &play);

    assert(controller.handle(UIAction::Confirm));
    assert(play_count == 1);

    assert(!controller.handle(UIAction::Right) == false);
    assert(focus.focused() == &settings);

    settings.set_enabled(false);
    assert(controller.handle(UIAction::Left));
    assert(focus.focused() == &play);
    assert(controller.handle(UIAction::Right));
    assert(focus.focused() == &watch);

    assert(!controller.handle(UIAction::Confirm));

    assert(!controller.handle(UIAction::Back));
    assert(focus.focused() == &watch);

    return 0;
}
=== Inspect TextInput test conventions ===
#include "kiddos/ui/text_input.hpp"
#include "kiddos/ui/theme.hpp"

#include <cassert>
#include <string>

int main() {
    using namespace kiddos::ui;

    TextInput input("Hello");
    assert(input.focusable());
    assert(input.text() == "Hello");
    assert(input.cursor_position() == 5);

    int changes = 0;
    std::string latest;
    input.set_on_change([&](const std::string& value) {
        ++changes;
        latest = value;
    });

    assert(input.insert_text(" world"));
    assert(input.text() == "Hello world");
    assert(latest == "Hello world");

    input.move_cursor_home();
    assert(input.cursor_position() == 0);
    assert(input.insert_text("Say "));
    assert(input.text() == "Say Hello world");

    input.move_cursor_left();
    assert(input.backspace());
    assert(input.text() == "Sa Hello world");

    input.move_cursor_home();
    assert(input.delete_forward());
    assert(input.text() == "a Hello world");

    input.set_cursor_position(999);
    assert(input.cursor_position() == input.text().size());
    input.move_cursor_end();
    assert(!input.delete_forward());

    input.set_max_length(5);
    assert(input.text() == "a Hel");
    assert(input.max_length() == 5);

    input.set_text("123456");
    assert(input.text() == "12345");
    input.set_max_length(20);
    input.set_text("A");
    assert(input.text() == "A");

    input.set_placeholder("Enter name");
    assert(input.placeholder() == "Enter name");

    input.set_enabled(false);
    assert(!input.insert_text("B"));
    assert(!input.backspace());
    input.set_enabled(true);
    input.set_visible(false);
    assert(!input.insert_text("B"));
    input.set_visible(true);

    TextInput unicode("Aé🙂");
    unicode.move_cursor_home();
    unicode.move_cursor_right();
    assert(unicode.cursor_position() == 1);
    unicode.move_cursor_right();
    assert(unicode.backspace());
    assert(unicode.text() == "A🙂");

    TextInputStyle style;
    style.background = {1, 2, 3, 255};
    input.set_style(style);
    assert(input.style().background.r == 1);

    Theme theme = Theme::kiddos_default();
    const TextInputStyle themed = theme.text_input_style();
    assert(themed.background.r == theme.colors().surface.r);
    assert(themed.cursor.b == theme.colors().primary_bright.b);

    return 0;
}
=== Inspect focus manager implementation ===
#include "kiddos/ui/focus.hpp"

#include <algorithm>
#include <cstdlib>
#include <limits>
#include <vector>

namespace kiddos::ui {

namespace {

void collect_focusable(Container& container,
                       std::vector<Element*>& result) {
    for (std::size_t i = 0; i < container.child_count(); ++i) {
        Element* element = container.child(i);
        if (!element || !element->visible()) continue;

        if (element->focusable() && element->enabled()) {
            result.push_back(element);
        }

        if (auto* nested = dynamic_cast<Container*>(element)) {
            collect_focusable(*nested, result);
        }
    }
}

int center_x(const Rect& rect) {
    return rect.x + rect.w / 2;
}

int center_y(const Rect& rect) {
    return rect.y + rect.h / 2;
}

} // namespace

FocusManager::FocusManager(Container& root) noexcept
    : root_(root) {
}

Element* FocusManager::focused() const noexcept {
    return focused_;
}

bool FocusManager::eligible(const Element* element) const noexcept {
    return element && element->visible() && element->enabled()
        && element->focusable();
}

void FocusManager::clear() noexcept {
    if (focused_) focused_->set_focused(false);
    focused_ = nullptr;
}

bool FocusManager::focus_first() noexcept {
    std::vector<Element*> candidates;
    collect_focusable(root_, candidates);

    if (candidates.empty()) {
        clear();
        return false;
    }

    if (eligible(focused_)) return true;

    clear();
    focused_ = candidates.front();
    focused_->set_focused(true);
    return true;
}

bool FocusManager::move(Direction direction) noexcept {
    std::vector<Element*> candidates;
    collect_focusable(root_, candidates);

    if (candidates.empty()) {
        clear();
        return false;
    }

    if (!eligible(focused_)) {
        clear();
        focused_ = candidates.front();
        focused_->set_focused(true);
        return true;
    }

    const Rect current = focused_->bounds();
    const int cx = center_x(current);
    const int cy = center_y(current);

    Element* best = nullptr;
    long long best_score = std::numeric_limits<long long>::max();

    for (Element* candidate : candidates) {
        if (candidate == focused_) continue;

        const Rect target = candidate->bounds();
        const int dx = center_x(target) - cx;
        const int dy = center_y(target) - cy;

        int primary = 0;
        int secondary = 0;

        switch (direction) {
            case Direction::Left:
                primary = -dx;
                secondary = std::abs(dy);
                break;
            case Direction::Right:
                primary = dx;
                secondary = std::abs(dy);
                break;
            case Direction::Up:
                primary = -dy;
                secondary = std::abs(dx);
                break;
            case Direction::Down:
                primary = dy;
                secondary = std::abs(dx);
                break;
        }

        if (primary <= 0) continue;

        const long long score =
            static_cast<long long>(primary) * 1000LL + secondary;

        if (score < best_score) {
            best_score = score;
            best = candidate;
        }
    }

    // No candidate in that direction: leave focus unchanged.
    if (!best) return false;

    focused_->set_focused(false);
    focused_ = best;
    focused_->set_focused(true);
    return true;
}

} // namespace kiddos::ui
