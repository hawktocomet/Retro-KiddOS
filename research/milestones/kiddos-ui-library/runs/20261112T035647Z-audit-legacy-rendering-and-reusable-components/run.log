    15	using kiddos::ui::Color;
    16	using kiddos::ui::Rect;
    17	
    18	Color pixel(SDL_Surface* surface, int x, int y) {
    19	    assert(SDL_LockSurface(surface) == 0);
    20	    const auto* row = static_cast<const std::uint8_t*>(surface->pixels)
    21	        + y * surface->pitch;
    22	    const auto* value = reinterpret_cast<const std::uint32_t*>(row) + x;
    23	    std::uint8_t r = 0, g = 0, b = 0, a = 0;
    24	    SDL_GetRGBA(*value, surface->format, &r, &g, &b, &a);
    25	    SDL_UnlockSurface(surface);
    26	    return {r, g, b, a};
    27	}
    28	
    29	bool same_color(const Color& a, const Color& b) {
    30	    return a.r == b.r && a.g == b.g &&
    31	           a.b == b.b && a.a == b.a;
    32	}
    33	
    34	bool any_pixel_different(
    35	    SDL_Surface* surface,
    36	    const Rect& rect,
    37	    const Color& color
    38	) {
    39	    for (int y = rect.y; y < rect.y + rect.h; ++y) {
    40	        for (int x = rect.x; x < rect.x + rect.w; ++x) {
    41	            if (!same_color(pixel(surface, x, y), color)) return true;
    42	        }
    43	    }
    44	    return false;
    45	}
    46	
    47	const kiddos::ui::Element* find_by_bounds(
    48	    kiddos::ui::Screen& screen,
    49	    const Rect& bounds
    50	) {
    51	    for (std::size_t i = 0; i < screen.root().child_count(); ++i) {
    52	        const auto* child = screen.root().child(i);
    53	        if (!child) continue;
    54	
    55	        const Rect actual = child->bounds();
    56	        if (actual.x == bounds.x && actual.y == bounds.y &&
    57	            actual.w == bounds.w && actual.h == bounds.h) {
    58	            return child;
    59	        }
    60	    }
    61	    return nullptr;
    62	}
    63	
    64	void test_structure_and_selection() {
    65	    kiddos::app::HomeCarouselScreen screen(nullptr);
    66	
    67	    // The shared shell owns the header, status indicators, and footer.
    68	    // The carousel itself owns only its three game-cover slots.
    69	    assert(screen.root().child_count() == 3);
    70	    assert(screen.selected_game() == 1);
    71	
    72	    screen.set_selected_game(0);
    73	    assert(screen.selected_game() == 0);
    74	    assert(screen.selected_game() == 0);
    75	
    76	    screen.set_selected_game(3);
    77	    assert(screen.selected_game() == 3);
    78	
    79	    screen.set_selected_game(4);
    80	    assert(screen.selected_game() == 3);
    81	
    82	    screen.set_selected_game(0);
    83	    assert(screen.selected_game() == 0);
    84	
    85	    // The transition can be advanced to completion without an SDL renderer.
    86	    screen.update(1.0f);
    87	}
    88	
    89	void test_renders_minimal_carousel() {
    90	    assert(SDL_Init(0) == 0);
    91	    IMG_Init(IMG_INIT_PNG);
    92	    assert(chdir(KIDDOS_SOURCE_DIR) == 0);
    93	
    94	    SDL_Surface* surface = SDL_CreateRGBSurfaceWithFormat(
    95	        0, 720, 720, 32, SDL_PIXELFORMAT_RGBA32);
    96	    assert(surface);
    97	
    98	    SDL_Renderer* native = SDL_CreateSoftwareRenderer(surface);
    99	    assert(native);
   100	    SDL_SetRenderDrawBlendMode(native, SDL_BLENDMODE_BLEND);
   101	
   102	    {
   103	        kiddos::ui::Renderer renderer(native);
   104	        kiddos::app::HomeCarouselScreen screen(native);
   105	
   106	        const Color background{8, 15, 35, 255};
   107	        renderer.clear(background);
   108	        screen.render(renderer);
   109	
   110	        // The screen is no longer composed of large framed panels.
   111	        assert(same_color(pixel(surface, 540, 160), background));
   112	
   113	        // All three game-cover positions are visible.
   114	        assert(any_pixel_different(surface, {220, 158, 280, 280}, background));
   115	        assert(any_pixel_different(surface, {24, 250, 128, 128}, background));
   116	        assert(any_pixel_different(surface, {568, 250, 128, 128}, background));
   117	
   118	        // Selecting another game updates all three visible cover slots.
   119	        screen.set_selected_game(0);
   120	        screen.update(0.05f);
   121	        screen.render(renderer);
   122	
   123	        screen.update(1.0f);
   124	        screen.render(renderer);
   125	
   126	        assert(any_pixel_different(surface, {220, 158, 280, 280}, background));
   127	    }
   128	
   129	    SDL_DestroyRenderer(native);
   130	    SDL_FreeSurface(surface);
   131	    IMG_Quit();
   132	    SDL_Quit();
   133	}
   134	
   135	} // namespace
   136	
   137	int main() {
   138	    test_structure_and_selection();
   139	    test_renders_minimal_carousel();
   140	    return 0;
   141	}
