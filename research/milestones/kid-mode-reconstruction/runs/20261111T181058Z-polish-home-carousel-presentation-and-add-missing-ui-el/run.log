[0m$ [0mcd /home/hawk/KiddOS && python3 - <<'EOF'
import struct
def dump(name, cols=90, rows=16):
    with open(f"assets/artwork/generated/{name}.bmp","rb") as f:
        data = f.read()
    off = struct.unpack("<I", data[10:14])[0]
    w,h = struct.unpack("<ii", data[18:26])
    bpp = struct.unpack("<H", data[28:30])[0]
    rowsize = ((w*bpp//8)+3)//4*4
    out=[]
    for ry in range(rows):
        line=""
        for rx in range(cols):
            x = rx*w//cols
            y = ry*h//rows
            i = off + y*rowsize + x*(bpp//8)
            b,g,r = data[i],data[i+1],data[i+2]
            mag = (r==255 and g==0 and b==255)
            line += " " if mag else ("#" if r+g+b < 200 else ".")
        out.append(line)
    print(name)
    print("\n".join(out))
dump("carousel-title")
EOF
