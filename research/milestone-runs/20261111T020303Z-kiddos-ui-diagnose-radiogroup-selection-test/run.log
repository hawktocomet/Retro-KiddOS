    15	void RadioGroup::set_options(std::vector<std::string> options) {
    16	    options_ = std::move(options);
    17	    if (options_.empty()) {
    18	        selected_ = -1;
    19	    } else if (selected_ < 0 || selected_ >= static_cast<int>(options_.size())) {
    20	        selected_ = 0;
    21	    }
    22	}
    23	
    24	const std::vector<std::string>& RadioGroup::options() const noexcept {
    25	    return options_;
    26	}
    27	
    28	bool RadioGroup::set_selected(int index) {
    29	    if (!visible() || !enabled() || index < 0 ||
    30	        index >= static_cast<int>(options_.size())) return false;
    31	    if (selected_ == index) return true;
    32	    selected_ = index;
    33	    if (on_change_) on_change_(selected_);
    34	    return true;
    35	}
    36	
    37	int RadioGroup::selected() const noexcept {
    38	    return selected_;
    39	}
    40	
    41	bool RadioGroup::select_next() {
    42	    if (options_.empty() || !visible() || !enabled()) return false;
    43	    return set_selected((selected_ + 1) % static_cast<int>(options_.size()));
    44	}
    45	
    46	bool RadioGroup::select_previous() {
    47	    if (options_.empty() || !visible() || !enabled()) return false;
    48	    const int count = static_cast<int>(options_.size());
    49	    return set_selected((selected_ - 1 + count) % count);
    50	}
