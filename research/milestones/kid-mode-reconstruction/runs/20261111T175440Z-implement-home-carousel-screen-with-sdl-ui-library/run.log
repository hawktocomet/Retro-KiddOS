import struct
p="assets/artwork/generated/carousel-title.bmp"
data=open(p,'rb').read()
off=struct.unpack('<I',data[10:14])[0]
w,h=struct.unpack('<ii',data[18:26])
row=((w*3+3)//4)*4
def get(x,y):
    yy=y if h>0 else abs(h)-1-y
    base=off+yy*row
    b,g,r=data[base+x*3:base+x*3+3]
    return (r,g,b)
# find pixel where 7x7 neighborhood uniformly non-magenta
best=None
for y in range(3,h-3):
    for x in range(3,w-3):
        ok=True
        c=get(x,y)
        if c==(255,0,255): continue
        for dy in range(-3,4):
            for dx in range(-3,4):
                if get(x+dx,y+dy)!=c or get(x+dx,y+dy)==(255,0,255):
                    ok=False; break
            if not ok: break
        if ok:
            best=(x,y,c); break
    if best: break
print("solid at",best)
x,y,c=best
# map to title rect {220,525,280,42}
dx = 220 + x*280//w
dy = 525 + y*42//h
print("dest",dx,dy,c)
# also verify a spread of neighbors map solid: check mapped rect corners
