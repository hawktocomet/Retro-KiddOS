   786	
   787	void SDLPlatform::draw_game_actions(
   788	    int selected_index, bool has_checkpoint, int selected_action) {
   789	
   790	    if (!renderer_) return;
   791	
   792	    draw_status(renderer_);
   793	
   794	    // Keep the selected game's artwork prominent.
   795	    draw_card(renderer_, selected_index,
   796	              {235, 48, 250, 310}, true);
   797	
   798	    const int action_count = has_checkpoint ? 2 : 1;
   799	    const int box_height = 112;
   800	    const int gap = 17;
   801	    const int total_height =
   802	        action_count * box_height + (action_count - 1) * gap;
   803	    const int start_y = 405 + (210 - total_height) / 2;
   804	
   805	    for (int i = 0; i < action_count; ++i) {
   806	        const int y = start_y + i * (box_height + gap);
   807	        const bool selected = i == selected_action;
   808	
   809	        SDL_Rect box{65, y, 590, box_height};
   810	
   811	        rounded_fill(renderer_, box, 22,
   812	                     selected
   813	                       ? Color{24, 69, 139, 255}
   814	                       : Color{16, 30, 65, 255});
   815	
   816	        rounded_outline(renderer_, box, 22,
   817	                        selected
   818	                          ? Color{75, 165, 255, 255}
   819	                          : Color{65, 93, 145, 190});
   820	
   821	        const int symbol_x = 145;
   822	        const int symbol_y = y + box_height / 2;
   823	
   824	        if (!has_checkpoint || i == 0) {
   825	            if (has_checkpoint) {
   826	                draw_resume_symbol(renderer_, symbol_x, symbol_y);
   827	                draw_action_label(renderer_, 1, 230, y + 20);
   828	            } else {
   829	                draw_play_symbol(renderer_, symbol_x, symbol_y);
   830	                draw_action_label(renderer_, 0, 230, y + 20);
   831	            }
   832	        } else {
   833	            draw_restart_symbol(renderer_, symbol_x, symbol_y);
   834	            draw_action_label(renderer_, 2, 230, y + 20);
   835	        }
   836	
   837	        if (selected) {
   838	            rounded_outline(renderer_,
   839	                            {box.x - 4, box.y - 4,
   840	                             box.w + 8, box.h + 8},
   841	                            26, {43, 126, 231, 180});
   842	        }
   843	    }
   844	
   845	    if (selected_game_hints_texture) {
   846	        const SDL_Rect back_source{16, 0, 100, 34};
   847	        const SDL_Rect back_destination{16, 666, 100, 34};
   848	        SDL_RenderCopy(renderer_, selected_game_hints_texture,
   849	                       &back_source, &back_destination);
   850	    }
   851	
   852	    if (navigation_hints_texture) {
   853	        const SDL_Rect select_source{623, 0, 97, 34};
   854	        const SDL_Rect select_destination{623, 666, 97, 34};
   855	        SDL_RenderCopy(renderer_, navigation_hints_texture,
   856	                       &select_source, &select_destination);
   857	    }
   858	}
