   353	    // Battery status: outline, terminal, charge fill.
   354	    outline(r, {657, 27, 34, 19}, white);
   355	    rectangle(r, {691, 33, 4, 7}, white);
   356	    rectangle(r, {661, 31, 22, 11},
   357	              {67, 157, 255, 240});
