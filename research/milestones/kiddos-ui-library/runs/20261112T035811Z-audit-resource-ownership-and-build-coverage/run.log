     1	#include "kiddos/ui/image.hpp"
     2	
     3	#include <algorithm>
     4	#include <cmath>
     5	
     6	namespace kiddos::ui {
     7	
     8	ImageGeometry calculate_image_geometry(
     9	    int texture_width,
    10	    int texture_height,
    11	    Rect bounds,
    12	    ImageFit fit
    13	) noexcept {
    14	    ImageGeometry result{};
    15	    if (texture_width <= 0 || texture_height <= 0 || bounds.empty()) {
    16	        return result;
    17	    }
    18	
    19	    result.source = {0, 0, texture_width, texture_height};
    20	    result.destination = bounds;
    21	
    22	    if (fit == ImageFit::stretch) {
    23	        result.valid = true;
    24	        return result;
    25	    }
    26	
    27	    const double sx = static_cast<double>(bounds.w) / texture_width;
    28	    const double sy = static_cast<double>(bounds.h) / texture_height;
    29	
    30	    if (fit == ImageFit::contain) {
    31	        const double scale = std::min(sx, sy);
    32	        const int w = std::max(1, static_cast<int>(std::round(texture_width * scale)));
    33	        const int h = std::max(1, static_cast<int>(std::round(texture_height * scale)));
    34	        result.destination = {
    35	            bounds.x + (bounds.w - w) / 2,
    36	            bounds.y + (bounds.h - h) / 2,
    37	            w,
    38	            h
    39	        };
    40	    } else {
    41	        const double scale = std::max(sx, sy);
    42	        const int crop_w = std::max(1, static_cast<int>(std::round(bounds.w / scale)));
    43	        const int crop_h = std::max(1, static_cast<int>(std::round(bounds.h / scale)));
    44	        result.source = {
    45	            (texture_width - crop_w) / 2,
    46	            (texture_height - crop_h) / 2,
    47	            crop_w,
    48	            crop_h
    49	        };
    50	    }
    51	
    52	    result.valid = true;
    53	    return result;
    54	}
    55	
    56	Image::Image(Texture* texture) noexcept : texture_(texture) {}
    57	
    58	void Image::set_texture(Texture* texture) noexcept { texture_ = texture; }
    59	Texture* Image::texture() const noexcept { return texture_; }
    60	
    61	void Image::set_fit(ImageFit fit) noexcept { fit_ = fit; }
    62	ImageFit Image::fit() const noexcept { return fit_; }
    63	
    64	void Image::set_opacity(std::uint8_t opacity) noexcept { opacity_ = opacity; }
    65	std::uint8_t Image::opacity() const noexcept { return opacity_; }
    66	
    67	ImageGeometry Image::geometry() const noexcept {
    68	    if (!texture_ || !texture_->valid()) return {};
    69	    return calculate_image_geometry(
    70	        texture_->width(), texture_->height(), bounds(), fit_
    71	    );
    72	}
    73	
    74	void Image::draw(Renderer& renderer) {
    75	    if (!texture_ || !texture_->valid()) return;
    76	    const ImageGeometry g = geometry();
    77	    if (!g.valid) return;
    78	
    79	    if (fit_ == ImageFit::cover) {
    80	        renderer.set_clip(bounds());
    81	        renderer.draw_texture(texture_->native(), g.source, g.destination, opacity_);
    82	        renderer.clear_clip();
    83	    } else {
    84	        renderer.draw_texture(texture_->native(), g.source, g.destination, opacity_);
    85	    }
    86	}
    87	
    88	}

