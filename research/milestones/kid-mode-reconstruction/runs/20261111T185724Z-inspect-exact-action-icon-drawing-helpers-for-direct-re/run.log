        int intersections[3];
        int count = 0;

        const int xs[] = {x1, x2, x3};
        const int ys[] = {y1, y2, y3};

        for (int i = 0; i < 3; ++i) {
            const int j = (i + 1) % 3;

            if ((ys[i] <= y && ys[j] > y) ||
                (ys[j] <= y && ys[i] > y)) {
                const int x = xs[i] +
                    (y - ys[i]) * (xs[j] - xs[i]) /
                    (ys[j] - ys[i]);

                intersections[count++] = x;
