class SelectedGameScreen final : public ui::Screen {
public:
    SelectedGameScreen(SDL_Renderer* renderer, int selected_game);
    ~SelectedGameScreen() override;

    int selected_game() const noexcept { return selected_game_; }
    bool play_requested() const noexcept { return play_requested_; }

private:
    int selected_game_ = 0;
    bool play_requested_ = false;

    ui::Texture artwork_texture_;
    ui::Image* artwork_ = nullptr;
    ui::Font font_;
    ui::Button* play_button_ = nullptr;
    ui::Label* back_hint_ = nullptr;
};

