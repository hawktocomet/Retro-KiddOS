+// True when any pixel within `radius` steps of the point matches `color`.
+bool any_pixel_near(
+    SDL_Surface* surface,
+    int x,
+    int y,
+    int radius,
+    const Color& color
+) {
+    for (int dy = -radius; dy <= radius; ++dy) {
+        for (int dx = -radius; dx <= radius; ++dx) {
+            if (same_color(pixel(surface, x + dx, y + dy), color)) {
+                return true;
+            }
+        }
+    }
+    return false;
