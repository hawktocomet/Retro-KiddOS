    40	    std::uint8_t opacity() const noexcept;
    41	
    42	    ImageGeometry geometry() const noexcept;
    43	
    44	private:
    45	    Texture* texture_ = nullptr;
    46	    ImageFit fit_ = ImageFit::contain;
