     6	#include "lvgl.h"
     7	
     8	#define SCREEN_W 720
     9	#define SCREEN_H 720
    10	#define BUFFER_ROWS 40
    11	
    12	static SDL_Window *window;
    13	static SDL_Renderer *renderer;
    14	static SDL_Texture *texture;
    15	static uint8_t draw_buffer[SCREEN_W * BUFFER_ROWS * 2];
    16	static lv_indev_t *keypad;
    17	static lv_group_t *focus_group;
    18	static uint32_t keypad_key;
    19	static bool keypad_pressed;
    20	
    21	static void read_controller(lv_indev_t *indev, lv_indev_data_t *data)
    22	{
    23	    (void)indev;
    24	    data->key = keypad_key;
    25	    data->state = keypad_pressed ? LV_INDEV_STATE_PRESSED : LV_INDEV_STATE_RELEASED;
    26	    keypad_pressed = false;
    27	}
    28	
    29	static void flush_to_sdl(lv_display_t *display, const lv_area_t *area, uint8_t *pixels)
    30	{
    31	    SDL_Rect rect = {
    32	        .x = area->x1,
    33	        .y = area->y1,
    34	        .w = area->x2 - area->x1 + 1,
    35	        .h = area->y2 - area->y1 + 1
    36	    };
    37	
    38	    if (rect.w > 0 && rect.h > 0) {
    39	        SDL_UpdateTexture(texture, &rect, pixels, rect.w * 2);
    40	        SDL_RenderClear(renderer);
    41	        SDL_RenderCopy(renderer, texture, NULL, NULL);
    42	        SDL_RenderPresent(renderer);
    43	    }
    44	
    45	    lv_display_flush_ready(display);
    46	}
    47	
    48	static void make_ui(void)
    49	{
    50	    lv_obj_t *screen = lv_screen_active();
    51	    lv_obj_set_style_bg_color(screen, lv_color_hex(0x071426), 0);
    52	    lv_obj_set_style_bg_opa(screen, LV_OPA_COVER, 0);
    53	
    54	    lv_obj_t *header = lv_obj_create(screen);
    55	    lv_obj_set_size(header, 680, 76);
    56	    lv_obj_align(header, LV_ALIGN_TOP_MID, 0, 18);
    57	    lv_obj_set_style_bg_color(header, lv_color_hex(0x102B4A), 0);
    58	    lv_obj_set_style_border_width(header, 0, 0);
    59	    lv_obj_set_style_radius(header, 18, 0);
    60	
    61	    lv_obj_t *title = lv_label_create(header);
    62	    lv_label_set_text(title, "KiddOS");
    63	    lv_obj_set_style_text_color(title, lv_color_hex(0xFFFFFF), 0);
    64	    lv_obj_center(title);
    65	
    66	    focus_group = lv_group_create();
    67	    const char *names[] = {"GAME ONE", "GAME TWO", "GAME THREE"};
    68	    const int widths[] = {170, 230, 170};
    69	
    70	    for (int i = 0; i < 3; i++) {
    71	        lv_obj_t *card = lv_obj_create(screen);
    72	        lv_obj_set_size(card, widths[i], i == 1 ? 330 : 270);
    73	        lv_obj_align(card, LV_ALIGN_CENTER, (i - 1) * 205, 25);
    74	        lv_obj_set_style_bg_color(card,
    75	            i == 1 ? lv_color_hex(0x1769AA) : lv_color_hex(0x19334F), 0);
    76	        lv_obj_set_style_border_width(card, i == 1 ? 4 : 0, 0);
    77	        lv_obj_set_style_border_color(card, lv_color_hex(0x48B4FF), 0);
    78	        lv_obj_set_style_radius(card, 22, 0);
    79	        lv_group_add_obj(focus_group, card);
    80	
    81	        lv_obj_t *label = lv_label_create(card);
    82	        lv_label_set_text(label, names[i]);
    83	        lv_obj_set_style_text_color(label, lv_color_hex(0xFFFFFF), 0);
    84	        lv_obj_center(label);
    85	    }
    86	
    87	    lv_obj_t *footer = lv_label_create(screen);
    88	    lv_label_set_text(footer, "SDL2 renderer adapter prototype");
    89	    lv_obj_set_style_text_color(footer, lv_color_hex(0x8FAAC5), 0);
    90	    lv_obj_align(footer, LV_ALIGN_BOTTOM_MID, 0, -24);
    91	}
