    38	HomeCarouselScreen::HomeCarouselScreen(SDL_Renderer* renderer) {
    39	    constexpr std::array<const char*, game_count> game_cover_paths{{
    40	        "assets/artwork/generated/boxart/gb-tetris.png",
    41	        "assets/artwork/generated/boxart/gba-mario-kart-super-circuit.png",
    42	        "assets/artwork/generated/boxart/snes-super-mario-world.png",
    43	        "assets/artwork/generated/boxart/arcade-pac-man.png"
    44	    }};
    45	
    46	    for (std::size_t game = 0; game < game_textures_.size(); ++game) {
    47	        game_textures_[game].load(renderer, game_cover_paths[game], false);
    48	    }
    49	
    50	    const std::array<ui::Rect, 3> slot_bounds{
    51	        left_art, center_art, right_art
    52	    };
    53	
    54	    for (std::size_t slot = 0; slot < game_images_.size(); ++slot) {
    55	        auto& image = root().add<ui::Image>();
    56	        image.set_fit(ui::ImageFit::contain);
    57	        image.set_bounds(slot_bounds[slot]);
    58	        game_images_[slot] = &image;
    59	    }
    60	
    61	    set_selected_game(1);
    62	}
