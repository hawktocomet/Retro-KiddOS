+int first_content_pixel_x(
+    SDL_Surface* surface,
+    const Rect& rect,
+    int y,
+    const Color& color
+) {
+    for (int x = rect.x; x < rect.x + rect.w; ++x) {
+        if (!same_color(pixel(surface, x, y), color)) return x;
+    }
