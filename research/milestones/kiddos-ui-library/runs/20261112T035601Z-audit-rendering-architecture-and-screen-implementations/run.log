     6	namespace kiddos::ui {
     7	
     8	class Element {
     9	public:
    10	    virtual ~Element() = default;
    11	
    12	    void set_bounds(Rect bounds) noexcept { bounds_ = bounds; }
    13	    Rect bounds() const noexcept { return bounds_; }
    14	
    15	    void set_visible(bool visible) noexcept { visible_ = visible; }
    16	    bool visible() const noexcept { return visible_; }
    17	
    18	    void set_enabled(bool enabled) noexcept { enabled_ = enabled; }
    19	    bool enabled() const noexcept { return enabled_; }
    20	
    21	    void set_focusable(bool focusable) noexcept {
    22	        focusable_ = focusable;
    23	    }
    24	
    25	    bool focusable() const noexcept { return focusable_; }
    26	
    27	    void set_focused(bool focused) noexcept { focused_ = focused; }
    28	    bool focused() const noexcept { return focused_; }
    29	
    30	    void render(Renderer& renderer) {
    31	        if (visible_) draw(renderer);
    32	    }
    33	
    34	protected:
    35	    virtual void draw(Renderer& renderer) = 0;
    36	
    37	private:
    38	    Rect bounds_{};
    39	    bool visible_ = true;
    40	    bool enabled_ = true;
    41	    bool focusable_ = false;
    42	    bool focused_ = false;
    43	};
    44	
    45	} // namespace kiddos::ui
