=== Main application construction ===
#include "kiddos/app/application.hpp"
#include "kiddos/platform/sdl_platform.hpp"

int main() {
    kiddos::SDLPlatform platform;
    kiddos::Application application(platform);
    return application.run();
}
=== Application and platform interfaces ===
#pragma once

#include "kiddos/platform/platform.hpp"

namespace kiddos {

class Application {
public:
    explicit Application(Platform& platform);

    int run();

private:
    Platform& platform_;
    bool running_ = true;
    int selected_game_ = 1;
    bool action_screen_ = false;
    int selected_action_ = 0;
    static constexpr int game_count_ = 3;

    void handle_action(Action action);
    void render();
};

} // namespace kiddos
#pragma once

#include "kiddos/platform/platform.hpp"

#include <SDL.h>

namespace kiddos {

class SDLPlatform final : public Platform {
public:
    SDLPlatform() = default;
    ~SDLPlatform() override;

    bool initialize() override;
    bool poll_action(Action& action) override;
    void begin_frame() override;
    void draw_carousel(int selected_index) override;
    void draw_game_actions(int selected_index, bool has_checkpoint, int selected_action) override;
    void present() override;
    void shutdown() override;

private:
    SDL_Window* window_ = nullptr;
    SDL_Renderer* renderer_ = nullptr;
    SDL_GameController* controller_ = nullptr;
    SDL_JoystickID controller_instance_ = -1;
    bool initialized_ = false;

    void open_controller(int device_index);
    void close_controller();
    static Action map_key(SDL_Keycode key);
    static Action map_controller_button(Uint8 button);
};

} // namespace kiddos
