   288	void draw_art(SDL_Renderer* r, int index,
   289	              SDL_Rect area, Uint8 alpha) {
   290	    if (index < 0 || index >= static_cast<int>(artwork_textures.size())) return;
   291	    SDL_Texture* texture = artwork_textures[static_cast<std::size_t>(index)];
   292	    if (!texture) return;
   293	
   294	    SDL_SetTextureAlphaMod(texture, alpha);
   295	    SDL_RenderCopy(r, texture, nullptr, &area);
   296	    SDL_SetTextureAlphaMod(texture, 255);
   297	}
   298	
   299	void draw_card(SDL_Renderer* r, int index,
   300	               SDL_Rect rect, bool selected) {
   301	    const Uint8 alpha = selected ? 255 : 145;
   302	
   303	    rounded_fill(r,
   304	                 {rect.x - 5, rect.y - 5, rect.w + 10, rect.h + 10},
   305	                 30, {7, 13, 32, static_cast<Uint8>(selected ? 255 : 170)});
   306	
   307	    rounded_fill(r, rect, 25, {20, 34, 65, alpha});
   308	
   309	    SDL_Rect art{
   310	        rect.x + 9,
   311	        rect.y + 9,
   312	        rect.w - 18,
   313	        rect.h - 18
   314	    };
   315	
   316	    SDL_RenderSetClipRect(r, &art);
   317	    draw_art(r, index, art, alpha);
   318	    SDL_RenderSetClipRect(r, nullptr);
   319	    mask_artwork_corners(r, art, 18, {20, 34, 65, alpha});
   320	
   321	    // A three-pass concentric outline gives the card a substantial,
   322	    // uniform border consistent with the home carousel's heavier frames.
   323	    for (int inset = 0; inset < 3; ++inset) {
   324	        rounded_outline(r,
   325	                        {rect.x + inset, rect.y + inset,
   326	                         rect.w - inset * 2, rect.h - inset * 2},
   327	                        25 - inset,
   328	                        selected
   329	                            ? Color{69, 151, 255, 255}
   330	                            : Color{80, 117, 170, 110});
   331	    }
   332	
   333	    if (selected) {
   334	        rounded_outline(r,
   335	                        {rect.x - 2, rect.y - 2, rect.w + 4, rect.h + 4},
   336	                        27, {43, 105, 210, 170});
   337	    }
   338	}
