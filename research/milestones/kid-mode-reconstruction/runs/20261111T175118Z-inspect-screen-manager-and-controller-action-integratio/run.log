=== UI CONTROLLER ===
#pragma once

#include "kiddos/ui/button.hpp"
#include "kiddos/ui/focus.hpp"

namespace kiddos::ui {

enum class UIAction {
    Left,
    Right,
    Up,
    Down,
    Confirm,
    Back
};

class ControllerInteraction final {
public:
    explicit ControllerInteraction(FocusManager& focus) noexcept;

    bool handle(UIAction action);
    bool cancel() noexcept;

private:
    FocusManager& focus_;
};

} // namespace kiddos::ui
#include "kiddos/ui/controller.hpp"
#include "kiddos/ui/toggle.hpp"
#include "kiddos/ui/checkbox.hpp"
#include "kiddos/ui/radio_group.hpp"
#include "kiddos/ui/select.hpp"
#include "kiddos/ui/slider.hpp"
#include "kiddos/ui/list_view.hpp"

namespace kiddos::ui {

ControllerInteraction::ControllerInteraction(FocusManager& focus) noexcept
    : focus_(focus) {
}

bool ControllerInteraction::handle(UIAction action) {
    Element* focused = focus_.focused();

    switch (action) {
        case UIAction::Left:
            if (auto* radio = dynamic_cast<RadioGroup*>(focused))
                return radio->select_previous();
            if (auto* select = dynamic_cast<Select*>(focused))
                return select->select_previous();
            if (auto* slider = dynamic_cast<Slider*>(focused))
                return slider->adjust(-1);
            return focus_.move(Direction::Left);

        case UIAction::Right:
            if (auto* radio = dynamic_cast<RadioGroup*>(focused))
                return radio->select_next();
            if (auto* select = dynamic_cast<Select*>(focused))
                return select->select_next();
            if (auto* slider = dynamic_cast<Slider*>(focused))
                return slider->adjust(1);
            return focus_.move(Direction::Right);

        case UIAction::Up:
            if (auto* radio = dynamic_cast<RadioGroup*>(focused))
                return radio->select_previous();
            if (auto* list = dynamic_cast<ListView*>(focused))
                return list->move_selection(-1);
            return focus_.move(Direction::Up);

        case UIAction::Down:
            if (auto* radio = dynamic_cast<RadioGroup*>(focused))
                return radio->select_next();
            if (auto* list = dynamic_cast<ListView*>(focused))
                return list->move_selection(1);
            return focus_.move(Direction::Down);

        case UIAction::Confirm:
            if (auto* button = dynamic_cast<Button*>(focused))
                return button->activate();
            if (auto* toggle = dynamic_cast<Toggle*>(focused))
                return toggle->toggle();
            if (auto* checkbox = dynamic_cast<Checkbox*>(focused))
                return checkbox->toggle();
            if (auto* list = dynamic_cast<ListView*>(focused))
                return list->activate_selected();
            return false;

        case UIAction::Back:
            return cancel();
    }

    return false;
}

bool ControllerInteraction::cancel() noexcept {
    return false;
}

} // namespace kiddos::ui
=== SCREEN MANAGER ===
#pragma once
#include "kiddos/ui/screen.hpp"
#include <memory>
#include <vector>
namespace kiddos::ui {
class ScreenManager final {
public:
    ~ScreenManager();
    ScreenManager() = default;
    ScreenManager(const ScreenManager&) = delete;
    ScreenManager& operator=(const ScreenManager&) = delete;
    bool push(std::unique_ptr<Screen> screen);
    bool pop();
    bool replace(std::unique_ptr<Screen> screen);
    void clear() noexcept;
    Screen* current() noexcept;
    const Screen* current() const noexcept;
    std::size_t depth() const noexcept;
    void update(float delta_seconds);
    void render(Renderer& renderer);
    bool handle_action(UIAction action);
    bool handle_text_input(const ::kiddos::TextInputEvent& event);
private:
    std::vector<std::unique_ptr<Screen>> stack_;
};
}
#include "kiddos/ui/screen_manager.hpp"
namespace kiddos::ui {
ScreenManager::~ScreenManager() { clear(); }
bool ScreenManager::push(std::unique_ptr<Screen> screen) {
    if (!screen) return false;
    if (auto* active = current()) active->on_suspend();
    auto* next = screen.get();
    stack_.push_back(std::move(screen));
    next->on_enter();
    next->focus().focus_first();
    return true;
}
bool ScreenManager::pop() {
    if (stack_.empty()) return false;
    stack_.back()->on_exit();
    stack_.pop_back();
    if (auto* active = current()) { active->on_resume(); active->focus().focus_first(); }
    return true;
}
bool ScreenManager::replace(std::unique_ptr<Screen> screen) {
    if (!screen) return false;
    if (auto* active = current()) { active->on_exit(); stack_.pop_back(); }
    auto* next = screen.get();
    stack_.push_back(std::move(screen));
    next->on_enter();
    next->focus().focus_first();
    return true;
}
void ScreenManager::clear() noexcept {
    while (!stack_.empty()) { stack_.back()->on_exit(); stack_.pop_back(); }
}
Screen* ScreenManager::current() noexcept { return stack_.empty() ? nullptr : stack_.back().get(); }
const Screen* ScreenManager::current() const noexcept { return stack_.empty() ? nullptr : stack_.back().get(); }
std::size_t ScreenManager::depth() const noexcept { return stack_.size(); }
void ScreenManager::update(float dt) { if (auto* s=current()) s->update(dt); }
void ScreenManager::render(Renderer& r) { if (auto* s=current()) s->render(r); }
bool ScreenManager::handle_action(UIAction a) {
    if (a == UIAction::Back) return pop();
    auto* s=current(); return s ? s->handle_action(a) : false;
}
bool ScreenManager::handle_text_input(const ::kiddos::TextInputEvent& e) {
    auto* s=current(); return s ? s->handle_text_input(e) : false;
}
}
