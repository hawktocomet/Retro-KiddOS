namespace kiddos::ui {
class Screen {
public:
    Screen() noexcept;
    virtual ~Screen() = default;
    Screen(const Screen&) = delete;
    Screen& operator=(const Screen&) = delete;
    Container& root() noexcept;
    FocusManager& focus() noexcept;
    virtual void on_enter() {}
    virtual void on_exit() {}
    virtual void on_suspend() {}
    virtual void on_resume() {}
    virtual void update(float) {}
    virtual void render(Renderer& renderer);
    bool handle_action(UIAction action);
    bool handle_text_input(const ::kiddos::TextInputEvent& event);
private:
    Container root_;
    FocusManager focus_;
    ControllerInteraction controller_;
    TextInputInteraction text_input_;
};
}
#pragma once

#include "kiddos/ui/element.hpp"

#include <memory>
#include <type_traits>
#include <utility>
#include <vector>

namespace kiddos::ui {

class Container : public Element {
public:
    template<typename T, typename... Args>
    T& add(Args&&... args) {
        static_assert(std::is_base_of_v<Element, T>,
                      "Container children must derive from Element");

        auto child = std::make_unique<T>(
            std::forward<Args>(args)...
        );

        T& reference = *child;
        children_.push_back(std::move(child));
        return reference;
    }

    std::size_t child_count() const noexcept {
        return children_.size();
    }

    Element* child(std::size_t index) noexcept {
        if (index >= children_.size()) return nullptr;
        return children_[index].get();
    }

    const Element* child(std::size_t index) const noexcept {
        if (index >= children_.size()) return nullptr;
        return children_[index].get();
    }

protected:
    void draw(Renderer& renderer) override {
        for (auto& element : children_) {
            element->render(renderer);
        }
    }

private:
    std::vector<std::unique_ptr<Element>> children_;
};

} // namespace kiddos::ui
#pragma once
#include "kiddos/ui/screen.hpp"
#include <memory>
#include <vector>
namespace kiddos::ui {
class ScreenManager final {
public:
    ~ScreenManager();
    ScreenManager() = default;
    ScreenManager(const ScreenManager&) = delete;
    ScreenManager& operator=(const ScreenManager&) = delete;
    bool push(std::unique_ptr<Screen> screen);
    bool pop();
    bool replace(std::unique_ptr<Screen> screen);
    void clear() noexcept;
    Screen* current() noexcept;
    const Screen* current() const noexcept;
    std::size_t depth() const noexcept;
    void update(float delta_seconds);
    void render(Renderer& renderer);
    bool handle_action(UIAction action);
    bool handle_text_input(const ::kiddos::TextInputEvent& event);
private:
    std::vector<std::unique_ptr<Screen>> stack_;
};
}
#include "kiddos/ui/screen_manager.hpp"
namespace kiddos::ui {
ScreenManager::~ScreenManager() { clear(); }
bool ScreenManager::push(std::unique_ptr<Screen> screen) {
    if (!screen) return false;
    if (auto* active = current()) active->on_suspend();
    auto* next = screen.get();
    stack_.push_back(std::move(screen));
    next->on_enter();
    next->focus().focus_first();
    return true;
}
bool ScreenManager::pop() {
    if (stack_.empty()) return false;
    stack_.back()->on_exit();
    stack_.pop_back();
    if (auto* active = current()) { active->on_resume(); active->focus().focus_first(); }
    return true;
}
bool ScreenManager::replace(std::unique_ptr<Screen> screen) {
    if (!screen) return false;
    if (auto* active = current()) { active->on_exit(); stack_.pop_back(); }
    auto* next = screen.get();
    stack_.push_back(std::move(screen));
    next->on_enter();
    next->focus().focus_first();
    return true;
}
void ScreenManager::clear() noexcept {
    while (!stack_.empty()) { stack_.back()->on_exit(); stack_.pop_back(); }
}
Screen* ScreenManager::current() noexcept { return stack_.empty() ? nullptr : stack_.back().get(); }
const Screen* ScreenManager::current() const noexcept { return stack_.empty() ? nullptr : stack_.back().get(); }
std::size_t ScreenManager::depth() const noexcept { return stack_.size(); }
void ScreenManager::update(float dt) { if (auto* s=current()) s->update(dt); }
void ScreenManager::render(Renderer& r) { if (auto* s=current()) s->render(r); }
bool ScreenManager::handle_action(UIAction a) {
    if (a == UIAction::Back) return pop();
    auto* s=current(); return s ? s->handle_action(a) : false;
}
bool ScreenManager::handle_text_input(const ::kiddos::TextInputEvent& e) {
    auto* s=current(); return s ? s->handle_text_input(e) : false;
}
}

===== LABEL AND FONT APIs =====
#pragma once

#include "kiddos/ui/element.hpp"
#include "kiddos/ui/font.hpp"

#include <string>

namespace kiddos::ui {

enum class LabelAlignment {
    left,
    center,
    right
};

class Label final : public Element {
public:
    explicit Label(std::string text = {});

    void set_text(std::string text);
    const std::string& text() const noexcept;

    void set_font(const Font* font) noexcept;
    const Font* font() const noexcept;

    void set_color(Color color) noexcept;
    Color color() const noexcept;

    void set_alignment(LabelAlignment alignment) noexcept;
    LabelAlignment alignment() const noexcept;

private:
    std::string text_;
    const Font* font_ = nullptr;
    Color color_{255, 255, 255, 255};
    LabelAlignment alignment_ = LabelAlignment::left;

    void draw(Renderer& renderer) override;
};

}
#include "kiddos/ui/label.hpp"
#include "kiddos/ui/text.hpp"

#include <SDL_ttf.h>
#include <utility>

namespace kiddos::ui {

Label::Label(std::string text)
    : text_(std::move(text)) {
}

void Label::set_text(std::string text) {
    text_ = std::move(text);
}

const std::string& Label::text() const noexcept {
    return text_;
}

void Label::set_font(const Font* font) noexcept {
    font_ = font;
}

const Font* Label::font() const noexcept {
    return font_;
}

void Label::set_color(Color color) noexcept {
    color_ = color;
}

Color Label::color() const noexcept {
    return color_;
}

void Label::set_alignment(LabelAlignment alignment) noexcept {
    alignment_ = alignment;
}

LabelAlignment Label::alignment() const noexcept {
    return alignment_;
}

void Label::draw(Renderer& renderer) {
    const Rect area = bounds();

    if (!font_ || !font_->valid() || text_.empty() || area.empty()) {
        return;
    }

    int width = 0;
    int height = 0;

    if (TTF_SizeUTF8(font_->native(), text_.c_str(), &width, &height) != 0) {
        return;
    }

    int x = area.x;

    switch (alignment_) {
        case LabelAlignment::left:
            break;
        case LabelAlignment::center:
            x += (area.w - width) / 2;
            break;
        case LabelAlignment::right:
            x += area.w - width;
            break;
    }

    const int y = area.y + (area.h - height) / 2;

    TextRenderer text_renderer(renderer);
    text_renderer.draw(text_, *font_, {x, y}, color_);
}

}
#pragma once
#include <SDL_ttf.h>
#include <string>

namespace kiddos::ui {
class Font final {
public:
    Font() = default;
    ~Font();
    Font(const Font&) = delete;
    Font& operator=(const Font&) = delete;
    Font(Font&& other) noexcept;
    Font& operator=(Font&& other) noexcept;
    bool load(const std::string& path, int point_size);
    void reset() noexcept;
    bool valid() const noexcept;
    TTF_Font* native() const noexcept;
private:
    TTF_Font* font_ = nullptr;
};
}
#include "kiddos/ui/font.hpp"
#include <utility>

namespace kiddos::ui {
Font::~Font() { reset(); }
Font::Font(Font&& other) noexcept
    : font_(std::exchange(other.font_, nullptr)) {}
Font& Font::operator=(Font&& other) noexcept {
    if (this != &other) {
        reset();
        font_ = std::exchange(other.font_, nullptr);
    }
    return *this;
}
bool Font::load(const std::string& path, int point_size) {
    reset();
    if (path.empty() || point_size <= 0) return false;
    font_ = TTF_OpenFont(path.c_str(), point_size);
    return font_ != nullptr;
}
void Font::reset() noexcept {
    if (font_) {
        TTF_CloseFont(font_);
        font_ = nullptr;
    }
}
bool Font::valid() const noexcept { return font_ != nullptr; }
TTF_Font* Font::native() const noexcept { return font_; }
}

