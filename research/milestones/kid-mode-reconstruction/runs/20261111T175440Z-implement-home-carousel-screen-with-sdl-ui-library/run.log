import struct
def px(name, sx, sy):
    p=f"assets/artwork/generated/{name}.bmp"
    data=open(p,'rb').read()
    off=struct.unpack('<I',data[10:14])[0]
    w,h=struct.unpack('<ii',data[18:26])
    bpp=struct.unpack('<H',data[28:30])[0]
    row=((w*3+3)//4)*4
    y = sy if h>0 else abs(h)-1-sy
    base=off+y*row
    b,g,r=data[base+sx*3:base+sx*3+3]
    return (r,g,b)
# find an opaque pixel near center of title texture (360x52)
for x,y in [(180,26),(100,20),(200,30),(60,26),(300,26)]:
    print("title",x,y,px("carousel-title",x,y))
for x,y in [(90,80),(60,60),(120,100)]:
    print("mushroom",x,y,px("carousel-mushroom",x,y))
