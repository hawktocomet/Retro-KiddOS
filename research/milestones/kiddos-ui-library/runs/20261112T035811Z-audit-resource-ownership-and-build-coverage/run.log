    10	enum class ImageFit {
    11	    contain,
    12	    cover,
    13	    stretch
    14	};
    15	
    16	struct ImageGeometry {
    17	    Rect source{};
    18	    Rect destination{};
    19	    bool valid = false;
    20	};
    21	
    22	ImageGeometry calculate_image_geometry(
    23	    int texture_width,
    24	    int texture_height,
    25	    Rect bounds,
    26	    ImageFit fit
    27	) noexcept;
