namespace kiddos::ui {

struct ThemeColors {
    Color background{12, 20, 40, 255};
    Color surface{20, 34, 65, 255};
    Color surface_alt{27, 43, 76, 255};
    Color primary{45, 125, 230, 255};
    Color primary_bright{75, 155, 255, 255};
    Color primary_dark{25, 75, 145, 255};
    Color text{245, 248, 255, 255};
    Color text_muted{160, 175, 200, 255};
    Color disabled{45, 50, 65, 255};
    Color border{65, 105, 165, 255};
};

class Theme final {
public:
    Theme() = default;
    explicit Theme(ThemeColors colors) noexcept;

    static Theme kiddos_default() noexcept;

    const ThemeColors& colors() const noexcept;
    void set_colors(ThemeColors colors) noexcept;

    ButtonStyle button_style() const noexcept;
    PanelStyle panel_style() const noexcept;
    ToggleStyle toggle_style() const noexcept;
    SliderStyle slider_style() const noexcept;
    ProgressBarStyle progress_bar_style() const noexcept;
    ListViewStyle list_view_style() const noexcept;
    CheckboxStyle checkbox_style() const noexcept;
    RadioGroupStyle radio_group_style() const noexcept;
    SelectStyle select_style() const noexcept;
    TextInputStyle text_input_style() const noexcept;

private:
    ThemeColors colors_{};
};

}
#include "kiddos/ui/theme.hpp"

namespace kiddos::ui {

Theme::Theme(ThemeColors colors) noexcept
    : colors_(colors) {
}

Theme Theme::kiddos_default() noexcept {
    return Theme{};
}

const ThemeColors& Theme::colors() const noexcept {
    return colors_;
}

void Theme::set_colors(ThemeColors colors) noexcept {
    colors_ = colors;
}

ButtonStyle Theme::button_style() const noexcept {
    ButtonStyle style;
    style.normal = colors_.surface;
    style.focused = colors_.primary_dark;
    style.pressed = colors_.primary;
    style.disabled = colors_.disabled;
    style.border = colors_.border;
    style.focused_border = colors_.primary_bright;
    style.text = colors_.text;
    style.disabled_text = colors_.text_muted;
    return style;
}

PanelStyle Theme::panel_style() const noexcept {
    PanelStyle style;
    style.background = colors_.surface;
    style.border = colors_.border;
    style.border_thickness = 2;
    return style;
}

ToggleStyle Theme::toggle_style() const noexcept {
    ToggleStyle style;
    style.off = colors_.disabled;
    style.on = colors_.primary;
    style.knob = colors_.text;
    style.focused_border = colors_.primary_bright;
    return style;
}

SliderStyle Theme::slider_style() const noexcept {
    SliderStyle style;
    style.track = colors_.disabled;
    style.fill = colors_.primary;
    style.knob = colors_.text;
    style.focused_border = colors_.primary_bright;
    return style;
}

ProgressBarStyle Theme::progress_bar_style() const noexcept {
    ProgressBarStyle style;
    style.background = colors_.disabled;
    style.fill = colors_.primary;
    style.border = colors_.border;
    style.border_thickness = 1;
    return style;
}

ListViewStyle Theme::list_view_style() const noexcept {
    ListViewStyle style;
    style.background = colors_.surface;
    style.selected = colors_.primary_dark;
    style.text = colors_.text;
    style.disabled_text = colors_.text_muted;
    style.border = colors_.border;
    return style;
}

CheckboxStyle Theme::checkbox_style() const noexcept {
    CheckboxStyle style;
    style.background = colors_.surface;
    style.checked = colors_.primary;
    style.checkmark = colors_.text;
    style.border = colors_.border;
    style.focused_border = colors_.primary_bright;
    style.text = colors_.text;
    style.disabled_text = colors_.text_muted;
    return style;
}


RadioGroupStyle Theme::radio_group_style() const noexcept {
    RadioGroupStyle style;
    style.background = colors_.surface;
    style.selected = colors_.primary;
    style.indicator = colors_.text;
    style.border = colors_.border;
    style.focused_border = colors_.primary_bright;
    style.text = colors_.text;
    style.disabled_text = colors_.text_muted;
    return style;
}


SelectStyle Theme::select_style() const noexcept {
    SelectStyle style;
    style.background = colors_.surface;
    style.border = colors_.border;
    style.focused_border = colors_.primary_bright;
    style.text = colors_.text;
    style.disabled_text = colors_.text_muted;
    style.arrow = colors_.primary_bright;
    return style;
}


TextInputStyle Theme::text_input_style() const noexcept {
    TextInputStyle style;
    style.background = colors_.surface;
    style.border = colors_.border;
    style.focused_border = colors_.primary_bright;
    style.text = colors_.text;
    style.placeholder = colors_.text_muted;
    style.cursor = colors_.primary_bright;
    style.disabled_text = colors_.text_muted;
    return style;
}


