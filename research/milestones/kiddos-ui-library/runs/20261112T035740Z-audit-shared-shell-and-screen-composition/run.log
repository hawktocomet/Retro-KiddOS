     8	Panel::Panel(PanelStyle style)
     9	    : style_(std::move(style)) {
    10	    style_.border_thickness = std::max(0, style_.border_thickness);
    11	    style_.corner_radius = std::max(0, style_.corner_radius);
    12	}
    13	
    14	void Panel::set_style(PanelStyle style) noexcept {
    15	    style.border_thickness = std::max(0, style.border_thickness);
    16	    style.corner_radius = std::max(0, style.corner_radius);
    17	    style_ = style;
    18	}
    19	
    20	const PanelStyle& Panel::style() const noexcept {
    21	    return style_;
    22	}
    23	
    24	void Panel::set_background(Color color) noexcept {
    25	    style_.background = color;
    26	}
    27	
    28	void Panel::set_border(Color color) noexcept {
    29	    style_.border = color;
    30	}
    31	
    32	void Panel::set_border_thickness(int thickness) noexcept {
    33	    style_.border_thickness = std::max(0, thickness);
    34	}
    35	
    36	void Panel::set_corner_radius(int radius) noexcept {
    37	    style_.corner_radius = std::max(0, radius);
    38	}
    39	
    40	void Panel::draw(Renderer& renderer) {
    41	    const Rect rect = bounds();
    42	    if (rect.empty()) return;
    43	
    44	    const int radius = style_.corner_radius;
    45	    const int thickness = std::min(
    46	        style_.border_thickness, std::min(rect.w, rect.h) / 2
    47	    );
    48	
    49	    // An opaque background allows a clean, uniform border: fill the card
    50	    // with the border color, then the inset area with the background. This
    51	    // avoids stacking nested outlines, which look crude at small radii.
    52	    if (thickness > 0 && style_.background.a == 255) {
    53	        renderer.fill_rounded_rect(rect, radius, style_.border);
    54	
    55	        const Rect inner{
    56	            rect.x + thickness,
    57	            rect.y + thickness,
    58	            rect.w - thickness * 2,
    59	            rect.h - thickness * 2
    60	        };
    61	
    62	        if (!inner.empty()) {
    63	            renderer.fill_rounded_rect(
    64	                inner, std::max(0, radius - thickness), style_.background
    65	            );
    66	        }
    67	        return;
    68	    }
    69	
    70	    renderer.fill_rounded_rect(rect, radius, style_.background);
    71	
    72	    // Transparent backgrounds (for example glow outlines) draw the border
    73	    // as clean rounded outlines instead of covering the content beneath.
    74	    for (int inset = 0; inset < thickness; ++inset) {
    75	        const Rect outline{
    76	            rect.x + inset,
    77	            rect.y + inset,
    78	            rect.w - inset * 2,
    79	            rect.h - inset * 2
    80	        };
    81	
    82	        if (outline.empty()) break;
    83	        renderer.outline_rounded_rect(
    84	            outline,
    85	            std::max(0, radius - inset),
    86	            style_.border
    87	        );
    88	    }
    89	}
    90	
    91	}

