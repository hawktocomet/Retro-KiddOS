    71	void HomeCarouselScreen::set_selected_game(int index) {
    72	    if (index < 0 || index >= game_count) return;
    73	    if (index == selected_game_) return;
    74	
    75	    const int previous = selected_game_;
    76	    const bool moving_right =
    77	        previous >= 0 && index == (previous + 1) % game_count;
    78	    const bool moving_left =
    79	        previous >= 0 && index == (previous + game_count - 1) % game_count;
    80	
    81	    if (moving_right) {
    82	        auto* recycled = game_images_[0];
    83	        game_images_[0] = game_images_[1];
    84	        game_images_[1] = game_images_[2];
    85	        game_images_[2] = recycled;
    86	        recycled->set_bounds({720, right_art.y, right_art.w, right_art.h});
    87	    } else if (moving_left) {
    88	        auto* recycled = game_images_[2];
    89	        game_images_[2] = game_images_[1];
    90	        game_images_[1] = game_images_[0];
    91	        game_images_[0] = recycled;
    92	        recycled->set_bounds({-128, left_art.y, left_art.w, left_art.h});
    93	    }
    94	
    95	    selected_game_ = index;
    96	
    97	    const std::array<int, 3> visible_games{
    98	        (index + game_count - 1) % game_count,
    99	        index,
   100	        (index + 1) % game_count
   101	    };
   102	    const std::array<ui::Rect, 3> slot_bounds{
   103	        left_art, center_art, right_art
   104	    };
   105	
   106	    for (std::size_t slot = 0; slot < game_images_.size(); ++slot) {
   107	        auto* image = game_images_[slot];
   108	        image->set_texture(
   109	            &game_textures_[static_cast<std::size_t>(visible_games[slot])]);
   110	        target_bounds_[slot] = slot_bounds[slot];
   111	        target_opacity_[slot] = slot == 1 ? 255 : 118;
   112	
   113	        if (!moving_right && !moving_left) {
   114	            image->set_bounds(slot_bounds[slot]);
   115	            image->set_opacity(
   116	                static_cast<std::uint8_t>(target_opacity_[slot]));
   117	        }
   118	    }
   119	}
   120	
   121	void HomeCarouselScreen::update(float delta_seconds) {
   122	    if (delta_seconds <= 0.0f) return;
   123	
   124	    // A critically damped-feeling ease that settles quickly while allowing
   125	    // another direction input to retarget the carousel mid-motion.
   126	    const float amount = std::clamp(
   127	        1.0f - std::exp(-delta_seconds * 7.0f), 0.0f, 1.0f);
   128	
   129	    for (std::size_t i = 0; i < game_images_.size(); ++i) {
   130	        ui::Image* image = game_images_[i];
   131	        if (!image) continue;
   132	
   133	        const ui::Rect current = image->bounds();
   134	        const ui::Rect target = target_bounds_[i];
   135	        const ui::Rect next = interpolate_rect(current, target, amount);
   136	
   137	        const int opacity = interpolate(
   138	            image->opacity(), target_opacity_[i], amount);
   139	
   140	        image->set_bounds(next);
   141	        image->set_opacity(static_cast<std::uint8_t>(
   142	            std::clamp(opacity, 0, 255)));
   143	
   144	        if (std::abs(next.x - target.x) <= 1 &&
   145	            std::abs(next.y - target.y) <= 1 &&
   146	            std::abs(next.w - target.w) <= 1 &&
   147	            std::abs(next.h - target.h) <= 1) {
   148	            image->set_bounds(target);
   149	        }
   150	
   151	        if (std::abs(opacity - target_opacity_[i]) <= 1) {
   152	            image->set_opacity(
   153	                static_cast<std::uint8_t>(target_opacity_[i]));
   154	        }
   155	    }
   156	}
