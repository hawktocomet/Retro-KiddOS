=== Text rendering API ===
#pragma once
#include "kiddos/ui/color.hpp"
#include "kiddos/ui/font.hpp"
#include "kiddos/ui/geometry.hpp"
#include "kiddos/ui/renderer.hpp"
#include <string>

namespace kiddos::ui {
class TextRenderer final {
public:
    explicit TextRenderer(Renderer& renderer) noexcept;
    bool draw(const std::string& text, const Font& font,
              Point position, Color color);
    bool draw_centered(const std::string& text, const Font& font,
                       Rect area, Color color);
private:
    Renderer& renderer_;
};
}
#pragma once
#include <SDL_ttf.h>
#include <string>

namespace kiddos::ui {
class Font final {
public:
    Font() = default;
    ~Font();
    Font(const Font&) = delete;
    Font& operator=(const Font&) = delete;
    Font(Font&& other) noexcept;
    Font& operator=(Font&& other) noexcept;
    bool load(const std::string& path, int point_size);
    void reset() noexcept;
    bool valid() const noexcept;
    TTF_Font* native() const noexcept;
private:
    TTF_Font* font_ = nullptr;
};
}

=== Element and event APIs ===
#pragma once

#include "kiddos/ui/geometry.hpp"
#include "kiddos/ui/renderer.hpp"

namespace kiddos::ui {

class Element {
public:
    virtual ~Element() = default;

    void set_bounds(Rect bounds) noexcept { bounds_ = bounds; }
    Rect bounds() const noexcept { return bounds_; }

    void set_visible(bool visible) noexcept { visible_ = visible; }
    bool visible() const noexcept { return visible_; }

    void set_enabled(bool enabled) noexcept { enabled_ = enabled; }
    bool enabled() const noexcept { return enabled_; }

    void set_focusable(bool focusable) noexcept {
        focusable_ = focusable;
    }

    bool focusable() const noexcept { return focusable_; }

    void set_focused(bool focused) noexcept { focused_ = focused; }
    bool focused() const noexcept { return focused_; }

    void render(Renderer& renderer) {
        if (visible_) draw(renderer);
    }

protected:
    virtual void draw(Renderer& renderer) = 0;

private:
    Rect bounds_{};
    bool visible_ = true;
    bool enabled_ = true;
    bool focusable_ = false;
    bool focused_ = false;
};

} // namespace kiddos::ui
