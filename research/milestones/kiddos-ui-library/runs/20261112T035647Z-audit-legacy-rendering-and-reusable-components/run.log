     1	#include "kiddos/ui/screen_manager.hpp"
     2	
     3	#include <cassert>
     4	#include <memory>
     5	
     6	struct Counts {
     7	    int entered = 0;
     8	    int exited = 0;
     9	    int suspended = 0;
    10	    int resumed = 0;
    11	    int activated = 0;
    12	};
    13	
    14	class ProbeScreen final : public kiddos::ui::Screen {
    15	public:
    16	    explicit ProbeScreen(Counts& counts) : counts_(counts) {}
    17	
    18	    void on_enter() override {
    19	        ++counts_.entered;
    20	        auto& button = root().add<kiddos::ui::Button>("Activate");
    21	        button.set_on_activate([this] { ++counts_.activated; });
    22	    }
    23	
    24	    void on_exit() override { ++counts_.exited; }
    25	    void on_suspend() override { ++counts_.suspended; }
    26	    void on_resume() override { ++counts_.resumed; }
    27	
    28	private:
    29	    Counts& counts_;
    30	};
    31	
    32	int main() {
    33	    using namespace kiddos::ui;
    34	
    35	    ScreenManager manager;
    36	    Counts first_counts;
    37	    Counts second_counts;
    38	    Counts third_counts;
    39	    Counts fourth_counts;
    40	
    41	    assert(manager.depth() == 0);
    42	    assert(manager.current() == nullptr);
    43	    assert(!manager.pop());
    44	    assert(!manager.handle_action(UIAction::Back));
    45	
    46	    auto first = std::make_unique<ProbeScreen>(first_counts);
    47	    auto* first_ptr = first.get();
    48	    assert(manager.push(std::move(first)));
    49	    assert(manager.current() == first_ptr);
    50	    assert(manager.depth() == 1);
    51	    assert(first_counts.entered == 1);
    52	
    53	    assert(manager.handle_action(UIAction::Confirm));
    54	    assert(first_counts.activated == 1);
    55	
    56	    auto second = std::make_unique<ProbeScreen>(second_counts);
    57	    auto* second_ptr = second.get();
    58	    assert(manager.push(std::move(second)));
    59	    assert(manager.current() == second_ptr);
    60	    assert(manager.depth() == 2);
    61	    assert(first_counts.suspended == 1);
    62	    assert(second_counts.entered == 1);
    63	
    64	    assert(manager.handle_action(UIAction::Confirm));
    65	    assert(second_counts.activated == 1);
    66	
    67	    assert(manager.handle_action(UIAction::Back));
    68	    assert(manager.current() == first_ptr);
    69	    assert(manager.depth() == 1);
    70	    assert(second_counts.exited == 1);
    71	    assert(first_counts.resumed == 1);
    72	
    73	    auto third = std::make_unique<ProbeScreen>(third_counts);
    74	    auto* third_ptr = third.get();
    75	    assert(manager.replace(std::move(third)));
    76	    assert(manager.current() == third_ptr);
    77	    assert(manager.depth() == 1);
    78	    assert(first_counts.exited == 1);
    79	    assert(third_counts.entered == 1);
    80	
    81	    auto fourth = std::make_unique<ProbeScreen>(fourth_counts);
    82	    assert(manager.push(std::move(fourth)));
    83	    assert(manager.depth() == 2);
    84	    assert(third_counts.suspended == 1);
    85	
    86	    manager.clear();
    87	    assert(manager.depth() == 0);
    88	    assert(manager.current() == nullptr);
    89	    assert(fourth_counts.exited == 1);
    90	    assert(third_counts.exited == 1);
    91	
    92	    assert(!manager.handle_action(UIAction::Confirm));
    93	    assert(!manager.handle_action(UIAction::Back));
    94	
    95	    return 0;
    96	}
