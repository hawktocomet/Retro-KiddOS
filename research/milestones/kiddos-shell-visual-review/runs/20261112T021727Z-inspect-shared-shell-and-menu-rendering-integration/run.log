===== CAROUSEL LAYOUT =====
#include "kiddos/app/home_carousel_screen.hpp"

#include <algorithm>
#include <array>
#include <cmath>
#include <string>

namespace kiddos::app {

namespace {

constexpr ui::Color background{1, 1, 1, 255};

constexpr ui::Rect left_art{24, 250, 128, 128};
constexpr ui::Rect center_art{180, 145, 360, 360};
constexpr ui::Rect right_art{568, 250, 128, 128};

int interpolate(int current, int target, float amount) {
    return static_cast<int>(std::lround(
        current + (target - current) * amount));
}

ui::Rect interpolate_rect(
    ui::Rect current,
    ui::Rect target,
    float amount
) {
    return {
        interpolate(current.x, target.x, amount),
        interpolate(current.y, target.y, amount),
        interpolate(current.w, target.w, amount),
        interpolate(current.h, target.h, amount)
    };
}

} // namespace

HomeCarouselScreen::HomeCarouselScreen(SDL_Renderer* renderer) {
    constexpr std::array<const char*, game_count> game_cover_paths{{
        "assets/artwork/generated/boxart/gb-tetris.png",
        "assets/artwork/generated/boxart/gba-mario-kart-super-circuit.png",
        "assets/artwork/generated/boxart/snes-super-mario-world.png",
        "assets/artwork/generated/boxart/arcade-pac-man.png"
    }};

    for (std::size_t game = 0; game < game_textures_.size(); ++game) {
        game_textures_[game].load(renderer, game_cover_paths[game], false);
    }

    const std::array<ui::Rect, 3> slot_bounds{
        left_art, center_art, right_art
    };

    for (std::size_t slot = 0; slot < game_images_.size(); ++slot) {
        auto& image = root().add<ui::Image>();
        image.set_fit(ui::ImageFit::contain);
        image.set_bounds(slot_bounds[slot]);
        game_images_[slot] = &image;
    }

    set_selected_game(1);
}

HomeCarouselScreen::~HomeCarouselScreen() {
    for (auto* image : game_images_) {
        if (image) image->set_texture(nullptr);
    }

}

void HomeCarouselScreen::set_selected_game(int index) {
    if (index < 0 || index >= game_count) return;
    if (index == selected_game_) return;

    const int previous = selected_game_;
    const bool moving_right =
        previous >= 0 && index == (previous + 1) % game_count;
    const bool moving_left =
        previous >= 0 && index == (previous + game_count - 1) % game_count;

    if (moving_right) {
        auto* recycled = game_images_[0];
        game_images_[0] = game_images_[1];
        game_images_[1] = game_images_[2];
        game_images_[2] = recycled;
        recycled->set_bounds({720, right_art.y, right_art.w, right_art.h});
    } else if (moving_left) {
        auto* recycled = game_images_[2];
        game_images_[2] = game_images_[1];
        game_images_[1] = game_images_[0];
        game_images_[0] = recycled;
        recycled->set_bounds({-128, left_art.y, left_art.w, left_art.h});
    }

    selected_game_ = index;

    const std::array<int, 3> visible_games{
        (index + game_count - 1) % game_count,
        index,
        (index + 1) % game_count
    };
    const std::array<ui::Rect, 3> slot_bounds{
        left_art, center_art, right_art
    };

    for (std::size_t slot = 0; slot < game_images_.size(); ++slot) {
        auto* image = game_images_[slot];
        image->set_texture(
            &game_textures_[static_cast<std::size_t>(visible_games[slot])]);
        target_bounds_[slot] = slot_bounds[slot];
        target_opacity_[slot] = slot == 1 ? 255 : 118;

        if (!moving_right && !moving_left) {
            image->set_bounds(slot_bounds[slot]);
            image->set_opacity(
                static_cast<std::uint8_t>(target_opacity_[slot]));
        }
    }
}

void HomeCarouselScreen::update(float delta_seconds) {
    if (delta_seconds <= 0.0f) return;

    // A critically damped-feeling ease that settles quickly while allowing
    // another direction input to retarget the carousel mid-motion.
    const float amount = std::clamp(
        1.0f - std::exp(-delta_seconds * 7.0f), 0.0f, 1.0f);

    for (std::size_t i = 0; i < game_images_.size(); ++i) {
        ui::Image* image = game_images_[i];
        if (!image) continue;

        const ui::Rect current = image->bounds();
        const ui::Rect target = target_bounds_[i];
        const ui::Rect next = interpolate_rect(current, target, amount);

        const int opacity = interpolate(
            image->opacity(), target_opacity_[i], amount);

        image->set_bounds(next);
        image->set_opacity(static_cast<std::uint8_t>(
            std::clamp(opacity, 0, 255)));

        if (std::abs(next.x - target.x) <= 1 &&
            std::abs(next.y - target.y) <= 1 &&
            std::abs(next.w - target.w) <= 1 &&
            std::abs(next.h - target.h) <= 1) {
            image->set_bounds(target);
        }

        if (std::abs(opacity - target_opacity_[i]) <= 1) {
            image->set_opacity(
                static_cast<std::uint8_t>(target_opacity_[i]));
        }
    }
}

} // namespace kiddos::app

===== SELECTED GAME LAYOUT =====
#include "kiddos/app/selected_game_screen.hpp"

#include "kiddos/app/platform.hpp"

#include <array>

namespace kiddos::app {

namespace {

constexpr std::array<const char*, platform_count> artwork_paths{{
    "assets/artwork/generated/boxart/gb-tetris.png",
    "assets/artwork/generated/boxart/gba-mario-kart-super-circuit.png",
    "assets/artwork/generated/boxart/snes-super-mario-world.png",
    "assets/artwork/generated/boxart/arcade-pac-man.png"
}};

void load_ui_font(ui::Font& font, int size) {
    constexpr std::array<const char*, 3> paths{{
        "/usr/share/fonts/TTF/DejaVuSans.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "/usr/share/fonts/dejavu/DejaVuSans.ttf"
    }};

    for (const char* path : paths) {
        if (font.load(path, size)) return;
    }
}

} // namespace

SelectedGameScreen::SelectedGameScreen(
    SDL_Renderer* renderer,
    int selected_game
) : selected_game_(selected_game) {
    if (selected_game_ < 0 ||
        selected_game_ >= static_cast<int>(platform_count)) {
        selected_game_ = 0;
    }

    artwork_texture_.load(
        renderer,
        artwork_paths[static_cast<std::size_t>(selected_game_)],
        false
    );

    auto& artwork = root().add<ui::Image>(&artwork_texture_);
    artwork.set_bounds({90, 85, 540, 450});
    artwork.set_fit(ui::ImageFit::contain);
    artwork_ = &artwork;

    load_ui_font(font_, 28);

    auto& play = root().add<ui::Button>("A  PLAY");
    play.set_bounds({190, 545, 340, 88});
    play.set_font(&font_);
    play.set_style({
        {18, 43, 83, 255},
        {35, 91, 165, 255},
        {14, 55, 112, 255},
        {35, 39, 50, 255},
        {69, 151, 255, 255},
        {125, 190, 255, 255},
        {255, 255, 255, 255},
        {150, 155, 165, 255}
    });
    play.set_on_activate([this] {
        // This records the UI request; the game-launch backend is separate.
        play_requested_ = true;
    });
    play_button_ = &play;
}

SelectedGameScreen::~SelectedGameScreen() {
    if (artwork_) artwork_->set_texture(nullptr);
}

} // namespace kiddos::app

