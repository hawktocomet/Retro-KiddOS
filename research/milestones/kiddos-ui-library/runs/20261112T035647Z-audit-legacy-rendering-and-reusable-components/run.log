   672	void SDLPlatform::draw_carousel(int selected_index) {
   673	    if (!renderer_) return;
   674	
   675	    const int left = (selected_index + 2) % 3;
   676	    const int right = (selected_index + 1) % 3;
   677	
   678	    const Color side_fill{16, 41, 75, 255};
   679	    const Color center_fill{18, 63, 117, 255};
   680	    const Color center_border{36, 164, 255, 255};
   681	
   682	    // Draw the smaller neighboring cards first, behind the main card.
   683	    const SDL_Rect side_left{25, 250, 190, 175};
   684	    const SDL_Rect side_right{505, 250, 190, 175};
   685	
   686	    rounded_fill(renderer_, side_left, 24, side_fill);
   687	    rounded_outline(renderer_, side_left, 24,
   688	                    {55, 105, 165, 190});
   689	    draw_art(renderer_, left,
   690	             {side_left.x + 55, side_left.y + 42, 80, 90}, 180);
   691	
   692	    rounded_fill(renderer_, side_right, 24, side_fill);
   693	    rounded_outline(renderer_, side_right, 24,
   694	                    {55, 105, 165, 190});
   695	    draw_art(renderer_, right,
   696	             {side_right.x + 55, side_right.y + 42, 80, 90}, 180);
   697	
   698	    // Main card is larger and drawn last so it overlaps both neighbors.
   699	    const SDL_Rect center{145, 135, 430, 370};
   700	    rounded_fill(renderer_, center, 30, center_fill);
   701	    rounded_outline(renderer_, center, 30, center_border);
   702	    rounded_outline(renderer_,
   703	                    {center.x - 3, center.y - 3,
   704	                     center.w + 6, center.h + 6},
   705	                    32, {36, 164, 255, 150});
   706	
   707	    // Artwork always follows the actual selected game.
   708	    draw_art(renderer_, selected_index,
   709	             {center.x + 115, center.y + 70, 200, 205}, 255);
   710	
   711	    // Game title belongs below the main card; no SELECTED badge.
   712	    if (carousel_title_texture && selected_index == 1) {
   713	        SDL_Rect title{220, 525, 280, 42};
   714	        SDL_RenderCopy(renderer_, carousel_title_texture,
   715	                       nullptr, &title);
   716	    }
   717	
   718	    draw_status(renderer_);
   719	}
