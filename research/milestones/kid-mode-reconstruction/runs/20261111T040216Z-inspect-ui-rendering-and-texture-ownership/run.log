SDLPlatform::~SDLPlatform() {
    shutdown();
}

bool SDLPlatform::initialize() {
    if (SDL_Init(SDL_INIT_VIDEO | SDL_INIT_GAMECONTROLLER) != 0) {
        std::cerr << "SDL initialization failed: "
                  << SDL_GetError() << '\n';
        return false;
    }

    initialized_ = true;

    window_ = SDL_CreateWindow(
        "Retro KiddOS - Kid Mode",
        SDL_WINDOWPOS_CENTERED,
        SDL_WINDOWPOS_CENTERED,
        720,
        720,
        SDL_WINDOW_SHOWN
    );

    if (!window_) {
        std::cerr << "Window creation failed: "
                  << SDL_GetError() << '\n';
        shutdown();
        return false;
    }

    renderer_ = SDL_CreateRenderer(
        window_, -1,
        SDL_RENDERER_ACCELERATED | SDL_RENDERER_PRESENTVSYNC
    );

    if (!renderer_) {
        renderer_ = SDL_CreateRenderer(
            window_, -1, SDL_RENDERER_SOFTWARE
        );
    }

    if (!renderer_) {
        std::cerr << "Renderer creation failed: "
                  << SDL_GetError() << '\n';
        shutdown();
        return false;
    }

    SDL_SetRenderDrawBlendMode(renderer_, SDL_BLENDMODE_BLEND);

    const char* artwork_paths[] = {
        "assets/artwork/generated/carousel-star.bmp",
        "assets/artwork/generated/carousel-mushroom.bmp",
        "assets/artwork/generated/carousel-car.bmp"
    };
    const char* label_paths[] = {
        "assets/artwork/generated/label-play.bmp",
        "assets/artwork/generated/label-resume.bmp",
        "assets/artwork/generated/label-start-over.bmp"
    };

    for (std::size_t i = 0; i < artwork_textures.size(); ++i) {
        artwork_textures[i] = load_bitmap_texture(renderer_, artwork_paths[i], true);
        if (!artwork_textures[i]) {
            shutdown();
            return false;
        }
    }

    for (std::size_t i = 0; i < action_label_textures.size(); ++i) {
        action_label_textures[i] =
            load_bitmap_texture(renderer_, label_paths[i], true);
        if (!action_label_textures[i]) {
            shutdown();
            return false;
        }
    }

    carousel_title_texture =
        load_bitmap_texture(renderer_, "assets/artwork/generated/carousel-title.bmp", true);
    carousel_selected_texture =
        load_bitmap_texture(renderer_, "assets/artwork/generated/carousel-selected.bmp", true);
    if (!carousel_title_texture || !carousel_selected_texture) {
        shutdown();
        return false;
    }
    SDL_SetTextureBlendMode(carousel_title_texture, SDL_BLENDMODE_BLEND);
    SDL_SetTextureBlendMode(carousel_selected_texture, SDL_BLENDMODE_BLEND);


    for (int index = 0; index < SDL_NumJoysticks(); ++index) {
        if (SDL_IsGameController(index)) {
            open_controller(index);
            if (controller_) {
                break;
            }
        }
    }

    return true;
}

void SDLPlatform::open_controller(int device_index) {
    if (controller_) return;

    controller_ = SDL_GameControllerOpen(device_index);

    if (controller_) {
        controller_instance_ = SDL_JoystickInstanceID(
            SDL_GameControllerGetJoystick(controller_)
        );
    }
}

void SDLPlatform::close_controller() {
    if (controller_) {
        SDL_GameControllerClose(controller_);
        controller_ = nullptr;
    }

    controller_instance_ = -1;

