    17	
    18	int interpolate(int current, int target, float amount) {
    19	    return static_cast<int>(std::lround(
    20	        current + (target - current) * amount));
    21	}
    22	
    23	ui::Rect interpolate_rect(
    24	    ui::Rect current,
    25	    ui::Rect target,
    26	    float amount
    27	) {
    28	    return {
    29	        interpolate(current.x, target.x, amount),
    30	        interpolate(current.y, target.y, amount),
    31	        interpolate(current.w, target.w, amount),
    32	        interpolate(current.h, target.h, amount)
    33	    };
    34	}
