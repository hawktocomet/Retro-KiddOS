=== ELEMENT GEOMETRY AND VISIBILITY ===
#pragma once

#include "kiddos/ui/geometry.hpp"
#include "kiddos/ui/renderer.hpp"

namespace kiddos::ui {

class Element {
public:
    virtual ~Element() = default;

    void set_bounds(Rect bounds) noexcept { bounds_ = bounds; }
    Rect bounds() const noexcept { return bounds_; }

    void set_visible(bool visible) noexcept { visible_ = visible; }
    bool visible() const noexcept { return visible_; }

    void set_enabled(bool enabled) noexcept { enabled_ = enabled; }
    bool enabled() const noexcept { return enabled_; }

    void set_focusable(bool focusable) noexcept {
        focusable_ = focusable;
    }

    bool focusable() const noexcept { return focusable_; }

    void set_focused(bool focused) noexcept { focused_ = focused; }
    bool focused() const noexcept { return focused_; }

    void render(Renderer& renderer) {
        if (visible_) draw(renderer);
    }

protected:
    virtual void draw(Renderer& renderer) = 0;

private:
    Rect bounds_{};
    bool visible_ = true;
    bool enabled_ = true;
    bool focusable_ = false;
    bool focused_ = false;
};

} // namespace kiddos::ui
#include "kiddos/ui/image.hpp"

#include <algorithm>
#include <cmath>

namespace kiddos::ui {

ImageGeometry calculate_image_geometry(
    int texture_width,
    int texture_height,
    Rect bounds,
    ImageFit fit
) noexcept {
    ImageGeometry result{};
    if (texture_width <= 0 || texture_height <= 0 || bounds.empty()) {
        return result;
    }

    result.source = {0, 0, texture_width, texture_height};
    result.destination = bounds;

    if (fit == ImageFit::stretch) {
        result.valid = true;
        return result;
    }

    const double sx = static_cast<double>(bounds.w) / texture_width;
    const double sy = static_cast<double>(bounds.h) / texture_height;

    if (fit == ImageFit::contain) {
        const double scale = std::min(sx, sy);
        const int w = std::max(1, static_cast<int>(std::round(texture_width * scale)));
        const int h = std::max(1, static_cast<int>(std::round(texture_height * scale)));
        result.destination = {
            bounds.x + (bounds.w - w) / 2,
            bounds.y + (bounds.h - h) / 2,
            w,
            h
        };
    } else {
        const double scale = std::max(sx, sy);
        const int crop_w = std::max(1, static_cast<int>(std::round(bounds.w / scale)));
        const int crop_h = std::max(1, static_cast<int>(std::round(bounds.h / scale)));
        result.source = {
            (texture_width - crop_w) / 2,
            (texture_height - crop_h) / 2,
            crop_w,
            crop_h
        };
    }

    result.valid = true;
    return result;
}

Image::Image(Texture* texture) noexcept : texture_(texture) {}

void Image::set_texture(Texture* texture) noexcept { texture_ = texture; }
Texture* Image::texture() const noexcept { return texture_; }

void Image::set_fit(ImageFit fit) noexcept { fit_ = fit; }
ImageFit Image::fit() const noexcept { return fit_; }

ImageGeometry Image::geometry() const noexcept {
    if (!texture_ || !texture_->valid()) return {};
    return calculate_image_geometry(
        texture_->width(), texture_->height(), bounds(), fit_
    );
}

void Image::draw(Renderer& renderer) {
    if (!texture_ || !texture_->valid()) return;
    const ImageGeometry g = geometry();
    if (!g.valid) return;

    if (fit_ == ImageFit::cover) {
        renderer.set_clip(bounds());
        renderer.draw_texture(texture_->native(), g.source, g.destination);
        renderer.clear_clip();
    } else {
        renderer.draw_texture(texture_->native(), g.source, g.destination);
    }
}

}
#include "kiddos/ui/label.hpp"
#include "kiddos/ui/text.hpp"

#include <SDL_ttf.h>
#include <utility>

namespace kiddos::ui {

Label::Label(std::string text)
    : text_(std::move(text)) {
}

void Label::set_text(std::string text) {
    text_ = std::move(text);
}

const std::string& Label::text() const noexcept {
    return text_;
}

void Label::set_font(const Font* font) noexcept {
    font_ = font;
}

const Font* Label::font() const noexcept {
    return font_;
}

void Label::set_color(Color color) noexcept {
    color_ = color;
}

Color Label::color() const noexcept {
    return color_;
}

void Label::set_alignment(LabelAlignment alignment) noexcept {
    alignment_ = alignment;
}

LabelAlignment Label::alignment() const noexcept {
    return alignment_;
}

void Label::draw(Renderer& renderer) {
    const Rect area = bounds();

    if (!font_ || !font_->valid() || text_.empty() || area.empty()) {
        return;
    }

    int width = 0;
    int height = 0;

    if (TTF_SizeUTF8(font_->native(), text_.c_str(), &width, &height) != 0) {
        return;
    }

    int x = area.x;

    switch (alignment_) {
        case LabelAlignment::left:
            break;
        case LabelAlignment::center:
            x += (area.w - width) / 2;
            break;
        case LabelAlignment::right:
            x += area.w - width;
            break;
    }

    const int y = area.y + (area.h - height) / 2;

    TextRenderer text_renderer(renderer);
    text_renderer.draw(text_, *font_, {x, y}, color_);
}

}

=== TEXTURE OWNERSHIP AND LOADING ===
#pragma once

#include <SDL.h>
#include <string>

namespace kiddos::ui {

class Texture final {
public:
    Texture() = default;
    ~Texture();

    Texture(const Texture&) = delete;
    Texture& operator=(const Texture&) = delete;

    Texture(Texture&& other) noexcept;
    Texture& operator=(Texture&& other) noexcept;

    bool load(SDL_Renderer* renderer, const std::string& path);
    void reset() noexcept;
    bool valid() const noexcept;
    int width() const noexcept;
    int height() const noexcept;
    SDL_Texture* native() const noexcept;

private:
    SDL_Texture* texture_ = nullptr;
    int width_ = 0;
    int height_ = 0;
};

}
#include "kiddos/ui/texture.hpp"

#include <SDL_image.h>
#include <utility>

namespace kiddos::ui {

Texture::~Texture() { reset(); }

Texture::Texture(Texture&& other) noexcept
    : texture_(std::exchange(other.texture_, nullptr)),
      width_(std::exchange(other.width_, 0)),
      height_(std::exchange(other.height_, 0)) {}

Texture& Texture::operator=(Texture&& other) noexcept {
    if (this != &other) {
        reset();
        texture_ = std::exchange(other.texture_, nullptr);
        width_ = std::exchange(other.width_, 0);
        height_ = std::exchange(other.height_, 0);
    }
    return *this;
}

bool Texture::load(SDL_Renderer* renderer, const std::string& path) {
    reset();
    if (!renderer || path.empty()) return false;

    SDL_Surface* surface = IMG_Load(path.c_str());
    if (!surface) return false;

    SDL_Texture* loaded = SDL_CreateTextureFromSurface(renderer, surface);
    const int w = surface->w;
    const int h = surface->h;
    SDL_FreeSurface(surface);

    if (!loaded) return false;

    texture_ = loaded;
    width_ = w;
    height_ = h;
    return true;
}

void Texture::reset() noexcept {
    if (texture_) SDL_DestroyTexture(texture_);
    texture_ = nullptr;
    width_ = 0;
    height_ = 0;
}

bool Texture::valid() const noexcept { return texture_ != nullptr; }
int Texture::width() const noexcept { return width_; }
int Texture::height() const noexcept { return height_; }
SDL_Texture* Texture::native() const noexcept { return texture_; }

}

=== RENDERER IMPLEMENTATION ===
#include "kiddos/ui/renderer.hpp"

namespace kiddos::ui {

Renderer::Renderer(SDL_Renderer* renderer) noexcept
    : renderer_(renderer) {
}

void Renderer::attach(SDL_Renderer* renderer) noexcept {
    renderer_ = renderer;
}

bool Renderer::valid() const noexcept {
    return renderer_ != nullptr;
}

SDL_Renderer* Renderer::native() const noexcept {
    return renderer_;
}

bool Renderer::set_color(Color color) const {
    if (!renderer_) return false;

    return SDL_SetRenderDrawColor(
        renderer_,
        color.r,
        color.g,
        color.b,
        color.a
    ) == 0;
}

bool Renderer::clear(Color color) const {
    if (!set_color(color)) return false;
    return SDL_RenderClear(renderer_) == 0;
}

bool Renderer::fill_rect(Rect rect, Color color) const {
    if (!renderer_ || rect.empty() || !set_color(color)) return false;

    SDL_Rect native_rect{rect.x, rect.y, rect.w, rect.h};
    return SDL_RenderFillRect(renderer_, &native_rect) == 0;
}

bool Renderer::outline_rect(Rect rect, Color color) const {
    if (!renderer_ || rect.empty() || !set_color(color)) return false;

    SDL_Rect native_rect{rect.x, rect.y, rect.w, rect.h};
    return SDL_RenderDrawRect(renderer_, &native_rect) == 0;
}

bool Renderer::draw_line(Point from, Point to, Color color) const {
    if (!renderer_ || !set_color(color)) return false;

    return SDL_RenderDrawLine(
        renderer_, from.x, from.y, to.x, to.y
    ) == 0;
}

bool Renderer::draw_point(Point point, Color color) const {
    if (!renderer_ || !set_color(color)) return false;

    return SDL_RenderDrawPoint(
        renderer_, point.x, point.y
    ) == 0;
}

bool Renderer::draw_texture(SDL_Texture* texture, Rect source, Rect destination) const {
    if (!renderer_ || !texture || source.empty() || destination.empty()) return false;

    SDL_Rect src{source.x, source.y, source.w, source.h};
    SDL_Rect dst{destination.x, destination.y, destination.w, destination.h};
    return SDL_RenderCopy(renderer_, texture, &src, &dst) == 0;
}

bool Renderer::set_clip(Rect rect) const {
    if (!renderer_) return false;

    SDL_Rect native_rect{rect.x, rect.y, rect.w, rect.h};
    return SDL_RenderSetClipRect(renderer_, &native_rect) == 0;
}

bool Renderer::clear_clip() const {
    if (!renderer_) return false;

    return SDL_RenderSetClipRect(renderer_, nullptr) == 0;
}

void Renderer::present() const {
    if (renderer_) {
        SDL_RenderPresent(renderer_);
    }
}

} // namespace kiddos::ui

=== PANEL AND THEME ===
#pragma once

#include "kiddos/ui/element.hpp"

namespace kiddos::ui {

struct PanelStyle {
    Color background{20, 30, 55, 255};
    Color border{55, 110, 190, 255};
    int border_thickness = 2;
};

class Panel final : public Element {
public:
    Panel() = default;
    explicit Panel(PanelStyle style);

    void set_style(PanelStyle style) noexcept;
    const PanelStyle& style() const noexcept;

    void set_background(Color color) noexcept;
    void set_border(Color color) noexcept;
    void set_border_thickness(int thickness) noexcept;

private:
    PanelStyle style_{};

    void draw(Renderer& renderer) override;
};

}
#include "kiddos/ui/panel.hpp"

#include <algorithm>
#include <utility>

namespace kiddos::ui {

Panel::Panel(PanelStyle style)
    : style_(std::move(style)) {
    style_.border_thickness = std::max(0, style_.border_thickness);
}

void Panel::set_style(PanelStyle style) noexcept {
    style.border_thickness = std::max(0, style.border_thickness);
    style_ = style;
}

const PanelStyle& Panel::style() const noexcept {
    return style_;
}

void Panel::set_background(Color color) noexcept {
    style_.background = color;
}

void Panel::set_border(Color color) noexcept {
    style_.border = color;
}

void Panel::set_border_thickness(int thickness) noexcept {
    style_.border_thickness = std::max(0, thickness);
}

void Panel::draw(Renderer& renderer) {
    const Rect rect = bounds();
    if (rect.empty()) return;

    renderer.fill_rect(rect, style_.background);

    if (style_.border_thickness <= 0) return;

    renderer.outline_rect(rect, style_.border);

    for (int inset = 1; inset < style_.border_thickness; ++inset) {
        const Rect inner{
            rect.x + inset,
            rect.y + inset,
            rect.w - inset * 2,
            rect.h - inset * 2
        };

        if (inner.empty()) break;
        renderer.outline_rect(inner, style_.border);
    }
}

}
