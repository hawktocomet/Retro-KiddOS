from PIL import Image
import struct
def bmp_pixels(path):
    data = open(path,'rb').read()
    off = struct.unpack("<I", data[10:14])[0]
    w,h = struct.unpack("<ii", data[18:26])
    rowsize = ((w*3)+3)//4*4
    px = {}
    for y in range(h):
        for x in range(w):
            i = off + y*rowsize + x*3
            b,g,r = data[i],data[i+1],data[i+2]
            px[(x,y)] = (r,g,b)
    return w,h,px

for name in ["star","mushroom","car"]:
    w,h,bpx = bmp_pixels(f"/home/hawk/KiddOS/assets/artwork/generated/carousel-{name}.bmp")
    png = Image.open(f"/home/hawk/KiddOS/assets/artwork/generated/carousel-{name}.png").convert("RGBA")
    ppx = png.load()
    # BMP bottom-up!
    diff_opaque = 0; magenta=0
    for y in range(h):
        for x in range(w):
            br,bg,bb = bpx[(x,y)]
            if (br,bg,bb)==(255,0,255):
                magenta+=1
                if ppx[x,y][3] != 0: diff_opaque+=1
            else:
                pr,pg,pb,pa = ppx[x,y]
                if pa==0 or (pr,pg,pb)!=(br,bg,bb): diff_opaque+=1
    print(name, w, h, "magenta px:", magenta, "mismatches:", diff_opaque)
