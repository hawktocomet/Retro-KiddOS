#pragma once

#include "kiddos/ui/element.hpp"
#include "kiddos/ui/font.hpp"

#include <functional>
#include <string>

namespace kiddos::ui {

struct ButtonStyle {
    Color normal{20, 34, 65, 255};
    Color focused{35, 83, 150, 255};
    Color pressed{18, 55, 105, 255};
    Color disabled{35, 39, 50, 255};
    Color border{69, 151, 255, 255};
    Color focused_border{125, 190, 255, 255};
    Color text{255, 255, 255, 255};
    Color disabled_text{150, 155, 165, 255};
};

class Button final : public Element {
public:
    explicit Button(std::string label = {});

    void set_label(std::string label);
    const std::string& label() const noexcept;

    void set_style(ButtonStyle style) noexcept;
    const ButtonStyle& style() const noexcept;

    void set_font(const Font* font) noexcept;
    const Font* font() const noexcept;

    void set_pressed(bool pressed) noexcept;
    bool pressed() const noexcept;

    void set_on_activate(std::function<void()> callback);
    bool activate();

private:
    std::string label_;
    ButtonStyle style_{};
    const Font* font_ = nullptr;
    std::function<void()> on_activate_;
    bool pressed_ = false;

    void draw(Renderer& renderer) override;
};

} // namespace kiddos::ui
#pragma once

#include <SDL.h>
#include <string>

namespace kiddos::ui {

class Texture final {
public:
    Texture() = default;
    ~Texture();

    Texture(const Texture&) = delete;
    Texture& operator=(const Texture&) = delete;

    Texture(Texture&& other) noexcept;
    Texture& operator=(Texture&& other) noexcept;

    // Loads an image file through SDL_image. With magenta_key enabled,
    // bright magenta (255, 0, 255) pixels become transparent.
    bool load(SDL_Renderer* renderer, const std::string& path,
              bool magenta_key = false);
    void reset() noexcept;
    bool valid() const noexcept;
    int width() const noexcept;
    int height() const noexcept;
    SDL_Texture* native() const noexcept;

private:
    SDL_Texture* texture_ = nullptr;
    int width_ = 0;
    int height_ = 0;
};

}
#pragma once

namespace kiddos::ui {

struct Point {
    int x = 0;
    int y = 0;
};

struct Rect {
    int x = 0;
    int y = 0;
    int w = 0;
    int h = 0;

    constexpr bool empty() const noexcept {
        return w <= 0 || h <= 0;
    }

    constexpr bool contains(Point p) const noexcept {
        return !empty() &&
               p.x >= x && p.y >= y &&
               p.x < x + w && p.y < y + h;
    }
};

} // namespace kiddos::ui

