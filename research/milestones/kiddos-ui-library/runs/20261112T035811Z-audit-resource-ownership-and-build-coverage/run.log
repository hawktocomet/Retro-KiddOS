    11	bool Screen::handle_text_input(const ::kiddos::TextInputEvent& event) {
    12	    switch (event.type) {
    13	    case ::kiddos::TextInputEventType::Text: return text_input_.insert_text(event.text);
    14	    case ::kiddos::TextInputEventType::Backspace: return text_input_.handle(TextInputKey::Backspace);
    15	    case ::kiddos::TextInputEventType::Delete: return text_input_.handle(TextInputKey::Delete);
    16	    case ::kiddos::TextInputEventType::Left: return text_input_.handle(TextInputKey::Left);
    17	    case ::kiddos::TextInputEventType::Right: return text_input_.handle(TextInputKey::Right);
    18	    case ::kiddos::TextInputEventType::Home: return text_input_.handle(TextInputKey::Home);
    19	    case ::kiddos::TextInputEventType::End: return text_input_.handle(TextInputKey::End);
    20	    }
    21	    return false;
    22	}
    23	}
