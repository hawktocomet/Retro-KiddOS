     3	#include <algorithm>
     4	#include <vector>
     5	
     6	namespace kiddos::ui {
     7	
     8	void StackLayout::apply(
     9	    Container& container,
    10	    Rect area,
    11	    Axis axis,
    12	    int gap,
    13	    Insets padding
    14	) noexcept {
    15	    container.set_bounds(area);
    16	
    17	    gap = std::max(0, gap);
    18	
    19	    const int left = std::clamp(padding.left, 0, area.w);
    20	    const int right = std::clamp(padding.right, 0, area.w - left);
    21	    const int top = std::clamp(padding.top, 0, area.h);
    22	    const int bottom = std::clamp(padding.bottom, 0, area.h - top);
    23	
    24	    const int content_x = area.x + left;
    25	    const int content_y = area.y + top;
    26	    const int content_w = std::max(0, area.w - left - right);
    27	    const int content_h = std::max(0, area.h - top - bottom);
    28	
    29	    std::vector<Element*> visible;
    30	
    31	    for (std::size_t i = 0; i < container.child_count(); ++i) {
    32	        Element* item = container.child(i);
    33	        if (item && item->visible()) {
    34	            visible.push_back(item);
    35	        }
    36	    }
    37	
    38	    if (visible.empty()) return;
    39	
    40	    const int main_size =
    41	        axis == Axis::Horizontal ? content_w : content_h;
    42	
    43	    const int cross_size =
    44	        axis == Axis::Horizontal ? content_h : content_w;
    45	
    46	    const int total_gaps =
    47	        gap * static_cast<int>(visible.size() - 1);
    48	
    49	    const int available = std::max(0, main_size - total_gaps);
    50	    const int base_size = available / static_cast<int>(visible.size());
    51	    const int remainder = available % static_cast<int>(visible.size());
    52	
    53	    int position = axis == Axis::Horizontal ? content_x : content_y;
    54	
    55	    for (std::size_t i = 0; i < visible.size(); ++i) {
    56	        const int item_size =
    57	            base_size + (static_cast<int>(i) < remainder ? 1 : 0);
    58	
    59	        if (axis == Axis::Horizontal) {
    60	            visible[i]->set_bounds({
    61	                position, content_y, item_size, cross_size
    62	            });
    63	        } else {
    64	            visible[i]->set_bounds({
    65	                content_x, position, cross_size, item_size
    66	            });
    67	        }
    68	
    69	        position += item_size + gap;
    70	    }
    71	}
    72	
    73	} // namespace kiddos::ui

