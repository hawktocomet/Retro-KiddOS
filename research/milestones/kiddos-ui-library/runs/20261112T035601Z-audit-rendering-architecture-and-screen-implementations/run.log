    17	Application::Application(Platform& platform)
    18	    : platform_(platform) {
    19	}
    20	
    21	int Application::run() {
    22	    IMG_Init(IMG_INIT_PNG);
    23	    if (!platform_.initialize()) {
    24	        platform_.shutdown();
    25	        IMG_Quit();
    26	        return 1;
    27	    }
    28	
    29	    // The UI renderer is a non-owning adapter around the platform renderer.
    30	    ui_renderer_.attach(platform_.native_renderer());
    31	    if (TTF_Init() != 0) {
    32	        IMG_Quit();
    33	        platform_.shutdown();
    34	        return 1;
    35	    }
    36	
    37	    app::SharedShell shell;
    38	    if (!shell.initialize(platform_.native_renderer())) {
    39	        TTF_Quit();
    40	        IMG_Quit();
    41	        platform_.shutdown();
    42	        return 1;
    43	    }
    44	
    45	    screens_.push(std::make_unique<app::HomeCarouselScreen>(
    46	        platform_.native_renderer()));
    47	
    48	    running_ = true;
    49	
    50	    while (running_) {
    51	        Action action = Action::None;
    52	
    53	        while (platform_.poll_action(action)) {
    54	            handle_action(action);
    55	            if (!running_) break;
    56	        }
    57	
    58	        if (running_) {
    59	            screens_.update(0.008f);
    60	            render(shell);
    61	            std::this_thread::sleep_for(std::chrono::milliseconds(8));
    62	        }
    63	    }
    64	
    65	    // Screens and their textures must be destroyed before the SDL renderer.
    66	    screens_.clear();
    67	    shell.reset();
    68	    TTF_Quit();
    69	    IMG_Quit();
    70	    platform_.shutdown();
    71	    return 0;
    72	}
    73	
    74	void Application::handle_action(Action action) {
    75	    if (action == Action::Quit) {
    76	        running_ = false;
    77	        return;
    78	    }
    79	
    80	    const auto ui_action = app::to_ui_action(action);
    81	    if (!ui_action) return;
    82	
    83	    // Back pops a child screen, but never removes the home screen.
    84	    if (*ui_action == ui::UIAction::Back) {
    85	        if (screens_.depth() > 1) {
    86	            screens_.handle_action(*ui_action);
    87	        }
    88	        return;
    89	    }
    90	
    91	    // Let the active screen handle its own controls first. This is how
    92	    // Confirm activates the Play button on Selected Game.
    93	    if (screens_.handle_action(*ui_action)) return;
    94	
    95	    auto* home = dynamic_cast<app::HomeCarouselScreen*>(screens_.current());
    96	    if (!home) return;
    97	
    98	    switch (*ui_action) {
    99	        case ui::UIAction::Left:
   100	            selected_game_ =
   101	                (selected_game_ + game_count_ - 1) % game_count_;
   102	            home->set_selected_game(selected_game_);
   103	            break;
   104	
   105	        case ui::UIAction::Right:
   106	            selected_game_ = (selected_game_ + 1) % game_count_;
   107	            home->set_selected_game(selected_game_);
   108	            break;
   109	
   110	        case ui::UIAction::Confirm:
   111	            screens_.push(std::make_unique<app::SelectedGameScreen>(
   112	                platform_.native_renderer(), selected_game_));
   113	            break;
   114	
   115	        case ui::UIAction::Up:
   116	        case ui::UIAction::Down:
   117	        case ui::UIAction::Back:
   118	            break;
   119	    }
   120	}
   121	
   122	void Application::render(app::SharedShell& shell) {
   123	    platform_.begin_frame();
   124	    screens_.render(ui_renderer_);
   125	
   126	    const bool selected_game =
   127	        dynamic_cast<app::SelectedGameScreen*>(screens_.current()) != nullptr;
   128	
   129	    shell.render_header();
   130	    shell.render_footer(selected_game);
   131	
   132	    platform_.present();
   133	}
   134	
   135	} // namespace kiddos

