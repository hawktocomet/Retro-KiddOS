===== SCREEN TESTS =====
#include "kiddos/app/selected_game_screen.hpp"

#include "kiddos/ui/button.hpp"
#include "kiddos/ui/image.hpp"
#include "kiddos/ui/label.hpp"
#include "kiddos/ui/screen_manager.hpp"

#include <SDL.h>
#include <SDL_image.h>

#include <cassert>
#include <unistd.h>

namespace {

void test_screen_structure_and_play_action() {
    kiddos::app::SelectedGameScreen screen(nullptr, 1);

    assert(screen.selected_game() == 1);
    assert(!screen.play_requested());
    assert(screen.root().child_count() == 3);

    auto* artwork = dynamic_cast<kiddos::ui::Image*>(
        screen.root().child(0));
    auto* play = dynamic_cast<kiddos::ui::Button*>(
        screen.root().child(1));
    auto* back = dynamic_cast<kiddos::ui::Label*>(
        screen.root().child(2));

    assert(artwork);
    assert(artwork->bounds().x == 90);
    assert(artwork->bounds().y == 42);
    assert(artwork->bounds().w == 540);
    assert(artwork->bounds().h == 450);

    assert(play);
    assert(play->focusable());
    assert(play->label() == "A  PLAY");
    assert(play->bounds().x == 190);
    assert(play->bounds().y == 525);

    assert(back);
    assert(back->text() == "B  BACK");
    assert(back->bounds().y == 655);

    kiddos::ui::ScreenManager manager;
    assert(manager.push(std::make_unique<kiddos::app::SelectedGameScreen>(
        nullptr, 1)));
    assert(manager.handle_action(kiddos::ui::UIAction::Confirm));

    auto* active =
        dynamic_cast<kiddos::app::SelectedGameScreen*>(manager.current());
    assert(active);
    assert(active->play_requested());
}

void test_invalid_game_index_is_safe() {
    kiddos::app::SelectedGameScreen negative(nullptr, -1);
    kiddos::app::SelectedGameScreen too_large(nullptr, 999);

    assert(negative.selected_game() == 0);
    assert(too_large.selected_game() == 0);
}

void test_artwork_renders() {
    assert(SDL_Init(0) == 0);
    IMG_Init(IMG_INIT_PNG);
    assert(chdir(KIDDOS_SOURCE_DIR) == 0);

    SDL_Surface* surface = SDL_CreateRGBSurfaceWithFormat(
        0, 720, 720, 32, SDL_PIXELFORMAT_RGBA32);
    assert(surface);

    SDL_Renderer* native = SDL_CreateSoftwareRenderer(surface);
    assert(native);

    {
        kiddos::ui::Renderer renderer(native);
        kiddos::app::SelectedGameScreen screen(native, 1);

        renderer.clear({8, 15, 35, 255});
        screen.render(renderer);

        // The artwork area is populated by the selected game's cover.
        const auto* bytes =
            static_cast<const unsigned char*>(surface->pixels);
        bool changed = false;
        for (int y = 42; y < 492 && !changed; ++y) {
            for (int x = 90; x < 630; ++x) {
                const auto* pixel = bytes + y * surface->pitch + x * 4;
                if (pixel[0] != 8 || pixel[1] != 15 || pixel[2] != 35) {
                    changed = true;
                    break;
                }
            }
        }
        assert(changed);
    }

    SDL_DestroyRenderer(native);
    SDL_FreeSurface(surface);
    IMG_Quit();
    SDL_Quit();
}

} // namespace

int main() {
    test_screen_structure_and_play_action();
    test_invalid_game_index_is_safe();
    test_artwork_renders();
    return 0;
}
