=== APPLICATION RENDER LOOP ===
#include "kiddos/app/application.hpp"

#include <chrono>
#include <thread>

namespace kiddos {

Application::Application(Platform& platform)
    : platform_(platform) {
}

int Application::run() {
    if (!platform_.initialize()) {
        platform_.shutdown();
        return 1;
    }

    running_ = true;

    while (running_) {
        Action action = Action::None;

        while (platform_.poll_action(action)) {
            handle_action(action);

            if (!running_) {
                break;
            }
        }

        if (running_) {
            render();
            std::this_thread::sleep_for(std::chrono::milliseconds(8));
        }
    }

    platform_.shutdown();
    return 0;
}

void Application::handle_action(Action action) {
    switch (action) {
        case Action::Quit:
            running_ = false;
            break;

        case Action::NavigateLeft:
            if (!action_screen_) {
                selected_game_ =
                    (selected_game_ + game_count_ - 1) % game_count_;
            }
            break;

        case Action::NavigateRight:
            if (!action_screen_) {
                selected_game_ =
                    (selected_game_ + 1) % game_count_;
            }
            break;

        case Action::NavigateUp:
            if (action_screen_ && selected_game_ == 1) {
                selected_action_ =
                    (selected_action_ + 1) % 2;
            }
            break;

        case Action::NavigateDown:
            if (action_screen_ && selected_game_ == 1) {
                selected_action_ =
                    (selected_action_ + 1) % 2;
            }
            break;

        case Action::Confirm:
            if (!action_screen_) {
                action_screen_ = true;
                selected_action_ = 0;
            }
            // Game launching is intentionally not implemented yet.
            break;

        case Action::Back:
            if (action_screen_) {
                action_screen_ = false;
                selected_action_ = 0;
            }
            break;

        case Action::None:
            break;
    }
}

void Application::render() {
    platform_.begin_frame();
    if (action_screen_) {
        // Game 1 is a temporary checkpoint demonstration fixture.
        platform_.draw_game_actions(
            selected_game_, selected_game_ == 1, selected_action_);
    } else {
        platform_.draw_carousel(selected_game_);
    }
    platform_.present();
}

} // namespace kiddos

=== CURRENT CAROUSEL DRAWING ===
void SDLPlatform::draw_carousel(int selected_index) {
    if (!renderer_) return;

    const int left = (selected_index + 2) % 3;
    const int right = (selected_index + 1) % 3;

    const Color side_fill{16, 41, 75, 255};
    const Color center_fill{18, 63, 117, 255};
    const Color center_border{36, 164, 255, 255};

    // Draw the smaller neighboring cards first, behind the main card.
    const SDL_Rect side_left{25, 250, 190, 175};
    const SDL_Rect side_right{505, 250, 190, 175};

    rounded_fill(renderer_, side_left, 24, side_fill);
    rounded_outline(renderer_, side_left, 24,
                    {55, 105, 165, 190});
    draw_art(renderer_, left,
             {side_left.x + 55, side_left.y + 42, 80, 90}, 180);

    rounded_fill(renderer_, side_right, 24, side_fill);
    rounded_outline(renderer_, side_right, 24,
                    {55, 105, 165, 190});
    draw_art(renderer_, right,
             {side_right.x + 55, side_right.y + 42, 80, 90}, 180);

    // Main card is larger and drawn last so it overlaps both neighbors.
    const SDL_Rect center{145, 135, 430, 370};
    rounded_fill(renderer_, center, 30, center_fill);
    rounded_outline(renderer_, center, 30, center_border);
    rounded_outline(renderer_,
                    {center.x - 3, center.y - 3,
                     center.w + 6, center.h + 6},
                    32, {36, 164, 255, 150});

    // Artwork always follows the actual selected game.
    draw_art(renderer_, selected_index,
             {center.x + 115, center.y + 70, 200, 205}, 255);

    // Game title belongs below the main card; no SELECTED badge.
    if (carousel_title_texture && selected_index == 1) {
        SDL_Rect title{220, 525, 280, 42};
        SDL_RenderCopy(renderer_, carousel_title_texture,
                       nullptr, &title);
    }

    draw_status(renderer_);
}


namespace {

void draw_action_label(SDL_Renderer* r, int index,
                       int x, int y) {
    if (index < 0 || index >= static_cast<int>(action_label_textures.size())) return;
    SDL_Texture* texture = action_label_textures[static_cast<std::size_t>(index)];
    if (!texture) return;

    SDL_Rect destination{x, y, 350, 72};
    SDL_RenderCopy(r, texture, nullptr, &destination);
}

void draw_play_symbol(SDL_Renderer* r, int x, int y) {
    triangle(r, x, y - 34, x, y + 34,
             x + 58, y, {220, 237, 255, 255});
}

void draw_resume_symbol(SDL_Renderer* r, int x, int y) {
    circle(r, x, y, 30, {220, 237, 255, 255});
    circle(r, x, y, 19, {15, 29, 62, 255});
    triangle(r, x + 10, y - 36,
             x + 42, y - 12,
             x + 7, y - 8,
             {220, 237, 255, 255});
}

void draw_restart_symbol(SDL_Renderer* r, int x, int y) {
    circle(r, x, y, 29, {220, 237, 255, 255});
    circle(r, x, y, 18, {15, 29, 62, 255});
    triangle(r, x - 27, y - 30,
             x + 10, y - 31,
             x - 14, y + 2,
             {220, 237, 255, 255});
}

} // namespace


=== SCREEN AND SCREEN MANAGER ===
#pragma once
#include "kiddos/ui/container.hpp"
#include "kiddos/ui/controller.hpp"
#include "kiddos/ui/text_input_interaction.hpp"
#include "kiddos/platform/text_input_event.hpp"

namespace kiddos::ui {
class Screen {
public:
    Screen() noexcept;
    virtual ~Screen() = default;
    Screen(const Screen&) = delete;
    Screen& operator=(const Screen&) = delete;
    Container& root() noexcept;
    FocusManager& focus() noexcept;
    virtual void on_enter() {}
    virtual void on_exit() {}
    virtual void on_suspend() {}
    virtual void on_resume() {}
    virtual void update(float) {}
    virtual void render(Renderer& renderer);
    bool handle_action(UIAction action);
    bool handle_text_input(const ::kiddos::TextInputEvent& event);
private:
    Container root_;
    FocusManager focus_;
    ControllerInteraction controller_;
    TextInputInteraction text_input_;
};
}
#pragma once
#include "kiddos/ui/screen.hpp"
#include <memory>
#include <vector>
namespace kiddos::ui {
class ScreenManager final {
public:
    ~ScreenManager();
    ScreenManager() = default;
    ScreenManager(const ScreenManager&) = delete;
    ScreenManager& operator=(const ScreenManager&) = delete;
    bool push(std::unique_ptr<Screen> screen);
    bool pop();
    bool replace(std::unique_ptr<Screen> screen);
    void clear() noexcept;
    Screen* current() noexcept;
    const Screen* current() const noexcept;
    std::size_t depth() const noexcept;
    void update(float delta_seconds);
    void render(Renderer& renderer);
    bool handle_action(UIAction action);
    bool handle_text_input(const ::kiddos::TextInputEvent& event);
private:
    std::vector<std::unique_ptr<Screen>> stack_;
};
}
#include "kiddos/ui/screen.hpp"
namespace kiddos::ui {
Screen::Screen() noexcept : focus_(root_), controller_(focus_), text_input_(focus_) {}
Container& Screen::root() noexcept { return root_; }
FocusManager& Screen::focus() noexcept { return focus_; }
void Screen::render(Renderer& renderer) { root_.render(renderer); }
bool Screen::handle_action(UIAction action) {
    if (!focus_.focused()) focus_.focus_first();
    return controller_.handle(action);
}
bool Screen::handle_text_input(const ::kiddos::TextInputEvent& event) {
    switch (event.type) {
    case ::kiddos::TextInputEventType::Text: return text_input_.insert_text(event.text);
    case ::kiddos::TextInputEventType::Backspace: return text_input_.handle(TextInputKey::Backspace);
    case ::kiddos::TextInputEventType::Delete: return text_input_.handle(TextInputKey::Delete);
    case ::kiddos::TextInputEventType::Left: return text_input_.handle(TextInputKey::Left);
    case ::kiddos::TextInputEventType::Right: return text_input_.handle(TextInputKey::Right);
    case ::kiddos::TextInputEventType::Home: return text_input_.handle(TextInputKey::Home);
    case ::kiddos::TextInputEventType::End: return text_input_.handle(TextInputKey::End);
    }
    return false;
}
}
#include "kiddos/ui/screen_manager.hpp"
namespace kiddos::ui {
ScreenManager::~ScreenManager() { clear(); }
bool ScreenManager::push(std::unique_ptr<Screen> screen) {
    if (!screen) return false;
    if (auto* active = current()) active->on_suspend();
    auto* next = screen.get();
    stack_.push_back(std::move(screen));
    next->on_enter();
    next->focus().focus_first();
    return true;
}
bool ScreenManager::pop() {
    if (stack_.empty()) return false;
    stack_.back()->on_exit();
    stack_.pop_back();
    if (auto* active = current()) { active->on_resume(); active->focus().focus_first(); }
    return true;
}
bool ScreenManager::replace(std::unique_ptr<Screen> screen) {
    if (!screen) return false;
    if (auto* active = current()) { active->on_exit(); stack_.pop_back(); }
    auto* next = screen.get();
    stack_.push_back(std::move(screen));
    next->on_enter();
    next->focus().focus_first();
    return true;
}
void ScreenManager::clear() noexcept {
    while (!stack_.empty()) { stack_.back()->on_exit(); stack_.pop_back(); }
}
Screen* ScreenManager::current() noexcept { return stack_.empty() ? nullptr : stack_.back().get(); }
const Screen* ScreenManager::current() const noexcept { return stack_.empty() ? nullptr : stack_.back().get(); }
std::size_t ScreenManager::depth() const noexcept { return stack_.size(); }
void ScreenManager::update(float dt) { if (auto* s=current()) s->update(dt); }
void ScreenManager::render(Renderer& r) { if (auto* s=current()) s->render(r); }
bool ScreenManager::handle_action(UIAction a) {
    if (a == UIAction::Back) return pop();
    auto* s=current(); return s ? s->handle_action(a) : false;
}
bool ScreenManager::handle_text_input(const ::kiddos::TextInputEvent& e) {
    auto* s=current(); return s ? s->handle_text_input(e) : false;
}
}

