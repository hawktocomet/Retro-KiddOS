     6	namespace kiddos::ui {
     7	
     8	Texture::~Texture() { reset(); }
     9	
    10	Texture::Texture(Texture&& other) noexcept
    11	    : texture_(std::exchange(other.texture_, nullptr)),
    12	      width_(std::exchange(other.width_, 0)),
    13	      height_(std::exchange(other.height_, 0)) {}
    14	
    15	Texture& Texture::operator=(Texture&& other) noexcept {
    16	    if (this != &other) {
    17	        reset();
    18	        texture_ = std::exchange(other.texture_, nullptr);
    19	        width_ = std::exchange(other.width_, 0);
    20	        height_ = std::exchange(other.height_, 0);
    21	    }
    22	    return *this;
    23	}
    24	
    25	bool Texture::load(
    26	    SDL_Renderer* renderer,
    27	    const std::string& path,
    28	    bool magenta_key
    29	) {
    30	    reset();
    31	    if (!renderer || path.empty()) return false;
    32	
    33	    SDL_Surface* surface = IMG_Load(path.c_str());
    34	    if (!surface) return false;
    35	
    36	    if (magenta_key) {
    37	        const Uint32 key = SDL_MapRGB(surface->format, 255, 0, 255);
    38	        SDL_SetColorKey(surface, SDL_TRUE, key);
    39	    }
    40	
    41	    SDL_Texture* loaded = SDL_CreateTextureFromSurface(renderer, surface);
    42	    const int w = surface->w;
    43	    const int h = surface->h;
    44	    SDL_FreeSurface(surface);
    45	
    46	    if (!loaded) return false;
    47	
    48	    SDL_SetTextureBlendMode(loaded, SDL_BLENDMODE_BLEND);
    49	
    50	    texture_ = loaded;
    51	    width_ = w;
    52	    height_ = h;
    53	    return true;
    54	}
    55	
    56	void Texture::reset() noexcept {
    57	    if (texture_) SDL_DestroyTexture(texture_);
    58	    texture_ = nullptr;
    59	    width_ = 0;
    60	    height_ = 0;
    61	}
    62	
    63	bool Texture::valid() const noexcept { return texture_ != nullptr; }
    64	int Texture::width() const noexcept { return width_; }
    65	int Texture::height() const noexcept { return height_; }
    66	SDL_Texture* Texture::native() const noexcept { return texture_; }
    67	
    68	}
