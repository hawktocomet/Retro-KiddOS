namespace {

void draw_action_label(SDL_Renderer* r, int index,
                       int x, int y) {
    if (index < 0 || index >= static_cast<int>(action_label_textures.size())) return;
    SDL_Texture* texture = action_label_textures[static_cast<std::size_t>(index)];
    if (!texture) return;

    SDL_Rect destination{x, y, 350, 72};
    SDL_RenderCopy(r, texture, nullptr, &destination);
}

// Conventional play/resume symbol: a solid right-pointing triangle
// centered on (x, y). Play and Resume share this geometry on purpose:
// a filled play triangle is the conventional symbol for both actions,
// and the text label next to it names the action.
void draw_play_symbol(SDL_Renderer* r, int x, int y) {
    triangle(r, x - 18, y - 32, x - 18, y + 32, x + 30, y,
             {220, 237, 255, 255});
}

void draw_resume_symbol(SDL_Renderer* r, int x, int y) {
    draw_play_symbol(r, x, y);
}

// Conventional circular restart arrow: a thick ring open across the top
// with a solid arrowhead continuing the ring clockwise. The ring band is
// stamped as tightly overlapping filled disks along the arc so it renders
// as one solid, evenly weighted band. Centered on (x, y).
void draw_restart_symbol(SDL_Renderer* r, int x, int y) {
    const Color icon{220, 237, 255, 255};
    constexpr double kPi = 3.14159265358979323846;

    // The band spans radii 21..27 (7 px thick, matching the solid
    // arrowhead's stroke weight) and stays open across the top between
    // 250 and 290 degrees. Stamps are spaced ~1.7 px along the arc so
    // neighboring disks always overlap.
    for (int step = 0; step <= 80; ++step) {
        const double radians =
            (290.0 + step * (320.0 / 80.0)) * kPi / 180.0;
        circle(r,
               x + static_cast<int>(std::lround(24.0 * std::cos(radians))),
               y + static_cast<int>(std::lround(24.0 * std::sin(radians))),
               3, icon);
    }

    // Arrowhead at the ring's upper-right end, pointing clockwise.
    triangle(r, x + 27, y - 16,
             x + 4, y - 10,
             x + 13, y - 35,
             icon);
}

} // namespace

void SDLPlatform::draw_game_actions(
    int selected_index, bool has_checkpoint, int selected_action) {

    if (!renderer_) return;

    draw_status(renderer_);

    // Keep the selected game's artwork prominent.
    draw_card(renderer_, selected_index,
              {235, 48, 250, 310}, true);

    const int action_count = has_checkpoint ? 2 : 1;
    const int box_height = 112;
    const int gap = 17;
    const int total_height =
        action_count * box_height + (action_count - 1) * gap;
    const int start_y = 405 + (210 - total_height) / 2;

    for (int i = 0; i < action_count; ++i) {
        const int y = start_y + i * (box_height + gap);
        const bool selected = i == selected_action;

        SDL_Rect box{65, y, 590, box_height};

        rounded_fill(renderer_, box, 22,
                     selected
                       ? Color{24, 69, 139, 255}
                       : Color{16, 30, 65, 255});

        rounded_outline(renderer_, box, 22,
                        selected
                          ? Color{75, 165, 255, 255}
                          : Color{65, 93, 145, 190});

        const int symbol_x = 145;
        const int symbol_y = y + box_height / 2;

        if (!has_checkpoint || i == 0) {
            if (has_checkpoint) {
                draw_resume_symbol(renderer_, symbol_x, symbol_y);
                draw_action_label(renderer_, 1, 230, y + 20);
            } else {
                draw_play_symbol(renderer_, symbol_x, symbol_y);
                draw_action_label(renderer_, 0, 230, y + 20);
            }
        } else {
            draw_restart_symbol(renderer_, symbol_x, symbol_y);
            draw_action_label(renderer_, 2, 230, y + 20);
        }

        if (selected) {
            rounded_outline(renderer_,
                            {box.x - 4, box.y - 4,
                             box.w + 8, box.h + 8},
                            26, {43, 126, 231, 180});
        }
    }
}



