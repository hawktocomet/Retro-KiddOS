import struct
def get(name,x,y):
    p=f"assets/artwork/generated/{name}.bmp"
    data=open(p,'rb').read()
    off=struct.unpack('<I',data[10:14])[0]
    w,h=struct.unpack('<ii',data[18:26])
    row=((w*3+3)//4)*4
    yy=y if h>0 else abs(h)-1-y
    base=off+yy*row
    b,g,r=data[base+x*3:base+x*3+3]
    return (r,g,b)
# dest (360,307) in center art {260,205,200,205}
# mushroom 180x160: src=(99,79); star 160x160: src=(80,79)
print("mushroom(99,79)", get("carousel-mushroom",99,79))
print("star(80,79)", get("carousel-star",80,79))
EOF
