+    const Color icon{220, 237, 255, 255};
+
+    // The ring is drawn as concentric arc passes (stroke weight 7) and
+    // stays open across the top between 250 and 290 degrees.
+    for (int radius = 21; radius <= 27; ++radius) {
+        draw_arc(r, x, y, radius, 290.0, 610.0, icon);
+    }
+
+    // Arrowhead at the ring's upper-right end, pointing clockwise.
+    triangle(r, x + 27, y - 16,
+             x + 4, y - 10,
+             x + 13, y - 35,
+             icon);
 }
 
