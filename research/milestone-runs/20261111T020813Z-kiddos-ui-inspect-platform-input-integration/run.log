=== Platform interface ===
#pragma once

#include "kiddos/core/action.hpp"

namespace kiddos {

class Platform {
public:
    virtual ~Platform() = default;

    virtual bool initialize() = 0;
    virtual bool poll_action(Action& action) = 0;
    virtual void begin_frame() = 0;
    virtual void draw_carousel(int selected_index) = 0;
    virtual void draw_game_actions(int selected_index, bool has_checkpoint, int selected_action) = 0;
    virtual void present() = 0;
    virtual void shutdown() = 0;
};

} // namespace kiddos
=== Application event loop ===
#include "kiddos/app/application.hpp"

#include <chrono>
#include <thread>

namespace kiddos {

Application::Application(Platform& platform)
    : platform_(platform) {
}

int Application::run() {
    if (!platform_.initialize()) {
        platform_.shutdown();
        return 1;
    }

    running_ = true;

    while (running_) {
        Action action = Action::None;

        while (platform_.poll_action(action)) {
            handle_action(action);

            if (!running_) {
                break;
            }
        }

        if (running_) {
            render();
            std::this_thread::sleep_for(std::chrono::milliseconds(8));
        }
    }

    platform_.shutdown();
    return 0;
}

void Application::handle_action(Action action) {
    switch (action) {
        case Action::Quit:
            running_ = false;
            break;

        case Action::NavigateLeft:
            if (!action_screen_) {
                selected_game_ =
                    (selected_game_ + game_count_ - 1) % game_count_;
            }
            break;

        case Action::NavigateRight:
            if (!action_screen_) {
                selected_game_ =
                    (selected_game_ + 1) % game_count_;
            }
            break;

        case Action::NavigateUp:
            if (action_screen_ && selected_game_ == 1) {
                selected_action_ =
                    (selected_action_ + 1) % 2;
            }
            break;

        case Action::NavigateDown:
            if (action_screen_ && selected_game_ == 1) {
                selected_action_ =
                    (selected_action_ + 1) % 2;
            }
            break;

        case Action::Confirm:
            if (!action_screen_) {
                action_screen_ = true;
                selected_action_ = 0;
            }
            // Game launching is intentionally not implemented yet.
            break;

        case Action::Back:
            if (action_screen_) {
                action_screen_ = false;
                selected_action_ = 0;
            }
            break;

        case Action::None:
            break;
    }
}

void Application::render() {
    platform_.begin_frame();
    if (action_screen_) {
        // Game 1 is a temporary checkpoint demonstration fixture.
        platform_.draw_game_actions(
            selected_game_, selected_game_ == 1, selected_action_);
    } else {
        platform_.draw_carousel(selected_game_);
    }
    platform_.present();
}

} // namespace kiddos
=== Controller interaction ===
#pragma once

#include "kiddos/ui/button.hpp"
#include "kiddos/ui/focus.hpp"

namespace kiddos::ui {

enum class UIAction {
    Left,
    Right,
    Up,
    Down,
    Confirm,
    Back
};

class ControllerInteraction final {
public:
    explicit ControllerInteraction(FocusManager& focus) noexcept;

    bool handle(UIAction action);
    bool cancel() noexcept;

private:
    FocusManager& focus_;
};

} // namespace kiddos::ui
#include "kiddos/ui/controller.hpp"
#include "kiddos/ui/toggle.hpp"
#include "kiddos/ui/checkbox.hpp"
#include "kiddos/ui/radio_group.hpp"
#include "kiddos/ui/select.hpp"
#include "kiddos/ui/slider.hpp"
#include "kiddos/ui/list_view.hpp"

namespace kiddos::ui {

ControllerInteraction::ControllerInteraction(FocusManager& focus) noexcept
    : focus_(focus) {
}

bool ControllerInteraction::handle(UIAction action) {
    Element* focused = focus_.focused();

    switch (action) {
        case UIAction::Left:
            if (auto* radio = dynamic_cast<RadioGroup*>(focused))
                return radio->select_previous();
            if (auto* select = dynamic_cast<Select*>(focused))
                return select->select_previous();
            if (auto* slider = dynamic_cast<Slider*>(focused))
                return slider->adjust(-1);
            return focus_.move(Direction::Left);

        case UIAction::Right:
            if (auto* radio = dynamic_cast<RadioGroup*>(focused))
                return radio->select_next();
            if (auto* select = dynamic_cast<Select*>(focused))
                return select->select_next();
            if (auto* slider = dynamic_cast<Slider*>(focused))
                return slider->adjust(1);
            return focus_.move(Direction::Right);

        case UIAction::Up:
            if (auto* radio = dynamic_cast<RadioGroup*>(focused))
                return radio->select_previous();
            if (auto* list = dynamic_cast<ListView*>(focused))
                return list->move_selection(-1);
            return focus_.move(Direction::Up);

        case UIAction::Down:
            if (auto* radio = dynamic_cast<RadioGroup*>(focused))
                return radio->select_next();
            if (auto* list = dynamic_cast<ListView*>(focused))
                return list->move_selection(1);
            return focus_.move(Direction::Down);

        case UIAction::Confirm:
            if (auto* button = dynamic_cast<Button*>(focused))
                return button->activate();
            if (auto* toggle = dynamic_cast<Toggle*>(focused))
                return toggle->toggle();
            if (auto* checkbox = dynamic_cast<Checkbox*>(focused))
                return checkbox->toggle();
            if (auto* list = dynamic_cast<ListView*>(focused))
                return list->activate_selected();
            return false;

        case UIAction::Back:
            return cancel();
    }

    return false;
}

bool ControllerInteraction::cancel() noexcept {
    return false;
}

} // namespace kiddos::ui
=== Focus manager interface ===
#pragma once

#include "kiddos/ui/container.hpp"

namespace kiddos::ui {

enum class Direction {
    Left,
    Right,
    Up,
    Down
};

class FocusManager final {
public:
    explicit FocusManager(Container& root) noexcept;

    Element* focused() const noexcept;
    bool focus_first() noexcept;
    bool move(Direction direction) noexcept;
    void clear() noexcept;

private:
    Container& root_;
    Element* focused_ = nullptr;

    bool eligible(const Element* element) const noexcept;
};

} // namespace kiddos::ui
=== Element focus and enabled API ===
#pragma once

#include "kiddos/ui/geometry.hpp"
#include "kiddos/ui/renderer.hpp"

namespace kiddos::ui {

class Element {
public:
    virtual ~Element() = default;

    void set_bounds(Rect bounds) noexcept { bounds_ = bounds; }
    Rect bounds() const noexcept { return bounds_; }

    void set_visible(bool visible) noexcept { visible_ = visible; }
    bool visible() const noexcept { return visible_; }

    void set_enabled(bool enabled) noexcept { enabled_ = enabled; }
    bool enabled() const noexcept { return enabled_; }

    void set_focusable(bool focusable) noexcept {
        focusable_ = focusable;
    }

    bool focusable() const noexcept { return focusable_; }

    void set_focused(bool focused) noexcept { focused_ = focused; }
    bool focused() const noexcept { return focused_; }

    void render(Renderer& renderer) {
        if (visible_) draw(renderer);
    }

protected:
    virtual void draw(Renderer& renderer) = 0;

private:
    Rect bounds_{};
    bool visible_ = true;
    bool enabled_ = true;
    bool focusable_ = false;
    bool focused_ = false;
};

} // namespace kiddos::ui
