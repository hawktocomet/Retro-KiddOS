     5	namespace kiddos::ui {
     6	class ScreenManager final {
     7	public:
     8	    ~ScreenManager();
     9	    ScreenManager() = default;
    10	    ScreenManager(const ScreenManager&) = delete;
    11	    ScreenManager& operator=(const ScreenManager&) = delete;
    12	    bool push(std::unique_ptr<Screen> screen);
    13	    bool pop();
    14	    bool replace(std::unique_ptr<Screen> screen);
    15	    void clear() noexcept;
    16	    Screen* current() noexcept;
    17	    const Screen* current() const noexcept;
    18	    std::size_t depth() const noexcept;
    19	    void update(float delta_seconds);
    20	    void render(Renderer& renderer);
    21	    bool handle_action(UIAction action);
    22	    bool handle_text_input(const ::kiddos::TextInputEvent& event);
    23	private:
    24	    std::vector<std::unique_ptr<Screen>> stack_;
    25	};
    26	}
     1	#include "kiddos/ui/screen_manager.hpp"
     2	namespace kiddos::ui {
     3	ScreenManager::~ScreenManager() { clear(); }
     4	bool ScreenManager::push(std::unique_ptr<Screen> screen) {
     5	    if (!screen) return false;
     6	    if (auto* active = current()) active->on_suspend();
     7	    auto* next = screen.get();
     8	    stack_.push_back(std::move(screen));
     9	    next->on_enter();
    10	    next->focus().focus_first();
    11	    return true;
    12	}
    13	bool ScreenManager::pop() {
    14	    if (stack_.empty()) return false;
    15	    stack_.back()->on_exit();
    16	    stack_.pop_back();
    17	    if (auto* active = current()) { active->on_resume(); active->focus().focus_first(); }
    18	    return true;
    19	}
    20	bool ScreenManager::replace(std::unique_ptr<Screen> screen) {
    21	    if (!screen) return false;
    22	    if (auto* active = current()) { active->on_exit(); stack_.pop_back(); }
    23	    auto* next = screen.get();
    24	    stack_.push_back(std::move(screen));
    25	    next->on_enter();
    26	    next->focus().focus_first();
    27	    return true;
    28	}
    29	void ScreenManager::clear() noexcept {
    30	    while (!stack_.empty()) { stack_.back()->on_exit(); stack_.pop_back(); }
    31	}
    32	Screen* ScreenManager::current() noexcept { return stack_.empty() ? nullptr : stack_.back().get(); }
    33	const Screen* ScreenManager::current() const noexcept { return stack_.empty() ? nullptr : stack_.back().get(); }
    34	std::size_t ScreenManager::depth() const noexcept { return stack_.size(); }
    35	void ScreenManager::update(float dt) { if (auto* s=current()) s->update(dt); }
    36	void ScreenManager::render(Renderer& r) { if (auto* s=current()) s->render(r); }
    37	bool ScreenManager::handle_action(UIAction a) {
    38	    if (a == UIAction::Back) return pop();
    39	    auto* s=current(); return s ? s->handle_action(a) : false;
    40	}
    41	bool ScreenManager::handle_text_input(const ::kiddos::TextInputEvent& e) {
    42	    auto* s=current(); return s ? s->handle_text_input(e) : false;
    43	}
    44	}
