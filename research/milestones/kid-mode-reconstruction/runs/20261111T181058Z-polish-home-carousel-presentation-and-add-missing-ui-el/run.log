    data = open(path,'rb').read()
    off = struct.unpack("<I", data[10:14])[0]
    w,h = struct.unpack("<ii", data[18:26])
    rowsize = ((w*3)+3)//4*4
    img = Image.new("RGBA",(w,h),(255,0,255,255))
    px = img.load()
    for y in range(h):
        for x in range(w):
            i = off + (h-1-y)*rowsize + x*3
            b,g,r = data[i],data[i+1],data[i+2]
            if (r,g,b)!=(255,0,255):
                px[x,y] = (r,g,b,255)
    return img
