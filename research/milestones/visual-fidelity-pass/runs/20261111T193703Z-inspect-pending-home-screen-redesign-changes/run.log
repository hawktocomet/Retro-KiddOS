+    // A simple clockwise restart arrow with a consistent line weight.
+    constexpr double pi = 3.14159265358979323846;
+    constexpr int segments = 32;
+    const Color icon{220, 237, 255, 255};
+
+    color(r, icon);
+
+    for (int stroke = -1; stroke <= 1; ++stroke) {
+        const double radius = 24.0 + stroke;
+        int previous_x = x + static_cast<int>(std::lround(
+            radius * std::cos(135.0 * pi / 180.0)));
+        int previous_y = y + static_cast<int>(std::lround(
+            radius * std::sin(135.0 * pi / 180.0)));
+
+        for (int step = 1; step <= segments; ++step) {
+            const double angle = (135.0 + 270.0 * step / segments)
+                                 * pi / 180.0;
+            const int next_x = x + static_cast<int>(
+                std::lround(radius * std::cos(angle)));
+            const int next_y = y + static_cast<int>(
+                std::lround(radius * std::sin(angle)));
+            SDL_RenderDrawLine(r, previous_x, previous_y, next_x, next_y);
+            previous_x = next_x;
+            previous_y = next_y;
+        }
+    }
+
+    // Arrowhead at the upper-right end of the circular stroke.
+    triangle(r, x + 31, y - 21,
+             x + 8, y - 29,
+             x + 22, y - 5, icon);
 }
 
