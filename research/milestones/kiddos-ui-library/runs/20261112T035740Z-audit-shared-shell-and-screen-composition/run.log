    55	void Button::draw(Renderer& renderer) {
    56	    const Rect rect = bounds();
    57	    if (rect.empty()) return;
    58	
    59	    Color fill = style_.normal;
    60	    Color border = style_.border;
    61	    Color text_color = style_.text;
    62	
    63	    if (!enabled()) {
    64	        fill = style_.disabled;
    65	        text_color = style_.disabled_text;
    66	    } else if (pressed_) {
    67	        fill = style_.pressed;
    68	    } else if (focused()) {
    69	        fill = style_.focused;
    70	        border = style_.focused_border;
    71	    }
    72	
    73	    renderer.fill_rect(rect, fill);
    74	    renderer.outline_rect(rect, border);
    75	
    76	    if (font_ && font_->valid() && !label_.empty()) {
    77	        TextRenderer text(renderer);
    78	        const int horizontal_padding = 16;
    79	        const int vertical_padding = 8;
    80	        Rect text_area{
    81	            rect.x + horizontal_padding,
    82	            rect.y + vertical_padding,
    83	            rect.w - horizontal_padding * 2,
    84	            rect.h - vertical_padding * 2
    85	        };
    86	        if (!text_area.empty()) {
    87	            text.draw_centered(label_, *font_, text_area, text_color);
    88	        }
    89	    }
    90	}
