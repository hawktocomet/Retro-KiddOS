=== TEXTURE LOADER ===
#include "kiddos/ui/texture.hpp"

#include <SDL_image.h>
#include <utility>

namespace kiddos::ui {

Texture::~Texture() { reset(); }

Texture::Texture(Texture&& other) noexcept
    : texture_(std::exchange(other.texture_, nullptr)),
      width_(std::exchange(other.width_, 0)),
      height_(std::exchange(other.height_, 0)) {}

Texture& Texture::operator=(Texture&& other) noexcept {
    if (this != &other) {
        reset();
        texture_ = std::exchange(other.texture_, nullptr);
        width_ = std::exchange(other.width_, 0);
        height_ = std::exchange(other.height_, 0);
    }
    return *this;
}

bool Texture::load(
    SDL_Renderer* renderer,
    const std::string& path,
    bool magenta_key
) {
    reset();
    if (!renderer || path.empty()) return false;

    SDL_Surface* surface = IMG_Load(path.c_str());
    if (!surface) return false;

    if (magenta_key) {
        const Uint32 key = SDL_MapRGB(surface->format, 255, 0, 255);
        SDL_SetColorKey(surface, SDL_TRUE, key);
    }

    SDL_Texture* loaded = SDL_CreateTextureFromSurface(renderer, surface);
    const int w = surface->w;
    const int h = surface->h;
    SDL_FreeSurface(surface);

    if (!loaded) return false;

    SDL_SetTextureBlendMode(loaded, SDL_BLENDMODE_BLEND);

    texture_ = loaded;
    width_ = w;
    height_ = h;
    return true;
}

void Texture::reset() noexcept {
    if (texture_) SDL_DestroyTexture(texture_);
    texture_ = nullptr;
    width_ = 0;
    height_ = 0;
}

bool Texture::valid() const noexcept { return texture_ != nullptr; }
int Texture::width() const noexcept { return width_; }
int Texture::height() const noexcept { return height_; }
SDL_Texture* Texture::native() const noexcept { return texture_; }

}
#pragma once

#include <SDL.h>
#include <string>

namespace kiddos::ui {

class Texture final {
public:
    Texture() = default;
    ~Texture();

    Texture(const Texture&) = delete;
    Texture& operator=(const Texture&) = delete;

    Texture(Texture&& other) noexcept;
    Texture& operator=(Texture&& other) noexcept;

    // Loads an image file through SDL_image. With magenta_key enabled,
    // bright magenta (255, 0, 255) pixels become transparent.
    bool load(SDL_Renderer* renderer, const std::string& path,
              bool magenta_key = false);
    void reset() noexcept;
    bool valid() const noexcept;
    int width() const noexcept;
    int height() const noexcept;
    SDL_Texture* native() const noexcept;

private:
    SDL_Texture* texture_ = nullptr;
    int width_ = 0;
    int height_ = 0;
};

}

