--- Application source ---
#include "kiddos/app/application.hpp"

#include <chrono>
#include <thread>

namespace kiddos {

Application::Application(Platform& platform)
    : platform_(platform) {
}

int Application::run() {
    if (!platform_.initialize()) {
        platform_.shutdown();
        return 1;
    }

    running_ = true;

    while (running_) {
        Action action = Action::None;

        while (platform_.poll_action(action)) {
            handle_action(action);

            if (!running_) {
                break;
            }
        }

        if (running_) {
            render();
            std::this_thread::sleep_for(std::chrono::milliseconds(8));
        }
    }

    platform_.shutdown();
    return 0;
}

void Application::handle_action(Action action) {
    switch (action) {
        case Action::Quit:
            running_ = false;
            break;

        case Action::NavigateLeft:
            selected_game_ =
                (selected_game_ + game_count_ - 1) % game_count_;
            break;

        case Action::NavigateRight:
            selected_game_ =
                (selected_game_ + 1) % game_count_;
            break;

        case Action::None:
        case Action::NavigateUp:
        case Action::NavigateDown:
        case Action::Confirm:
        case Action::Back:
            break;
    }
}

void Application::render() {
    platform_.begin_frame();
    platform_.draw_carousel(selected_game_);
    platform_.present();
}

} // namespace kiddos
--- Platform interface ---
#pragma once

#include "kiddos/core/action.hpp"

namespace kiddos {

class Platform {
public:
    virtual ~Platform() = default;

    virtual bool initialize() = 0;
    virtual bool poll_action(Action& action) = 0;
    virtual void begin_frame() = 0;
    virtual void draw_carousel(int selected_index) = 0;
    virtual void present() = 0;
    virtual void shutdown() = 0;
};

} // namespace kiddos
--- SDL platform header ---
#pragma once

#include "kiddos/platform/platform.hpp"

#include <SDL.h>

namespace kiddos {

class SDLPlatform final : public Platform {
public:
    SDLPlatform() = default;
    ~SDLPlatform() override;

    bool initialize() override;
    bool poll_action(Action& action) override;
    void begin_frame() override;
    void draw_carousel(int selected_index) override;
    void present() override;
    void shutdown() override;

private:
    SDL_Window* window_ = nullptr;
    SDL_Renderer* renderer_ = nullptr;
    SDL_GameController* controller_ = nullptr;
    SDL_JoystickID controller_instance_ = -1;
    bool initialized_ = false;

    void open_controller(int device_index);
    void close_controller();
    static Action map_key(SDL_Keycode key);
    static Action map_controller_button(Uint8 button);
};

} // namespace kiddos

