+// Draws a circular arc as short connected line segments, used for the
+// restart arrow's ring.
+void draw_arc(SDL_Renderer* r, int cx, int cy, int radius,
+              double start_degrees, double end_degrees, Color c) {
+    constexpr double kPi = 3.14159265358979323846;
+
+    const int steps = std::max(2, radius * 2);
+    const double delta = (end_degrees - start_degrees) / steps;
+
+    int previous_x = cx + radius;
+    int previous_y = cy;
+    for (int step = 1; step <= steps; ++step) {
+        const double radians =
+            (start_degrees + delta * step) * kPi / 180.0;
+        const int point_x = cx + static_cast<int>(
+            std::lround(radius * std::cos(radians)));
+        const int point_y = cy + static_cast<int>(
+            std::lround(radius * std::sin(radians)));
+        SDL_RenderDrawLine(r, previous_x, previous_y, point_x, point_y);
+        previous_x = point_x;
+        previous_y = point_y;
+    }
+}
+
+// Conventional circular restart arrow: a thick ring open across the top
+// with a solid arrowhead continuing the ring clockwise. Centered on
+// (x, y) and sized to match the play/resume symbol beside the labels.
