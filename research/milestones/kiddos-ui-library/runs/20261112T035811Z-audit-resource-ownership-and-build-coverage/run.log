     3	
     4	namespace kiddos::ui {
     5	Font::~Font() { reset(); }
     6	Font::Font(Font&& other) noexcept
     7	    : font_(std::exchange(other.font_, nullptr)) {}
     8	Font& Font::operator=(Font&& other) noexcept {
     9	    if (this != &other) {
    10	        reset();
    11	        font_ = std::exchange(other.font_, nullptr);
    12	    }
    13	    return *this;
    14	}
    15	bool Font::load(const std::string& path, int point_size) {
    16	    reset();
    17	    if (path.empty() || point_size <= 0) return false;
    18	    font_ = TTF_OpenFont(path.c_str(), point_size);
    19	    return font_ != nullptr;
    20	}
    21	void Font::reset() noexcept {
    22	    if (font_) {
    23	        TTF_CloseFont(font_);
    24	        font_ = nullptr;
    25	    }
    26	}
    27	bool Font::valid() const noexcept { return font_ != nullptr; }
    28	TTF_Font* Font::native() const noexcept { return font_; }
    29	}
     1	#include "kiddos/ui/text.hpp"
     2	
     3	namespace kiddos::ui {
     4	TextRenderer::TextRenderer(Renderer& renderer) noexcept
     5	    : renderer_(renderer) {}
     6	
     7	bool TextRenderer::draw(const std::string& text, const Font& font,
     8	                        Point position, Color color) {
     9	    if (!renderer_.valid() || !font.valid() || text.empty()) return false;
    10	    SDL_Color tint{color.r, color.g, color.b, color.a};
    11	    SDL_Surface* surface =
    12	        TTF_RenderUTF8_Blended(font.native(), text.c_str(), tint);
    13	    if (!surface) return false;
    14	    SDL_Texture* texture =
    15	        SDL_CreateTextureFromSurface(renderer_.native(), surface);
    16	    if (!texture) {
    17	        SDL_FreeSurface(surface);
    18	        return false;
    19	    }
    20	    SDL_Rect destination{position.x, position.y, surface->w, surface->h};
    21	    const int result =
    22	        SDL_RenderCopy(renderer_.native(), texture, nullptr, &destination);
    23	    SDL_DestroyTexture(texture);
    24	    SDL_FreeSurface(surface);
    25	    return result == 0;
    26	}
    27	
    28	bool TextRenderer::draw_centered(const std::string& text, const Font& font,
    29	                                 Rect area, Color color) {
    30	    if (!font.valid() || text.empty() || area.empty()) return false;
    31	    int width = 0;
    32	    int height = 0;
    33	    if (TTF_SizeUTF8(font.native(), text.c_str(), &width, &height) != 0)
    34	        return false;
    35	    return draw(text, font,
    36	        {area.x + (area.w - width) / 2,
    37	         area.y + (area.h - height) / 2}, color);
    38	}
    39	}

