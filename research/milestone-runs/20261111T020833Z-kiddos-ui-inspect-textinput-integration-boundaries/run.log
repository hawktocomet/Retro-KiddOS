=== SDL platform header ===
#pragma once

#include "kiddos/platform/platform.hpp"

#include <SDL.h>

namespace kiddos {

class SDLPlatform final : public Platform {
public:
    SDLPlatform() = default;
    ~SDLPlatform() override;

    bool initialize() override;
    bool poll_action(Action& action) override;
    void begin_frame() override;
    void draw_carousel(int selected_index) override;
    void draw_game_actions(int selected_index, bool has_checkpoint, int selected_action) override;
    void present() override;
    void shutdown() override;

private:
    SDL_Window* window_ = nullptr;
    SDL_Renderer* renderer_ = nullptr;
    SDL_GameController* controller_ = nullptr;
    SDL_JoystickID controller_instance_ = -1;
    bool initialized_ = false;

    void open_controller(int device_index);
    void close_controller();
    static Action map_key(SDL_Keycode key);
    static Action map_controller_button(Uint8 button);
};

} // namespace kiddos
=== TextInput public API ===
#pragma once

#include "kiddos/ui/element.hpp"
#include "kiddos/ui/font.hpp"

#include <cstddef>
#include <functional>
#include <string>

namespace kiddos::ui {

struct TextInputStyle {
    Color background{20, 30, 52, 255};
    Color border{75, 95, 130, 255};
    Color focused_border{65, 155, 255, 255};
    Color text{240, 244, 255, 255};
    Color placeholder{135, 150, 175, 255};
    Color cursor{90, 180, 255, 255};
    Color disabled_text{125, 135, 155, 255};
};

class TextInput final : public Element {
public:
    explicit TextInput(std::string text = {});

    void set_text(std::string text);
    const std::string& text() const noexcept;

    void set_placeholder(std::string placeholder);
    const std::string& placeholder() const noexcept;

    void set_max_length(std::size_t length);
    std::size_t max_length() const noexcept;

    bool insert_text(const std::string& text);
    bool backspace();
    bool delete_forward();
    void move_cursor_left() noexcept;
    void move_cursor_right() noexcept;
    void move_cursor_home() noexcept;
    void move_cursor_end() noexcept;

    std::size_t cursor_position() const noexcept;
    void set_cursor_position(std::size_t position) noexcept;

    void set_font(const Font* font) noexcept;
    const Font* font() const noexcept;

    void set_style(TextInputStyle style) noexcept;
    const TextInputStyle& style() const noexcept;

    void set_on_change(std::function<void(const std::string&)> callback);

private:
    std::string text_;
    std::string placeholder_;
    std::size_t cursor_{0};
    std::size_t max_length_{256};
    const Font* font_{nullptr};
    TextInputStyle style_{};
    std::function<void(const std::string&)> on_change_;

    static std::size_t previous_boundary(const std::string& text,
                                         std::size_t position) noexcept;
    static std::size_t next_boundary(const std::string& text,
                                     std::size_t position) noexcept;
    static std::size_t count_codepoints(const std::string& text) noexcept;

    void notify_change();
    void draw(Renderer& renderer) override;
};

}
=== TextInput implementation ===
#include "kiddos/ui/text_input.hpp"
#include "kiddos/ui/text.hpp"

#include <algorithm>
#include <utility>

namespace kiddos::ui {

TextInput::TextInput(std::string text) {
    set_focusable(true);
    set_text(std::move(text));
}

std::size_t TextInput::previous_boundary(const std::string& text,
                                         std::size_t position) noexcept {
    if (position == 0) return 0;
    --position;
    while (position > 0 &&
           (static_cast<unsigned char>(text[position]) & 0xC0) == 0x80)
        --position;
    return position;
}

std::size_t TextInput::next_boundary(const std::string& text,
                                     std::size_t position) noexcept {
    if (position >= text.size()) return text.size();
    ++position;
    while (position < text.size() &&
           (static_cast<unsigned char>(text[position]) & 0xC0) == 0x80)
        ++position;
    return position;
}

std::size_t TextInput::count_codepoints(const std::string& text) noexcept {
    std::size_t count = 0;
    for (unsigned char c : text)
        if ((c & 0xC0) != 0x80) ++count;
    return count;
}

void TextInput::set_text(std::string text) {
    if (count_codepoints(text) > max_length_) {
        std::size_t position = 0;
        for (std::size_t i = 0; i < max_length_; ++i)
            position = next_boundary(text, position);
        text.resize(position);
    }
    if (text_ == text) return;
    text_ = std::move(text);
    cursor_ = text_.size();
    notify_change();
}

const std::string& TextInput::text() const noexcept {
    return text_;
}

void TextInput::set_placeholder(std::string placeholder) {
    placeholder_ = std::move(placeholder);
}

const std::string& TextInput::placeholder() const noexcept {
    return placeholder_;
}

void TextInput::set_max_length(std::size_t length) {
    max_length_ = length;
    set_text(text_);
}

std::size_t TextInput::max_length() const noexcept {
    return max_length_;
}

bool TextInput::insert_text(const std::string& value) {
    if (!enabled() || !visible() || value.empty()) return false;

    const std::size_t current = count_codepoints(text_);
    const std::size_t available =
        current >= max_length_ ? 0 : max_length_ - current;
    const std::size_t incoming = count_codepoints(value);
    if (available == 0) return false;

    std::size_t end = value.size();
    if (incoming > available) {
        end = 0;
        for (std::size_t i = 0; i < available; ++i)
            end = next_boundary(value, end);
    }

    text_.insert(cursor_, value, 0, end);
    cursor_ += end;
    notify_change();
    return true;
}

bool TextInput::backspace() {
    if (!enabled() || !visible() || cursor_ == 0) return false;
    const std::size_t start = previous_boundary(text_, cursor_);
    text_.erase(start, cursor_ - start);
    cursor_ = start;
    notify_change();
    return true;
}

bool TextInput::delete_forward() {
    if (!enabled() || !visible() || cursor_ >= text_.size()) return false;
    const std::size_t end = next_boundary(text_, cursor_);
    text_.erase(cursor_, end - cursor_);
    notify_change();
    return true;
}

void TextInput::move_cursor_left() noexcept {
    cursor_ = previous_boundary(text_, cursor_);
}

void TextInput::move_cursor_right() noexcept {
    cursor_ = next_boundary(text_, cursor_);
}

void TextInput::move_cursor_home() noexcept {
    cursor_ = 0;
}

void TextInput::move_cursor_end() noexcept {
    cursor_ = text_.size();
}

std::size_t TextInput::cursor_position() const noexcept {
    return cursor_;
}

void TextInput::set_cursor_position(std::size_t position) noexcept {
    position = std::min(position, text_.size());
    while (position > 0 && position < text_.size() &&
           (static_cast<unsigned char>(text_[position]) & 0xC0) == 0x80)
        --position;
    cursor_ = position;
}

void TextInput::set_font(const Font* font) noexcept {
    font_ = font;
}

const Font* TextInput::font() const noexcept {
    return font_;
}

void TextInput::set_style(TextInputStyle style) noexcept {
    style_ = style;
}

const TextInputStyle& TextInput::style() const noexcept {
    return style_;
}

void TextInput::set_on_change(
    std::function<void(const std::string&)> callback) {
    on_change_ = std::move(callback);
}

void TextInput::notify_change() {
    if (on_change_) on_change_(text_);
}

void TextInput::draw(Renderer& renderer) {
    const Rect area = bounds();
    if (area.empty()) return;

    renderer.fill_rect(area, style_.background);
    renderer.outline_rect(
        area, focused() ? style_.focused_border : style_.border);

    if (!font_ || !font_->valid()) return;

    const std::string& displayed = text_.empty() ? placeholder_ : text_;
    const Color foreground = !enabled()
        ? style_.disabled_text
        : (text_.empty() ? style_.placeholder : style_.text);

    const int padding = 8;
    const Rect text_area{
        area.x + padding, area.y + padding / 2,
        std::max(0, area.w - padding * 2),
        std::max(0, area.h - padding)
    };

    if (!displayed.empty()) {
        TextRenderer text_renderer(renderer);
        text_renderer.draw(displayed, *font_,
                           {text_area.x, text_area.y}, foreground);
    }

    if (focused() && enabled()) {
        const std::string before = text_.substr(0, cursor_);
        int cursor_width = 0;
        int cursor_height = 0;
        if (TTF_SizeUTF8(font_->native(), before.c_str(),
                         &cursor_width, &cursor_height) == 0) {
            const int x = text_area.x + cursor_width;
            const int y = text_area.y;
            renderer.draw_line(
                {x, y}, {x, y + std::min(cursor_height, text_area.h)},
                style_.cursor);
        }
    }
}

}
=== SDL platform includes and initialization ===
#include "kiddos/platform/sdl_platform.hpp"

#include <algorithm>
#include <array>
#include <cmath>
#include <iostream>

namespace kiddos {

namespace {

struct Color {
    Uint8 r, g, b, a;
};

std::array<SDL_Texture*, 3> artwork_textures{};
std::array<SDL_Texture*, 3> action_label_textures{};
SDL_Texture* carousel_title_texture{};
SDL_Texture* carousel_selected_texture{};

SDL_Texture* load_bitmap_texture(SDL_Renderer* renderer,
                                 const char* path,
                                 bool magenta_key = false) {
    SDL_Surface* surface = SDL_LoadBMP(path);
    if (!surface) {
        std::cerr << "Could not load " << path << ": "
                  << SDL_GetError() << '\\n';
        return nullptr;
    }

    if (magenta_key) {
        const Uint32 key = SDL_MapRGB(surface->format, 255, 0, 255);
        SDL_SetColorKey(surface, SDL_TRUE, key);
    }

    SDL_Texture* texture = SDL_CreateTextureFromSurface(renderer, surface);
    SDL_FreeSurface(surface);

    if (texture) {
        SDL_SetTextureBlendMode(texture, SDL_BLENDMODE_BLEND);
    } else {
        std::cerr << "Could not create texture for " << path << ": "
                  << SDL_GetError() << '\\n';
    }
    return texture;
}

void color(SDL_Renderer* r, Color c) {
    SDL_SetRenderDrawColor(r, c.r, c.g, c.b, c.a);
}

void rectangle(SDL_Renderer* r, SDL_Rect rect, Color c) {
    color(r, c);
    SDL_RenderFillRect(r, &rect);
}

void outline(SDL_Renderer* r, SDL_Rect rect, Color c) {
    color(r, c);
    SDL_RenderDrawRect(r, &rect);
}

void rounded_fill(SDL_Renderer* r, SDL_Rect rect, int radius, Color c) {
    if (rect.w <= 0 || rect.h <= 0) return;
    radius = std::max(0, std::min(radius, std::min(rect.w, rect.h) / 2));
    color(r, c);

    for (int y = 0; y < rect.h; ++y) {
        int inset = 0;
        if (y < radius) {
            const double dy = radius - y - 0.5;
            inset = radius - static_cast<int>(
                std::sqrt(std::max(0.0, radius * radius - dy * dy)));
        } else if (y >= rect.h - radius) {
            const double dy = y - (rect.h - radius) + 0.5;
            inset = radius - static_cast<int>(
                std::sqrt(std::max(0.0, radius * radius - dy * dy)));
        }
        SDL_RenderDrawLine(r, rect.x + inset, rect.y + y,
                           rect.x + rect.w - 1 - inset, rect.y + y);
    }
}

void rounded_outline(SDL_Renderer* r, SDL_Rect rect, int radius, Color c) {
    if (rect.w <= 0 || rect.h <= 0) return;
    radius = std::max(0, std::min(radius, std::min(rect.w, rect.h) / 2));
    color(r, c);

    SDL_RenderDrawLine(r, rect.x + radius, rect.y,
                       rect.x + rect.w - radius - 1, rect.y);
    SDL_RenderDrawLine(r, rect.x + radius, rect.y + rect.h - 1,
                       rect.x + rect.w - radius - 1, rect.y + rect.h - 1);
    SDL_RenderDrawLine(r, rect.x, rect.y + radius,
                       rect.x, rect.y + rect.h - radius - 1);
    SDL_RenderDrawLine(r, rect.x + rect.w - 1, rect.y + radius,
                       rect.x + rect.w - 1, rect.y + rect.h - radius - 1);

    for (int i = 0; i <= radius * 2; ++i) {
        const double angle = (3.14159265358979323846 / 2.0) *
                             static_cast<double>(i) /
                             std::max(1, radius * 2);
        const int dx = static_cast<int>(std::round(radius * std::cos(angle)));
        const int dy = static_cast<int>(std::round(radius * std::sin(angle)));
        SDL_RenderDrawPoint(r, rect.x + radius - dx,
                            rect.y + radius - dy);
        SDL_RenderDrawPoint(r, rect.x + rect.w - radius - 1 + dx,
                            rect.y + radius - dy);
        SDL_RenderDrawPoint(r, rect.x + radius - dx,
                            rect.y + rect.h - radius - 1 + dy);
        SDL_RenderDrawPoint(r, rect.x + rect.w - radius - 1 + dx,
                            rect.y + rect.h - radius - 1 + dy);
    }
}

void mask_artwork_corners(SDL_Renderer* r, SDL_Rect rect,
                          int radius, Color background) {
    radius = std::max(0, std::min(radius, std::min(rect.w, rect.h) / 2));
    color(r, background);

    for (int y = 0; y < radius; ++y) {
        const double dy = radius - y - 0.5;
        const int inset = radius - static_cast<int>(
            std::sqrt(std::max(0.0, radius * radius - dy * dy)));
        SDL_RenderDrawLine(r, rect.x, rect.y + y,
                           rect.x + inset, rect.y + y);
        SDL_RenderDrawLine(r, rect.x + rect.w - 1 - inset, rect.y + y,
                           rect.x + rect.w - 1, rect.y + y);

        const int bottom_y = rect.y + rect.h - 1 - y;
        SDL_RenderDrawLine(r, rect.x, bottom_y,
                           rect.x + inset, bottom_y);
        SDL_RenderDrawLine(r, rect.x + rect.w - 1 - inset, bottom_y,
                           rect.x + rect.w - 1, bottom_y);
    }
}

void circle(SDL_Renderer* r, int cx, int cy, int radius, Color c) {
    color(r, c);

    for (int y = -radius; y <= radius; ++y) {
        const int x = static_cast<int>(
            std::sqrt(static_cast<double>(
                radius * radius - y * y
            ))
        );
        SDL_RenderDrawLine(r, cx - x, cy + y, cx + x, cy + y);
    }
}

void triangle(SDL_Renderer* r, int x1, int y1,
              int x2, int y2, int x3, int y3, Color c) {
    color(r, c);

