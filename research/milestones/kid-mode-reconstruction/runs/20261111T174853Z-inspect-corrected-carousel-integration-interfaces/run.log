=== UI CONTAINER AND ELEMENT ===
#pragma once

#include "kiddos/ui/element.hpp"

#include <memory>
#include <type_traits>
#include <utility>
#include <vector>

namespace kiddos::ui {

class Container : public Element {
public:
    template<typename T, typename... Args>
    T& add(Args&&... args) {
        static_assert(std::is_base_of_v<Element, T>,
                      "Container children must derive from Element");

        auto child = std::make_unique<T>(
            std::forward<Args>(args)...
        );

        T& reference = *child;
        children_.push_back(std::move(child));
        return reference;
    }

    std::size_t child_count() const noexcept {
        return children_.size();
    }

    Element* child(std::size_t index) noexcept {
        if (index >= children_.size()) return nullptr;
        return children_[index].get();
    }

    const Element* child(std::size_t index) const noexcept {
        if (index >= children_.size()) return nullptr;
        return children_[index].get();
    }

protected:
    void draw(Renderer& renderer) override {
        for (auto& element : children_) {
            element->render(renderer);
        }
    }

private:
    std::vector<std::unique_ptr<Element>> children_;
};

} // namespace kiddos::ui
#pragma once

#include "kiddos/ui/geometry.hpp"
#include "kiddos/ui/renderer.hpp"

namespace kiddos::ui {

class Element {
public:
    virtual ~Element() = default;

    void set_bounds(Rect bounds) noexcept { bounds_ = bounds; }
    Rect bounds() const noexcept { return bounds_; }

    void set_visible(bool visible) noexcept { visible_ = visible; }
    bool visible() const noexcept { return visible_; }

    void set_enabled(bool enabled) noexcept { enabled_ = enabled; }
    bool enabled() const noexcept { return enabled_; }

    void set_focusable(bool focusable) noexcept {
        focusable_ = focusable;
    }

    bool focusable() const noexcept { return focusable_; }

    void set_focused(bool focused) noexcept { focused_ = focused; }
    bool focused() const noexcept { return focused_; }

    void render(Renderer& renderer) {
        if (visible_) draw(renderer);
    }

protected:
    virtual void draw(Renderer& renderer) = 0;

private:
    Rect bounds_{};
    bool visible_ = true;
    bool enabled_ = true;
    bool focusable_ = false;
    bool focused_ = false;
};

} // namespace kiddos::ui
