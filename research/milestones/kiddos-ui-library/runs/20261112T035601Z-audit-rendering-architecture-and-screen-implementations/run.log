    19	class StackLayout final {
    20	public:
    21	    // Distributes available space equally between visible children.
    22	    // Remaining pixels are distributed one at a time.
    23	    static void apply(
    24	        Container& container,
    25	        Rect area,
    26	        Axis axis,
