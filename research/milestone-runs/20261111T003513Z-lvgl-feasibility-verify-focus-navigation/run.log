    93	int main(void)
    94	{
    95	    if (SDL_Init(SDL_INIT_VIDEO | SDL_INIT_GAMECONTROLLER) != 0) {
    96	        fprintf(stderr, "SDL_Init: %s\n", SDL_GetError());
    97	        return 1;
    98	    }
    99	
   100	    window = SDL_CreateWindow("KiddOS LVGL SDL Renderer Adapter",
   101	        SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
   102	        SCREEN_W, SCREEN_H, SDL_WINDOW_SHOWN);
   103	    if (!window) {
   104	        fprintf(stderr, "SDL_CreateWindow: %s\n", SDL_GetError());
   105	        return 1;
   106	    }
   107	
   108	    renderer = SDL_CreateRenderer(window, -1, SDL_RENDERER_ACCELERATED);
   109	    if (!renderer)
   110	        renderer = SDL_CreateRenderer(window, -1, SDL_RENDERER_SOFTWARE);
   111	    if (!renderer) {
   112	        fprintf(stderr, "SDL_CreateRenderer: %s\n", SDL_GetError());
   113	        return 1;
   114	    }
   115	
   116	    texture = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_RGB565,
   117	        SDL_TEXTUREACCESS_STREAMING, SCREEN_W, SCREEN_H);
   118	    if (!texture) {
   119	        fprintf(stderr, "SDL_CreateTexture: %s\n", SDL_GetError());
   120	        return 1;
   121	    }
   122	
   123	    SDL_SetRenderDrawColor(renderer, 7, 20, 38, 255);
   124	    SDL_RenderClear(renderer);
   125	    SDL_RenderPresent(renderer);
   126	
   127	    lv_init();
   128	
   129	    lv_display_t *display = lv_display_create(SCREEN_W, SCREEN_H);
   130	    lv_display_set_color_format(display, LV_COLOR_FORMAT_RGB565);
   131	    lv_display_set_flush_cb(display, flush_to_sdl);
   132	    lv_display_set_buffers(display, draw_buffer, NULL, sizeof(draw_buffer),
   133	        LV_DISPLAY_RENDER_MODE_PARTIAL);
   134	
   135	    make_ui();
   136	
   137	    keypad = lv_indev_create();
   138	    lv_indev_set_type(keypad, LV_INDEV_TYPE_KEYPAD);
   139	    lv_indev_set_read_cb(keypad, read_controller);
   140	    lv_indev_set_group(keypad, focus_group);
   141	    lv_group_focus_obj(lv_obj_get_child(lv_screen_active(), 1));
   142	
   143	    printf("Adapter running: LVGL -> custom flush callback -> existing SDL_Renderer\n");
   144	    printf("Press Escape or close the window to exit.\n");
   145	
   146	    int running = 1;
   147	    while (running) {
   148	        SDL_Event event;
   149	        while (SDL_PollEvent(&event)) {
   150	            if (event.type == SDL_QUIT)
   151	                running = 0;
   152	            if (event.type == SDL_KEYDOWN && event.key.keysym.sym == SDLK_ESCAPE)
   153	                running = 0;
   154	
   155	            if (event.type == SDL_CONTROLLERBUTTONDOWN) {
   156	                switch (event.cbutton.button) {
   157	                    case SDL_CONTROLLER_BUTTON_DPAD_LEFT: keypad_key = LV_KEY_LEFT; keypad_pressed = true; break;
   158	                    case SDL_CONTROLLER_BUTTON_DPAD_RIGHT: keypad_key = LV_KEY_RIGHT; keypad_pressed = true; break;
   159	                    case SDL_CONTROLLER_BUTTON_DPAD_UP: keypad_key = LV_KEY_UP; keypad_pressed = true; break;
   160	                    case SDL_CONTROLLER_BUTTON_DPAD_DOWN: keypad_key = LV_KEY_DOWN; keypad_pressed = true; break;
   161	                    case SDL_CONTROLLER_BUTTON_A: keypad_key = LV_KEY_ENTER; keypad_pressed = true; break;
   162	                    case SDL_CONTROLLER_BUTTON_B: keypad_key = LV_KEY_ESC; keypad_pressed = true; break;
   163	                    default: break;
   164	                }
   165	            }
   166	
   167	            if (event.type == SDL_KEYDOWN) {
   168	                switch (event.key.keysym.sym) {
   169	                    case SDLK_LEFT: keypad_key = LV_KEY_LEFT; keypad_pressed = true; break;
   170	                    case SDLK_RIGHT: keypad_key = LV_KEY_RIGHT; keypad_pressed = true; break;
   171	                    case SDLK_UP: keypad_key = LV_KEY_UP; keypad_pressed = true; break;
   172	                    case SDLK_DOWN: keypad_key = LV_KEY_DOWN; keypad_pressed = true; break;
   173	                    case SDLK_RETURN: keypad_key = LV_KEY_ENTER; keypad_pressed = true; break;
   174	                    default: break;
   175	                }
   176	            }
   177	        }
   178	        lv_timer_handler();
   179	        SDL_Delay(5);
   180	    }
   181	
   182	    lv_deinit();
   183	    SDL_DestroyTexture(texture);
   184	    SDL_DestroyRenderer(renderer);
   185	    SDL_DestroyWindow(window);
   186	    SDL_Quit();
   187	    return 0;
   188	}
