#include <SDL.h>
#include <math.h>
#include <stdio.h>

typedef struct { Uint8 r,g,b,a; } Color;

void color(SDL_Renderer* r, Color c){ SDL_SetRenderDrawColor(r,c.r,c.g,c.b,c.a); }
void triangle(SDL_Renderer* r,int x1,int y1,int x2,int y2,int x3,int y3,Color c){
    color(r,c);
    int min_y=SDL_min(SDL_min(y1,y2),y3), max_y=SDL_max(SDL_max(y1,y2),y3);
    for(int y=min_y;y<=max_y;++y){
        int xs[3]={x1,x2,x3}, ys[3]={y1,y2,y3};
        int lo=1<<30, hi=-(1<<30), count=0;
        for(int i=0;i<3;++i){int j=(i+1)%3;
            if((ys[i]<=y&&ys[j]>y)||(ys[j]<=y&&ys[i]>y)){
                int x=xs[i]+(y-ys[i])*(xs[j]-xs[i])/(ys[j]-ys[i]);
                lo=SDL_min(lo,x); hi=SDL_max(hi,x); count++;}}
        if(count==2) SDL_RenderDrawLine(r,lo,y,hi,y);
    }
}
void draw_arc(SDL_Renderer* r,int cx,int cy,int radius,double s,double e,Color c){
    color(r,c);
    int steps=SDL_max(2,radius*2); double d=(e-s)/steps;
    int px=cx+radius, py=cy;
    for(int i=1;i<=steps;++i){
        double rad=(s+d*i)*M_PI/180.0;
        int x=cx+(int)lround(radius*cos(rad)), y=cy+(int)lround(radius*sin(rad));
        SDL_RenderDrawLine(r,px,py,x,y); px=x; py=y;}
}
void draw_play(SDL_Renderer* r,int x,int y){
    triangle(r,x-18,y-32,x-18,y+32,x+30,y,(Color){220,237,255,255});
}
void draw_restart(SDL_Renderer* r,int x,int y){
    Color icon={220,237,255,255};
    for(int rad=21;rad<=27;++rad) draw_arc(r,x,y,rad,290.0,610.0,icon);
    triangle(r,x+27,y-16,x+4,y-10,x+13,y-35,icon);
}

int main(){
    SDL_Init(0);
    SDL_Surface* surf=SDL_CreateRGBSurfaceWithFormat(0,720,300,32,SDL_PIXELFORMAT_RGBA32);
    SDL_Renderer* r=SDL_CreateSoftwareRenderer(surf);
    SDL_SetRenderDrawBlendMode(r,SDL_BLENDMODE_BLEND);
    SDL_SetRenderDrawColor(r,16,30,65,255);
    SDL_RenderFillRect(r,NULL);
    draw_play(r,145,90);
    draw_restart(r,145,220);
    SDL_RenderPresent(r);
    SDL_SaveBMP(surf,"icons_preview.bmp");
    return 0;
}
EOF
