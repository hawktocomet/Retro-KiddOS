Action SDLPlatform::map_controller_button(Uint8 button) {
    switch (button) {
        case SDL_CONTROLLER_BUTTON_DPAD_LEFT:
            return Action::NavigateLeft;
        case SDL_CONTROLLER_BUTTON_DPAD_RIGHT:
            return Action::NavigateRight;
        case SDL_CONTROLLER_BUTTON_DPAD_UP:
            return Action::NavigateUp;
        case SDL_CONTROLLER_BUTTON_DPAD_DOWN:
            return Action::NavigateDown;
        case SDL_CONTROLLER_BUTTON_A:
            return Action::Confirm;
        case SDL_CONTROLLER_BUTTON_B:
            return Action::Back;
        default:
            return Action::None;
    }
}

bool SDLPlatform::pump_events() {
    SDL_Event event;
    bool received = false;

    while (SDL_PollEvent(&event)) {
        received = true;

        switch (event.type) {
            case SDL_QUIT:
                pending_actions_.push_back(Action::Quit);
                break;

            case SDL_KEYDOWN:
                if (!should_process_keydown(
                        event.key.keysym.sym, event.key.repeat,
                        text_input_active_)) break;

                switch (event.key.keysym.sym) {
                    case SDLK_BACKSPACE:
                        if (text_input_active_) {
                            pending_text_events_.push_back(
                                {TextInputEventType::Backspace, {}});
                        }
                        break;
                    case SDLK_DELETE:
                        if (text_input_active_) {
                            pending_text_events_.push_back(
                                {TextInputEventType::Delete, {}});
                        }
                        break;
                    case SDLK_HOME:
                        if (text_input_active_) {
                            pending_text_events_.push_back(
                                {TextInputEventType::Home, {}});
                        }
                        break;
                    case SDLK_END:
                        if (text_input_active_) {
                            pending_text_events_.push_back(
                                {TextInputEventType::End, {}});
                        }
                        break;
                    case SDLK_LEFT:
                    case SDLK_RIGHT:
                        if (text_input_active_) {
                            pending_text_events_.push_back({
                                event.key.keysym.sym == SDLK_LEFT
                                    ? TextInputEventType::Left
                                    : TextInputEventType::Right, {}});
                        } else {
                            pending_actions_.push_back(
                                map_key(event.key.keysym.sym));
                        }
                        break;
                    default: {
                        const Action action =
                            map_key(event.key.keysym.sym);
                        if (action != Action::None) {
                            pending_actions_.push_back(action);
                        }
                        break;
                    }
                }
                break;

            case SDL_TEXTINPUT:
                if (text_input_active_) {
                    pending_text_events_.push_back(
                        {TextInputEventType::Text, event.text.text});
                }
                break;

            case SDL_CONTROLLERBUTTONDOWN:
                if (event.cbutton.which == controller_instance_) {
                    const Action action =
                        map_controller_button(event.cbutton.button);
                    if (action != Action::None) {
                        pending_actions_.push_back(action);
                    }
                }
                break;

            case SDL_CONTROLLERDEVICEADDED:
                open_controller(event.cdevice.which);
                break;

            case SDL_CONTROLLERDEVICEREMOVED:
                if (event.cdevice.which == controller_instance_) {
                    close_controller();
                }
                break;

            case SDL_WINDOWEVENT:
                if (event.window.event == SDL_WINDOWEVENT_CLOSE) {
                    pending_actions_.push_back(Action::Quit);
                }
                break;

            default:
                break;
        }
    }

    return received;
}

bool SDLPlatform::poll_action(Action& action) {
    if (pending_actions_.empty()) pump_events();

    if (pending_actions_.empty()) {
        action = Action::None;
        return false;
    }

    action = pending_actions_.front();
    pending_actions_.pop_front();
    return true;
}

bool SDLPlatform::poll_text_input_event(TextInputEvent& text_event) {
    if (pending_text_events_.empty()) pump_events();

    if (pending_text_events_.empty()) return false;

    text_event = std::move(pending_text_events_.front());
    pending_text_events_.pop_front();
    return true;
}

