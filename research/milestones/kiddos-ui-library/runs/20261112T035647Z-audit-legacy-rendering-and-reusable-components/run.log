   724	void draw_action_label(SDL_Renderer* r, int index,
   725	                       int x, int y) {
   726	    if (index < 0 || index >= static_cast<int>(action_label_textures.size())) return;
   727	    SDL_Texture* texture = action_label_textures[static_cast<std::size_t>(index)];
   728	    if (!texture) return;
   729	
   730	    SDL_Rect destination{x, y, 350, 72};
   731	    SDL_RenderCopy(r, texture, nullptr, &destination);
   732	}
   733	
   734	// Conventional play/resume symbol: a solid right-pointing triangle
   735	// centered on (x, y). Play and Resume share this geometry on purpose:
   736	// a filled play triangle is the conventional symbol for both actions,
   737	// and the text label next to it names the action.
   738	void draw_play_symbol(SDL_Renderer* r, int x, int y) {
   739	    triangle(r, x - 18, y - 32, x - 18, y + 32, x + 30, y,
   740	             {220, 237, 255, 255});
   741	}
   742	
   743	void draw_resume_symbol(SDL_Renderer* r, int x, int y) {
   744	    draw_play_symbol(r, x, y);
   745	}
   746	
   747	// Conventional circular restart arrow: a thick ring open across the top
   748	// with a solid arrowhead continuing the ring clockwise. The ring band is
   749	// stamped as tightly overlapping filled disks along the arc so it renders
   750	// as one solid, evenly weighted band. Centered on (x, y).
   751	void draw_restart_symbol(SDL_Renderer* r, int x, int y) {
   752	    // A simple clockwise restart arrow with a consistent line weight.
   753	    constexpr double pi = 3.14159265358979323846;
   754	    constexpr int segments = 32;
   755	    const Color icon{220, 237, 255, 255};
   756	
   757	    color(r, icon);
   758	
   759	    for (int stroke = -1; stroke <= 1; ++stroke) {
   760	        const double radius = 24.0 + stroke;
   761	        int previous_x = x + static_cast<int>(std::lround(
   762	            radius * std::cos(135.0 * pi / 180.0)));
   763	        int previous_y = y + static_cast<int>(std::lround(
   764	            radius * std::sin(135.0 * pi / 180.0)));
   765	
   766	        for (int step = 1; step <= segments; ++step) {
   767	            const double angle = (135.0 + 270.0 * step / segments)
   768	                                 * pi / 180.0;
   769	            const int next_x = x + static_cast<int>(
   770	                std::lround(radius * std::cos(angle)));
   771	            const int next_y = y + static_cast<int>(
   772	                std::lround(radius * std::sin(angle)));
   773	            SDL_RenderDrawLine(r, previous_x, previous_y, next_x, next_y);
   774	            previous_x = next_x;
   775	            previous_y = next_y;
   776	        }
   777	    }
   778	
   779	    // Arrowhead at the upper-right end of the circular stroke.
   780	    triangle(r, x + 31, y - 21,
   781	             x + 8, y - 29,
   782	             x + 22, y - 5, icon);
   783	}
